DB iDB_Valve_Inlet
  ROOTID 0
  NUMBER 900
  INSTANCEOF FB_Valve
  COMMENT "EXAMPLE instance DB for FB_Valve - one valve, wired in examples/calling-network.ir. START VALUES ARE DOWNLOAD-TIME ONLY and every command member is overwritten by the caller each scan, so the values that actually matter here are the two SETTINGS: FTTime, which must cover this actuator's travel in its slower direction, and EnableUPSTime. Both ship non-zero on purpose - a zero fail-to time raises both faults during every legitimate transit. The whole struct is RETAIN, which is what C-132 makes possible and what keeps a latched fault alive across a power cycle; note that this retains the entire interface, not only the latched causes."
  INPUT
  OUTPUT
  MEMBERS
    IO : "UDT_Valve" RETAIN SETPOINT
      InHand : Bool = FALSE
      AutoOpenSignal : Bool = FALSE
      HandOpenSignal : Bool = FALSE
      PositionFB : Bool = FALSE
      PositionValid : Bool = FALSE
      FBSenseInvert : Bool = FALSE
      FaultFB : Bool = FALSE
      SystemHealthy : Bool = FALSE
      InhibitValve : Bool = FALSE
      FaultReset : Bool = FALSE
      FTTime : Real = 10.0
      EnableUPSTime : Real = 2.0
      FailCloseCritical : Bool = FALSE
      SuppFTO : Bool = FALSE
      SuppFTC : Bool = FALSE
      OpenValve : Bool = FALSE
      UPSEnable : Bool = FALSE
      FTO : Bool = FALSE
      FTC : Bool = FALSE
      ExtFault : Bool = FALSE
      OverrideActive : Bool = FALSE
      FaultActive : Bool = FALSE
      CriticalActive : Bool = FALSE
      ErrorActive : Bool = FALSE
      CycleCount : UDInt = 0
      Telemetry : Int = 0
      Alarm : Word = 16#0
      SuppCause : Int = 0
    FBOpen : Bool = FALSE
    CycleEdge : Bool = FALSE
    CyclePrev : Bool = FALSE
    FTTimeMS : DInt = 0
    EnableUPSTimeMS : DInt = 0
    FailToOpenTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time = T#0MS
      ET : Time = T#0MS
      IN : Bool = FALSE
      Q : Bool = FALSE
    FailToCloseTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time = T#0MS
      ET : Time = T#0MS
      IN : Bool = FALSE
      Q : Bool = FALSE
    EnableUpstreamTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time = T#0MS
      ET : Time = T#0MS
      IN : Bool = FALSE
      Q : Bool = FALSE
    CycleDebounceTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time = T#0MS
      ET : Time = T#0MS
      IN : Bool = FALSE
      Q : Bool = FALSE
