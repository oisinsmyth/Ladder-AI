BLOCK FC FC_Inputs
ROOTID 0
NUMBER 1
LANGUAGE LAD
TITLE "Input Map"

INTERFACE
  INPUT
  OUTPUT
  CONSTANT

NETWORK 1 "PLC1 Built-in DI (CPU 1214C)"
  COMMENT "DI4_SYS_CycleStop is a normally-closed pushbutton: negated at this map layer so DB_Input.Cycle_Stop reads active-high (true = operator commanding stop) like every other buffer member - the input-mapping pattern's negated variant. Field polarity is absorbed here only; logic never compensates (C-304)."
  COIL DB_Input.Control_Healthy := AlwaysTrue AND NOT DB_Input.Test[0] AND DI1_SYS_ControlHealthy OR AlwaysTrue AND DB_Input.Test[1]
  COIL DB_Input.SpareDI[1] := AlwaysTrue AND NOT DB_Input.Test[0] AND DI2_SPR_1 OR AlwaysTrue AND DB_Input.Test[2]
  COIL DB_Input.Cycle_Start := AlwaysTrue AND NOT DB_Input.Test[0] AND DI3_SYS_CycleStart OR AlwaysTrue AND DB_Input.Test[3]
  COIL DB_Input.Cycle_Stop := AlwaysTrue AND NOT DB_Input.Test[0] AND NOT DI4_SYS_CycleStop OR AlwaysTrue AND DB_Input.Test[4]
  COIL DB_Input.Shredder_Run_Fwd_FB := AlwaysTrue AND NOT DB_Input.Test[0] AND DI5_SHR_RunFwdFB OR AlwaysTrue AND DB_Input.Test[5]
  COIL DB_Input.Shredder_Run_Rev_FB := AlwaysTrue AND NOT DB_Input.Test[0] AND DI6_SHR_RunRevFB OR AlwaysTrue AND DB_Input.Test[6]
  COIL DB_Input.Motor_Fault := AlwaysTrue AND NOT DB_Input.Test[0] AND DI7_SYS_MotorFault OR AlwaysTrue AND DB_Input.Test[7]
  COIL DB_Input.Hopper_Level_High := AlwaysTrue AND NOT DB_Input.Test[0] AND DI8_HPR_LevelHigh OR AlwaysTrue AND DB_Input.Test[8]
  COIL DB_Input.Infeed_Conv_Running := AlwaysTrue AND NOT DB_Input.Test[0] AND DI9_IFC_Running OR AlwaysTrue AND DB_Input.Test[9]
  COIL DB_Input.Discharge_Conv_Running := AlwaysTrue AND NOT DB_Input.Test[0] AND DI10_DIS_Running OR AlwaysTrue AND DB_Input.Test[10]
  COIL DB_Input.Pusher_PowerPack_Running := AlwaysTrue AND NOT DB_Input.Test[0] AND DI11_PSH_PowerPackRunning OR AlwaysTrue AND DB_Input.Test[11]
  COIL DB_Input.Pusher_Home_Limit := AlwaysTrue AND NOT DB_Input.Test[0] AND DI12_PSH_HomeLimit OR AlwaysTrue AND DB_Input.Test[12]
  COIL DB_Input.Pusher_Full_Travel_Limit := AlwaysTrue AND NOT DB_Input.Test[0] AND DI13_PSH_FullTravelLimit OR AlwaysTrue AND DB_Input.Test[13]
  COIL DB_Input.Pusher_High_Pressure := AlwaysTrue AND NOT DB_Input.Test[0] AND DI14_PSH_HighPressure OR AlwaysTrue AND DB_Input.Test[14]

NETWORK 2 "PLC1.1 SM1223 DI"
  COIL DB_Input.Downstream_Running := AlwaysTrue AND NOT DB_Input.Test[0] AND DI15_SYS_DownstreamRunning OR AlwaysTrue AND DB_Input.Test[15]
  COIL DB_Input.Pusher_Local_Remote := AlwaysTrue AND NOT DB_Input.Test[0] AND DI16_PSH_LocalRemote OR AlwaysTrue AND DB_Input.Test[16]
  COIL DB_Input.SpareDI[2] := AlwaysTrue AND NOT DB_Input.Test[0] AND DI17_SPR_2 OR AlwaysTrue AND DB_Input.Test[17]
  COIL DB_Input.SpareDI[3] := AlwaysTrue AND NOT DB_Input.Test[0] AND DI18_SPR_3 OR AlwaysTrue AND DB_Input.Test[18]
  COIL DB_Input.SpareDI[4] := AlwaysTrue AND NOT DB_Input.Test[0] AND DI19_SPR_4 OR AlwaysTrue AND DB_Input.Test[19]
  COIL DB_Input.SpareDI[5] := AlwaysTrue AND NOT DB_Input.Test[0] AND DI20_SPR_5 OR AlwaysTrue AND DB_Input.Test[20]
  COIL DB_Input.SpareDI[6] := AlwaysTrue AND NOT DB_Input.Test[0] AND DI21_SPR_6 OR AlwaysTrue AND DB_Input.Test[21]
  COIL DB_Input.SpareDI[7] := AlwaysTrue AND NOT DB_Input.Test[0] AND DI22_SPR_7 OR AlwaysTrue AND DB_Input.Test[22]

SIDECAR
