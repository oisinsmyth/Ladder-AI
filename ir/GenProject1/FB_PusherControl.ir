BLOCK FB FB_PusherControl
ROOTID 0
NUMBER 3
LANGUAGE LAD
TITLE "Pusher Control"
COMMENT "Pusher ram sequencing (C-118-C-125). Step legend (C-120): 0=Parked (idle/home, ram fully retracted, no motion) - 10=DriveToEndTravel (forward stroke in progress) - 20=Hold (paused at full travel, brief settle before retracting) - 30=Retract (returning to home; also the recovery/abort target from any bad state). Mode legend: 0=Off (finish a retract already in progress, then park; no new cycle starts) - 1=Auto (hopper-high-level starts a cycle) - 2=Manual (operator button/jog starts a cycle)."

INTERFACE
  INPUT
  OUTPUT
  STATIC
    IO : "UDT_PusherIO" RETAIN SETPOINT
      Step : Int
      Fitted : Bool
      Enable : Bool
      Mode : Int
      HopperHighLevel : Bool
      ManualCycleCmd : Bool
      JogExtendCmd : Bool
      JogRetractCmd : Bool
      HomeLimit : Bool
      FullTravelLimit : Bool
      HighPressure : Bool
      PowerPackRunningFB : Bool
      FaultReset : Bool
      EndTravelTimeout : Real
      ParkedTimeout : Real
      EndTravelHoldTime : Real
      PumpRunOnTime : Real
      JogWarningTime : Real
      PressureTripConfirmTime : Real
      PressureClearResumeDelay : Real
      PressureTripCountThreshold : Int
      Cycling : Bool
      Blocked : Bool
      EndTravelTimeoutFault : Bool
      ParkedTimeoutFault : Bool
      BothSwitchesFault : Bool
      RunPowerPack : Bool
      Extend : Bool
      Retract : Bool
      JogPreStartSounder : Bool
    EndTravelTimeoutMS : DInt
    ParkedTimeoutMS : DInt
    EndTravelHoldTimeMS : DInt
    PumpRunOnTimeMS : DInt
    JogWarningTimeMS : DInt
    PressureTripConfirmTimeMS : DInt
    PressureClearResumeDelayMS : DInt
    PressureConfirmTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    PressureClearTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    PressureHold : Bool
    PressureConfirmEdge : Bool
    PressureConfirmEdgeMem : Bool
    PressureTripCount : Int
    EndTravelTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    HoldTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    ParkedTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    JogPreStartTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    ExtendDemand : Bool
    RetractDemand : Bool
    PumpDemand : Bool
    PumpEverDemanded : Bool
    PumpRunOnTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
  TEMP
    Time : Real
  CONSTANT

NETWORK 1 "Enable"
  COIL IO.Enable := IO.Fitted AND IO.Mode <> 0

NETWORK 2 "Both Limit Switches Active Simultaneously"
  COIL IO.BothSwitchesFault := IO.HomeLimit AND IO.FullTravelLimit OR IO.BothSwitchesFault AND NOT IO.FaultReset

NETWORK 3 "HMI Time Conversions"
  COMMENT "HMI/DB_Settings times are Real seconds for operator legibility; every TON below needs its PT in DInt ms - one MUL+CONVERT pair per timer, matching the MotorDOL FTTime/EnableUPSTime idiom. Kept as one block up front rather than repeated at each timer, so the x1000 idiom is visibly consistent and only ever done once."
  MUL(EN := TRUE, IN1 := IO.PressureTripConfirmTime, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := IO.PressureClearResumeDelay, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := IO.EndTravelTimeout, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := IO.EndTravelHoldTime, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := IO.ParkedTimeout, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := IO.JogWarningTime, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := IO.PumpRunOnTime, IN2 := 1000.0) => Time
  CONVERT(EN := ENO, IN := Time) => PressureTripConfirmTimeMS
  CONVERT(EN := ENO, IN := Time) => PressureClearResumeDelayMS
  CONVERT(EN := ENO, IN := Time) => EndTravelTimeoutMS
  CONVERT(EN := ENO, IN := Time) => EndTravelHoldTimeMS
  CONVERT(EN := ENO, IN := Time) => ParkedTimeoutMS
  CONVERT(EN := ENO, IN := Time) => JogWarningTimeMS
  CONVERT(EN := ENO, IN := Time) => PumpRunOnTimeMS

NETWORK 4 "Pressure Trip Detection, Hold, And Counting"
  COMMENT "One function, one network: a trip must be debounced (PressureConfirmTimer) before it counts - momentary pressure spikes aren't a real jam. Hold latches through a confirmed trip and only releases once pressure has genuinely cleared for PressureClearResumeDelay, so a bouncing switch can't re-trigger the count on every scan. Count resets each cycle start (Step 0-to-10 launch condition), not on a rolling time window."
  TON(PressureConfirmTimer, IN := IO.Step = 10 AND IO.HighPressure, PT := PressureTripConfirmTimeMS)
  TON(PressureClearTimer, IN := PressureHold AND NOT IO.HighPressure, PT := PressureClearResumeDelayMS)
  COIL PressureHold := PressureConfirmTimer.Q OR PressureHold AND NOT PressureClearTimer.Q
  COIL PressureConfirmEdge := PressureConfirmTimer.Q AND NOT PressureConfirmEdgeMem
  COIL PressureConfirmEdgeMem := PressureConfirmTimer.Q
  MOVE(EN := (IO.Mode = 1 AND IO.HopperHighLevel OR IO.Mode = 2 AND IO.ManualCycleCmd) AND IO.Step = 0 AND IO.HomeLimit AND IO.Enable AND NOT IO.Blocked OR IO.FaultReset, IN := 0) => PressureTripCount
  ADD(EN := PressureConfirmEdge, IN1 := 1, IN2 := PressureTripCount) => PressureTripCount

NETWORK 5 "Blocked Fault (Too Many Jams)"
  COIL IO.Blocked := PressureTripCount >= IO.PressureTripCountThreshold OR IO.Blocked AND NOT IO.FaultReset

NETWORK 6 "Step 0 (Parked) - Transitions"
  COMMENT "Not-at-home while idle (power-up mid-stroke, or a cycle that ended without reaching HomeLimit) drives straight to Retract (30) to re-establish home before any new cycle is accepted - never straight back into a forward stroke from an unknown position. Suppressed during an active jog command so jogging isn't fought by an auto-retract."
  MOVE(EN := NOT ((IO.JogExtendCmd OR IO.JogRetractCmd) AND IO.Mode = 2) AND IO.Step = 0 AND NOT IO.HomeLimit, IN := 30) => IO.Step
  MOVE(EN := (IO.Mode = 1 AND IO.HopperHighLevel OR IO.Mode = 2 AND IO.ManualCycleCmd) AND IO.Step = 0 AND IO.HomeLimit AND IO.Enable AND NOT IO.Blocked, IN := 10) => IO.Step

NETWORK 7 "Step 10 (Drive To End Travel) - Timer, Timeout Fault, And Transitions"
  COMMENT "Every abnormal exit - Off commanded mid-stroke, or a timeout, whether or not it also trips Blocked - goes straight to Retract (30), never a bare stop; the ram is never left sitting mid-travel. Only reaching FullTravelLimit cleanly goes to Hold (20) first, per the normal cycle."
  TON(EndTravelTimer, IN := IO.Step = 10, PT := EndTravelTimeoutMS)
  COIL IO.EndTravelTimeoutFault := EndTravelTimer.Q OR IO.EndTravelTimeoutFault AND NOT IO.FaultReset
  MOVE(EN := IO.Step = 10 AND IO.Mode = 0, IN := 30) => IO.Step
  MOVE(EN := IO.Step = 10 AND IO.Mode <> 0 AND EndTravelTimer.Q, IN := 30) => IO.Step
  MOVE(EN := IO.Step = 10 AND IO.Mode <> 0 AND NOT EndTravelTimer.Q AND IO.Blocked, IN := 30) => IO.Step
  MOVE(EN := IO.Step = 10 AND IO.Mode <> 0 AND NOT EndTravelTimer.Q AND NOT IO.Blocked AND IO.FullTravelLimit, IN := 20) => IO.Step

NETWORK 8 "Step 20 (Hold) - Timer And Transition"
  TON(HoldTimer, IN := IO.Step = 20, PT := EndTravelHoldTimeMS)
  MOVE(EN := (HoldTimer.Q OR IO.Mode = 0) AND IO.Step = 20, IN := 30) => IO.Step

NETWORK 9 "Step 30 (Retract) - Timer, Timeout Fault, And Transition"
  COMMENT "ParkedTimer's own Q only feeds the timeout fault, not a transition - if genuinely stuck retracting there's no safer step to force (unlike Step 10, nothing here can be aborted into); alarm-only by design, awaiting a human."
  TON(ParkedTimer, IN := IO.Step = 30, PT := ParkedTimeoutMS)
  COIL IO.ParkedTimeoutFault := ParkedTimer.Q OR IO.ParkedTimeoutFault AND NOT IO.FaultReset
  MOVE(EN := IO.Step = 30 AND IO.HomeLimit, IN := 0) => IO.Step

NETWORK 10 "Jog Pre-Start Warning"
  TON(JogPreStartTimer, IN := (IO.JogExtendCmd OR IO.JogRetractCmd) AND IO.Step = 0 AND IO.Mode = 2, PT := JogWarningTimeMS)
  COIL IO.JogPreStartSounder := (IO.JogExtendCmd OR IO.JogRetractCmd) AND IO.Step = 0 AND IO.Mode = 2

NETWORK 11 "Extend And Retract Demand"
  COMMENT "PressureHold gates ExtendDemand so a confirmed jam holds the ram in place rather than continuing to push (a hold per C-123, not a fault - it clears and driving resumes the instant pressure has cleared). Jog demand only arms after JogPreStartTimer.Q so a jog button press always gets the same audible pre-start warning as an auto cycle, never an instant unwarned move."
  COIL ExtendDemand := IO.Step = 10 AND NOT PressureHold OR IO.Step = 0 AND IO.Mode = 2 AND IO.JogExtendCmd AND JogPreStartTimer.Q
  COIL RetractDemand := IO.Step = 30 OR IO.Step = 0 AND IO.Mode = 2 AND IO.JogRetractCmd AND JogPreStartTimer.Q

NETWORK 12 "Pump Demand"
  COIL PumpDemand := ExtendDemand OR RetractDemand
  COIL PumpEverDemanded := PumpDemand OR PumpEverDemanded

NETWORK 13 "Pump Run-On Timer And Output Commands"
  COMMENT "Off-delay built from TON+inversion, not TOF/TONR (C-406). PumpEverDemanded guards a cold-start gap: on power-up PumpDemand and the timer's Q are both initially false, which would read as 'run-on already elapsed' and skip straight to no-run. RunPowerPack stays on through the run-on tail even after demand drops, but the Extend/Retract solenoids are not - they only ever follow live demand, gated by PowerPackRunningFB so the ram can't be commanded before the pump has confirmed running."
  TON(PumpRunOnTimer, IN := NOT PumpDemand, PT := PumpRunOnTimeMS)
  COIL IO.RunPowerPack := PumpDemand OR PumpEverDemanded AND NOT PumpRunOnTimer.Q
  COIL IO.Extend := ExtendDemand AND IO.PowerPackRunningFB
  COIL IO.Retract := RetractDemand AND IO.PowerPackRunningFB
  COIL IO.Cycling := IO.Step <> 0

SIDECAR
NETWORK 1
  compileunit = 3
  access IO.Mode = 22 LocalVariable
  access IO.Fitted = 21 LocalVariable
  access IO.Enable = 23 LocalVariable
