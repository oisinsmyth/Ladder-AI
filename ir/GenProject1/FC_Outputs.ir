BLOCK FC FC_Outputs
ROOTID 0
NUMBER 2
LANGUAGE LAD
TITLE "Output Map"

INTERFACE
  INPUT
  OUTPUT
  CONSTANT

NETWORK 1 "PLC1 Built-in DQ (CPU 1214C)"
  COIL DQ1_SHR_RunFwd := AlwaysTrue AND DB_Output.Run_Shredder_Fwd AND NOT DB_Output.Test[0] OR AlwaysTrue AND DB_Output.Test[1]
  COIL DQ2_SHR_RunRev := AlwaysTrue AND DB_Output.Run_Shredder_Rev AND NOT DB_Output.Test[0] OR AlwaysTrue AND DB_Output.Test[2]
  COIL DQ3_PSH_RunPowerPack := AlwaysTrue AND DB_Output.Run_PowerPack AND NOT DB_Output.Test[0] OR AlwaysTrue AND DB_Output.Test[3]
  COIL DQ4_IFC_Run := AlwaysTrue AND DB_Output.Run_Infeed_Conv AND NOT DB_Output.Test[0] OR AlwaysTrue AND DB_Output.Test[4]
  COIL DQ5_DIS_Run := AlwaysTrue AND DB_Output.Run_Discharge_Conv AND NOT DB_Output.Test[0] OR AlwaysTrue AND DB_Output.Test[5]
  COIL DQ6_PSH_Extend := AlwaysTrue AND DB_Output.Pusher_Extend AND NOT DB_Output.Test[0] OR AlwaysTrue AND DB_Output.Test[6]
  COIL DQ7_PSH_Retract := AlwaysTrue AND DB_Output.Pusher_Retract AND NOT DB_Output.Test[0] OR AlwaysTrue AND DB_Output.Test[7]
  COIL DQ8_SYS_InCycle := AlwaysTrue AND DB_Output.In_Cycle AND NOT DB_Output.Test[0] OR AlwaysTrue AND DB_Output.Test[8]
  COIL DQ9_SYS_EnableUpstream := AlwaysTrue AND DB_Output.Enable_Upstream AND NOT DB_Output.Test[0] OR AlwaysTrue AND DB_Output.Test[9]
  COIL DQ10_SYS_PreStartSounder := AlwaysTrue AND DB_Output.PreStart_Sounder AND NOT DB_Output.Test[0] OR AlwaysTrue AND DB_Output.Test[10]

NETWORK 2 "PLC1.1 SM1223 DQ Relay"
  COIL DQ11_SHR_FaultReset := AlwaysTrue AND DB_Output.Motor_Fault_Reset AND NOT DB_Output.Test[0] OR AlwaysTrue AND DB_Output.Test[11]
  COIL DQ12_SPR_1 := AlwaysTrue AND DB_Output.SpareDQ[1] AND NOT DB_Output.Test[0] OR AlwaysTrue AND DB_Output.Test[12]
  COIL DQ13_SPR_2 := AlwaysTrue AND DB_Output.SpareDQ[2] AND NOT DB_Output.Test[0] OR AlwaysTrue AND DB_Output.Test[13]
  COIL DQ14_SPR_3 := AlwaysTrue AND DB_Output.SpareDQ[3] AND NOT DB_Output.Test[0] OR AlwaysTrue AND DB_Output.Test[14]
  COIL DQ15_SPR_4 := AlwaysTrue AND DB_Output.SpareDQ[4] AND NOT DB_Output.Test[0] OR AlwaysTrue AND DB_Output.Test[15]
  COIL DQ16_SPR_5 := AlwaysTrue AND DB_Output.SpareDQ[5] AND NOT DB_Output.Test[0] OR AlwaysTrue AND DB_Output.Test[16]
  COIL DQ17_SPR_6 := AlwaysTrue AND DB_Output.SpareDQ[6] AND NOT DB_Output.Test[0] OR AlwaysTrue AND DB_Output.Test[17]
  COIL DQ18_SPR_7 := AlwaysTrue AND DB_Output.SpareDQ[7] AND NOT DB_Output.Test[0] OR AlwaysTrue AND DB_Output.Test[18]

