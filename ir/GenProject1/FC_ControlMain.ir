BLOCK FC FC_ControlMain
ROOTID 0
NUMBER 3
LANGUAGE LAD
TITLE "Control Main"

INTERFACE
  INPUT
  OUTPUT
  CONSTANT

NETWORK 1 "Sequencer Input Wiring"
  COIL iDB_ShredderSequencer.IO.CycleStart := DB_Input.Cycle_Start
  COIL iDB_ShredderSequencer.IO.CycleStop := DB_Input.Cycle_Stop
  COIL iDB_ShredderSequencer.IO.DownstreamRunning := DB_Input.Downstream_Running
  COIL iDB_ShredderSequencer.IO.DischargeConvRunning := DB_Input.Discharge_Conv_Running
  COIL iDB_ShredderSequencer.IO.HopperLevelHigh := DB_Input.Hopper_Level_High
  COIL iDB_ShredderSequencer.IO.ShredderRunFwdFB := DB_Input.Shredder_Run_Fwd_FB
  COIL iDB_ShredderSequencer.IO.MotorFaultActive := iDB_MotorFwdRevSystem_Shredder.IO.FaultActive
  COIL iDB_ShredderSequencer.IO.FaultReset := DB_Controls.FaultReset
  COIL iDB_ShredderSequencer.IO.PusherJogPreStartSounder := iDB_PusherControl.IO.JogPreStartSounder
  MOVE(EN := TRUE, IN := DB_Controls.PusherMode) => iDB_ShredderSequencer.IO.OperatorPusherMode
  MOVE(EN := TRUE, IN := DB_AnalogInput.ShredderMotorCurrent) => iDB_ShredderSequencer.IO.ShredderMotorCurrent

NETWORK 2 "Call Sequencer"
  CALL FB_ShredderSequencer(iDB_ShredderSequencer, EN := TRUE)

NETWORK 3 "MotorFwdRevSystem Wiring"
  COIL iDB_MotorFwdRevSystem_Shredder.IO.InHand := NOT AlwaysTrue
  COIL iDB_MotorFwdRevSystem_Shredder.IO.RecentStart := AlwaysTrue
  COIL iDB_MotorFwdRevSystem_Shredder.IO.SystemHealthy := DB_Input.Control_Healthy
  COIL iDB_MotorFwdRevSystem_Shredder.IO.RunningFBFwd := DB_Input.Shredder_Run_Fwd_FB
  COIL iDB_MotorFwdRevSystem_Shredder.IO.RunningFBRev := DB_Input.Shredder_Run_Rev_FB
  COIL iDB_MotorFwdRevSystem_Shredder.IO.FaultFB := DB_Input.Motor_Fault
  COIL iDB_MotorFwdRevSystem_Shredder.IO.FaultReset := DB_Controls.FaultReset
  COIL iDB_MotorFwdRevSystem_Shredder.IO.InhibitMotor := NOT AlwaysTrue
  COIL iDB_MotorFwdRevSystem_Shredder.IO.HandReverse := NOT AlwaysTrue
  COIL iDB_MotorFwdRevSystem_Shredder.IO.PreStartDone := iDB_ShredderSequencer.IO.MotorPreStartDoneCmd
  COIL iDB_MotorFwdRevSystem_Shredder.IO.AutoStartSignal := iDB_ShredderSequencer.IO.MotorAutoStartCmd
  COIL iDB_MotorFwdRevSystem_Shredder.IO.Reverse := iDB_ShredderSequencer.IO.MotorReverseCmd

NETWORK 4 "Call Shredder Motor"
  CALL FB_MotorFwdRevSystem(iDB_MotorFwdRevSystem_Shredder, EN := TRUE)

NETWORK 5 "PusherControl Wiring"
  COIL iDB_PusherControl.IO.Fitted := DB_Settings.PusherFitted
  COIL iDB_PusherControl.IO.HopperHighLevel := DB_Input.Hopper_Level_High
  COIL iDB_PusherControl.IO.ManualCycleCmd := DB_Controls.PusherManualCycleCmd
  COIL iDB_PusherControl.IO.JogExtendCmd := DB_Controls.PusherJogExtendCmd
  COIL iDB_PusherControl.IO.JogRetractCmd := DB_Controls.PusherJogRetractCmd
  COIL iDB_PusherControl.IO.HomeLimit := DB_Input.Pusher_Home_Limit
  COIL iDB_PusherControl.IO.FullTravelLimit := DB_Input.Pusher_Full_Travel_Limit
  COIL iDB_PusherControl.IO.HighPressure := DB_Input.Pusher_High_Pressure
  COIL iDB_PusherControl.IO.PowerPackRunningFB := DB_Input.Pusher_PowerPack_Running
  COIL iDB_PusherControl.IO.FaultReset := DB_Controls.FaultReset
  MOVE(EN := TRUE, IN := iDB_ShredderSequencer.IO.PusherModeCmd) => iDB_PusherControl.IO.Mode
  MOVE(EN := TRUE, IN := DB_Settings.PusherEndTravelTimeout) => iDB_PusherControl.IO.EndTravelTimeout
  MOVE(EN := TRUE, IN := DB_Settings.PusherParkedTimeout) => iDB_PusherControl.IO.ParkedTimeout
  MOVE(EN := TRUE, IN := DB_Settings.PusherEndTravelHoldTime) => iDB_PusherControl.IO.EndTravelHoldTime
  MOVE(EN := TRUE, IN := DB_Settings.PusherPumpRunOnTime) => iDB_PusherControl.IO.PumpRunOnTime
  MOVE(EN := TRUE, IN := DB_Settings.PusherJogWarningTime) => iDB_PusherControl.IO.JogWarningTime
  MOVE(EN := TRUE, IN := DB_Settings.PressureTripConfirmTime) => iDB_PusherControl.IO.PressureTripConfirmTime
  MOVE(EN := TRUE, IN := DB_Settings.PressureClearResumeDelay) => iDB_PusherControl.IO.PressureClearResumeDelay
  MOVE(EN := TRUE, IN := DB_Settings.PressureTripCountThreshold) => iDB_PusherControl.IO.PressureTripCountThreshold

NETWORK 6 "Call Pusher"
  CALL FB_PusherControl(iDB_PusherControl, EN := TRUE)

NETWORK 7 "Output Mapping"
  COMMENT "In_Cycle lamp definition (owner ruling, 2026-07-16): on whenever any piece of equipment is running - taken from field running feedbacks (shredder fwd/rev, discharge conveyor, infeed conveyor, pusher power pack), not PLC run commands, so the lamp reflects what the machine is actually doing. This also gives Infeed_Conv_Running its consumer. iDB_ShredderSequencer.IO.InCycle is superseded by this rung and no longer wired; removing the member is deferred to the queued settings-rework request (interface change)."
  COIL DB_Output.Run_Shredder_Fwd := iDB_MotorFwdRevSystem_Shredder.IO.RunFwd
  COIL DB_Output.Run_Shredder_Rev := iDB_MotorFwdRevSystem_Shredder.IO.RunRev
  COIL DB_Output.Run_Discharge_Conv := iDB_ShredderSequencer.IO.RunDischargeConv
  COIL DB_Output.Run_Infeed_Conv := iDB_ShredderSequencer.IO.RunInfeedConv
  COIL DB_Output.Enable_Upstream := iDB_ShredderSequencer.IO.EnableUpstream
  COIL DB_Output.PreStart_Sounder := iDB_ShredderSequencer.IO.PreStartSounder
  COIL DB_Output.In_Cycle := DB_Input.Shredder_Run_Fwd_FB OR DB_Input.Shredder_Run_Rev_FB OR DB_Input.Discharge_Conv_Running OR DB_Input.Infeed_Conv_Running OR DB_Input.Pusher_PowerPack_Running
  COIL DB_Output.Motor_Fault_Reset := DB_Controls.FaultReset
  COIL DB_Output.Pusher_Extend := iDB_PusherControl.IO.Extend
  COIL DB_Output.Pusher_Retract := iDB_PusherControl.IO.Retract
  COIL DB_Output.Run_PowerPack := iDB_PusherControl.IO.RunPowerPack

SIDECAR
