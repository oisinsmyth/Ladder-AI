BLOCK FB FB_ShredderSequencer
ROOTID 0
NUMBER 8
LANGUAGE LAD
TITLE "Shredder Plant Sequencer"
COMMENT "Shredder plant sequencer (C-118-C-125): commands the shredder motor (via FB_MotorFwdRevSystem, wired at FC_ControlMain) and gates infeed/discharge conveyors and upstream enable, through a stepped cycle. Step legend (C-120): 0=Idle (stopped, waiting for a start condition) - 10=PreStart (siren warning before motion) - 20=DischargeStart (discharge conveyor starting, timed) - 30=ReverseRun (shredder commanded reverse - see FB_MotorFwdRevSystem's own pause/reversal handling) - 40=WaitForwardRun (waiting for forward-run feedback) - 50=Running (normal production; infeed/upstream-enable timers and overcurrent detection are live) - 60=OvercurrentAbort (tripped - pause, then retry into ReverseRun, or stay out if too many reversals)."

INTERFACE
  INPUT
  OUTPUT
  STATIC
    IO : "UDT_ShredderSequencerIO" RETAIN SETPOINT COMMENT "Caller-visible interface (C-115) - FC_ControlMain writes CycleStart/CycleStop/feedback/tunables in, reads Run*/EnableUpstream/PreStartSounder/motor-command bits out. See the block header for the Step value legend."
      CycleStart : Bool
      CycleStop : Bool
      DownstreamRunning : Bool
      DischargeConvRunning : Bool
      HopperLevelHigh : Bool
      ShredderRunFwdFB : Bool
      ShredderMotorCurrent : Real
      MotorFaultActive : Bool
      FaultReset : Bool
      OperatorPusherMode : Int
      PusherJogPreStartSounder : Bool
      Step : Int
      DischargeConveyorTimeoutFault : Bool
      ShredderBlockedFault : Bool
      RunDischargeConv : Bool
      RunInfeedConv : Bool
      EnableUpstream : Bool
      PreStartSounder : Bool
      InCycle : Bool
      MotorReverseCmd : Bool
      MotorAutoStartCmd : Bool
      MotorPreStartDoneCmd : Bool
      PusherModeCmd : Int
    StopCmd : Bool COMMENT "Loss of DownstreamRunning stops the shredder too, not just an operator CycleStop - nowhere for shredded material to go otherwise. Read by every step's own stop transition below."
    ReversalWindowTimeMS : DInt
    PreStartSounderTimeMS : DInt
    DischargeConveyorTimeoutMS : DInt
    ShredderReverseRunTimeMS : DInt
    InfeedRestartDelayMS : DInt
    InfeedToUpstreamEnableDelayMS : DInt
    OvercurrentSpinUpAllowanceMS : DInt
    OvercurrentMediumDelayMS : DInt
    OvercurrentHighDelayMS : DInt
    ReversalRetryPauseTimeMS : DInt
    ReversalWindowTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    ReversalStepEdge : Bool
    ReversalStepEdgeMem : Bool
    ReversalCount : Int COMMENT "Reversals since the window last re-armed (not per-cycle, unlike the pusher's own PressureTripCount) - ReversalWindowTimer restarts the window every time this is above zero, so ReversalCountThreshold reversals must occur within one ReversalWindowTime of each other to raise ShredderBlockedFault, not just ReversalCountThreshold times ever."
    PreStartTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    DischargeStartTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    ReverseRunTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    InfeedRestartTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    UpstreamEnableTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    InfeedRunning : Bool COMMENT "Latched once InfeedRestartTimer has timed out from the last hopper-clear - drives RunInfeedConv directly and (after a further UpstreamEnableTimer delay) EnableUpstream."
    SpinUpTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    OvercurrentMediumTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    OvercurrentHighTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    OvercurrentTripped : Bool COMMENT "KNOWN GAP, not wired to real current yet: both timers below are gated 'AND NOT AlwaysTrue' (permanently false placeholders) because DB_AnalogInput.ShredderMotorCurrent > DB_Settings.OvercurrentSetpointMedium/High is a genuine Real-vs-Real comparison this converter's synthesizer can't type correctly yet (hardcodes Int) - flagged and deferred rather than guessed at. This bit, and Step 50's own overcurrent-abort transition, are dead code until that's built."
    OvercurrentAbortPauseTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
  TEMP
    Time : Real
  CONSTANT

NETWORK 1 "Stop Command"
  COIL StopCmd := IO.CycleStop OR NOT IO.DownstreamRunning

NETWORK 2 "HMI Time Conversions"
  COMMENT "HMI/DB_Settings times are Real seconds for operator legibility; every TON below needs its PT in DInt ms - one MUL+CONVERT pair per timer, matching the MotorDOL FTTime/EnableUPSTime idiom. Kept as one block up front rather than repeated at each timer, so the x1000 idiom is visibly consistent and only ever done once."
  MUL(EN := TRUE, IN1 := DB_Settings.ReversalWindowTime, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := DB_Settings.PreStartSounderTime, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := DB_Settings.DischargeConveyorTimeout, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := DB_Settings.ShredderReverseRunTime, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := DB_Settings.InfeedRestartDelay, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := DB_Settings.InfeedToUpstreamEnableDelay, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := DB_Settings.OvercurrentSpinUpAllowance, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := DB_Settings.OvercurrentMediumDelay, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := DB_Settings.OvercurrentHighDelay, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := DB_Settings.ReversalRetryPauseTime, IN2 := 1000.0) => Time
  CONVERT(EN := ENO, IN := Time) => ReversalWindowTimeMS
  CONVERT(EN := ENO, IN := Time) => PreStartSounderTimeMS
  CONVERT(EN := ENO, IN := Time) => DischargeConveyorTimeoutMS
  CONVERT(EN := ENO, IN := Time) => ShredderReverseRunTimeMS
  CONVERT(EN := ENO, IN := Time) => InfeedRestartDelayMS
  CONVERT(EN := ENO, IN := Time) => InfeedToUpstreamEnableDelayMS
  CONVERT(EN := ENO, IN := Time) => OvercurrentSpinUpAllowanceMS
  CONVERT(EN := ENO, IN := Time) => OvercurrentMediumDelayMS
  CONVERT(EN := ENO, IN := Time) => OvercurrentHighDelayMS
  CONVERT(EN := ENO, IN := Time) => ReversalRetryPauseTimeMS

NETWORK 3 "Reversal Re-Arm Window Timer"
  TON(ReversalWindowTimer, IN := ReversalCount > 0, PT := ReversalWindowTimeMS)

NETWORK 4 "Reversal Counter"
  COMMENT "Edge-counts entries into Step 60 (C-404 - constructed edge, not the built-in -|P|-). Resets on ReversalWindowTimer.Q (the window elapsed with nothing new) or a fault reset - see ReversalCount's own comment for why this is a re-arming window, not a per-cycle count."
  COIL ReversalStepEdge := IO.Step = 60 AND NOT ReversalStepEdgeMem
  COIL ReversalStepEdgeMem := IO.Step = 60
  MOVE(EN := ReversalWindowTimer.Q OR IO.FaultReset, IN := 0) => ReversalCount
  ADD(EN := ReversalStepEdge, IN1 := 1, IN2 := ReversalCount) => ReversalCount

NETWORK 5 "Shredder Blocked Fault (Too Many Reversals)"
  COIL IO.ShredderBlockedFault := ReversalCount >= DB_Settings.ReversalCountThreshold OR IO.ShredderBlockedFault AND NOT IO.FaultReset

NETWORK 6 "Step 0 (Idle) - Transition"
  MOVE(EN := NOT StopCmd AND NOT IO.ShredderBlockedFault AND IO.CycleStart AND IO.DownstreamRunning AND IO.Step = 0, IN := 10) => IO.Step

NETWORK 7 "Step 10 (PreStart) - Timer And Transitions"
  TON(PreStartTimer, IN := IO.Step = 10, PT := PreStartSounderTimeMS)
  MOVE(EN := StopCmd AND IO.Step = 10, IN := 0) => IO.Step
  MOVE(EN := NOT StopCmd AND PreStartTimer.Q AND IO.Step = 10, IN := 20) => IO.Step

NETWORK 8 "Step 20 (DischargeStart) - Timer, Timeout Fault, And Transitions"
  TON(DischargeStartTimer, IN := IO.Step = 20, PT := DischargeConveyorTimeoutMS)
  COIL IO.DischargeConveyorTimeoutFault := DischargeStartTimer.Q OR IO.DischargeConveyorTimeoutFault AND NOT IO.FaultReset
  MOVE(EN := StopCmd AND IO.Step = 20, IN := 0) => IO.Step
  MOVE(EN := NOT StopCmd AND DischargeStartTimer.Q AND IO.Step = 20, IN := 0) => IO.Step
  MOVE(EN := NOT StopCmd AND NOT DischargeStartTimer.Q AND IO.DischargeConvRunning AND IO.Step = 20, IN := 30) => IO.Step

NETWORK 9 "Step 30 (ReverseRun) - Timer And Transitions"
  TON(ReverseRunTimer, IN := IO.Step = 30, PT := ShredderReverseRunTimeMS)
  MOVE(EN := StopCmd AND IO.Step = 30, IN := 0) => IO.Step
  MOVE(EN := NOT StopCmd AND IO.MotorFaultActive AND IO.Step = 30, IN := 0) => IO.Step
  MOVE(EN := NOT StopCmd AND NOT IO.MotorFaultActive AND ReverseRunTimer.Q AND IO.Step = 30, IN := 40) => IO.Step

NETWORK 10 "Step 40 (WaitForwardRun) - Transitions"
  MOVE(EN := StopCmd AND IO.Step = 40, IN := 0) => IO.Step
  MOVE(EN := NOT StopCmd AND IO.MotorFaultActive AND IO.Step = 40, IN := 0) => IO.Step
  MOVE(EN := NOT StopCmd AND NOT IO.MotorFaultActive AND IO.ShredderRunFwdFB AND IO.Step = 40, IN := 50) => IO.Step

NETWORK 11 "Step 50 (Running) - Infeed Restart, Upstream Enable, And Outputs"
  COMMENT "UpstreamEnableTimer's own IN reads InfeedRunning one scan behind this network's own InfeedRunning update below (it's kind-ordered before the coil that writes it) - harmless for a multi-second delay, and matches this design's original timing exactly. EnableUpstream lives here, next to its own timer, rather than in the general Output Commands network - this is the output the MotorFwdRevSystem CALL-site correction was specifically about: it must only ever come from Step=50 dwell time, never from motor-running telemetry."
  TON(InfeedRestartTimer, IN := IO.Step = 50 AND NOT IO.HopperLevelHigh, PT := InfeedRestartDelayMS)
  TON(UpstreamEnableTimer, IN := InfeedRunning, PT := InfeedToUpstreamEnableDelayMS)
  COIL InfeedRunning := InfeedRestartTimer.Q
  COIL IO.EnableUpstream := UpstreamEnableTimer.Q
  COIL IO.RunInfeedConv := InfeedRunning

NETWORK 12 "Step 50 - Overcurrent Detection, Trip, And Transitions"
  COMMENT "SpinUpTimer allows a brief inrush allowance before either overcurrent timer arms (both gated on SpinUpTimer.Q) - see OvercurrentTripped's own comment for the AlwaysTrue placeholder gap this still has."
  TON(SpinUpTimer, IN := IO.Step = 50, PT := OvercurrentSpinUpAllowanceMS)
  TON(OvercurrentMediumTimer, IN := IO.Step = 50 AND SpinUpTimer.Q AND NOT AlwaysTrue, PT := OvercurrentMediumDelayMS)
  TON(OvercurrentHighTimer, IN := IO.Step = 50 AND SpinUpTimer.Q AND NOT AlwaysTrue, PT := OvercurrentHighDelayMS)
  COIL OvercurrentTripped := OvercurrentMediumTimer.Q OR OvercurrentHighTimer.Q
  MOVE(EN := StopCmd AND IO.Step = 50, IN := 0) => IO.Step
  MOVE(EN := NOT StopCmd AND IO.MotorFaultActive AND IO.Step = 50, IN := 0) => IO.Step
  MOVE(EN := NOT StopCmd AND NOT IO.MotorFaultActive AND OvercurrentTripped AND IO.Step = 50, IN := 60) => IO.Step

NETWORK 13 "Step 60 (OvercurrentAbort) - Timer And Transitions"
  TON(OvercurrentAbortPauseTimer, IN := IO.Step = 60, PT := ReversalRetryPauseTimeMS)
  MOVE(EN := StopCmd AND IO.Step = 60, IN := 0) => IO.Step
  MOVE(EN := NOT StopCmd AND OvercurrentAbortPauseTimer.Q AND IO.ShredderBlockedFault AND IO.Step = 60, IN := 0) => IO.Step
  MOVE(EN := NOT StopCmd AND OvercurrentAbortPauseTimer.Q AND NOT IO.ShredderBlockedFault AND IO.Step = 60, IN := 30) => IO.Step

NETWORK 14 "Motor And Pusher Mode Commands"
  COIL IO.MotorReverseCmd := IO.Step = 30
  COIL IO.MotorAutoStartCmd := IO.Step >= 30 AND IO.Step <= 50
  COIL IO.MotorPreStartDoneCmd := IO.Step >= 20
  MOVE(EN := IO.Step = 60, IN := 0) => IO.PusherModeCmd
  MOVE(EN := IO.Step <> 60, IN := IO.OperatorPusherMode) => IO.PusherModeCmd

NETWORK 15 "Output Commands"
  COIL IO.RunDischargeConv := IO.Step >= 20
  COIL IO.PreStartSounder := IO.Step = 10 OR IO.PusherJogPreStartSounder

SIDECAR
NETWORK 1
  compileunit = 3
  access IO.CycleStop = 21 LocalVariable
  access IO.DownstreamRunning = 22 LocalVariable
  access StopCmd = 23 LocalVariable
  assignment 0
    rail = none
    step 0 or
      uid = 26
      branch 0
        rail = 30
        step 0 contact
          uid = 24
          operand = 21
          operandwire = 28
          negated = false
          out = 29
      branch 1
        rail = 30
        step 0 contact
          uid = 25
          operand = 22
          operandwire = 31
          negated = true
          out = 32
      out = 33
    coil = 27
    coil operand = 23
    coil operandwire = 34
