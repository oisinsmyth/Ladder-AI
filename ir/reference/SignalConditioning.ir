BLOCK FC SignalConditioning
ROOTID 0
NUMBER 21
LANGUAGE LAD
COMMENT "Arithmetic/box-instruction reference examples (Mul/Convert/Sub/Div/Abs/Swap)"

INTERFACE
  INPUT
  OUTPUT
  TEMP
    SpeedRawA : Real
    ScaleFactor : Real
    SpeedScaled : Real
    SpeedScaledSource : Real
    SpeedConverted : DInt
    Enable : Bool
    Level : Int
    MinuendA : Int
    SubtrahendA : Int
    Difference : Int
    DividendB : Int
    DivisorB : Int
    Quotient : Int
    GateBit : Bool
    SignedValue : Real
    AbsValue : Real
    ControlWord : Word
    SwappedWord : Word
  CONSTANT

NETWORK 1 "Speed scaling (Mul/Convert)"
  MUL(EN := TRUE, IN1 := SpeedRawA, IN2 := ScaleFactor) => SpeedScaled
  CONVERT(EN := ENO, IN := SpeedScaledSource) => SpeedConverted

NETWORK 2 "Level-gated Sub/Div"
  SUB(EN := Enable AND Level < 10, IN1 := MinuendA, IN2 := SubtrahendA) => Difference
  DIV(EN := ENO, IN1 := DividendB, IN2 := DivisorB) => Quotient

NETWORK 3 "Signed value magnitude (Abs)"
  ABS(EN := GateBit, IN := SignedValue) => AbsValue

NETWORK 4 "Control word byte swap"
  SWAP(EN := GateBit, IN := ControlWord) => SwappedWord

SIDECAR
NETWORK 1
  compileunit = 3
  access SpeedRawA = 21 LocalVariable
  access ScaleFactor = 22 LocalVariable
  access SpeedScaled = 23 LocalVariable
  access SpeedScaledSource = 24 LocalVariable
  access SpeedConverted = 25 LocalVariable
  mul 0
    muluid = 26
    kind = mul
    en = condition
      rail = 28
    input 0 tag = 21 29
    input 1 tag = 22 30
    dest = 23
    destwire = 31
  convert 0
    convertuid = 27
    en = eno 26 32
    in tag = 24 33
    srctype = Real
    desttype = DInt
    dest = 25
    destwire = 34
NETWORK 2
  compileunit = 8
  access Level = 21 LocalVariable
  access Enable = 22 LocalVariable
  access MinuendA = 23 LocalVariable
  access SubtrahendA = 24 LocalVariable
  access Difference = 25 LocalVariable
  access DividendB = 26 LocalVariable
  access DivisorB = 27 LocalVariable
  access Quotient = 28 LocalVariable
  constant 10 = 29 Int
  mul 0
    muluid = 32
    kind = sub
    en = condition
      rail = 39
      step 0 contact
        uid = 30
        operand = 22
        operandwire = 34
        negated = false
        out = 35
      step 1 compare
        partname = Lt
        uid = 31
        srctype = Int
        left tag = 21 36
        right literal = 29 37
        out = 38
    input 0 tag = 23 40
    input 1 tag = 24 41
    dest = 25
    destwire = 42
  mul 1
    muluid = 33
    kind = div
    en = eno 32 43
    input 0 tag = 26 44
    input 1 tag = 27 45
    dest = 28
    destwire = 46
NETWORK 3
  compileunit = D
  access GateBit = 21 LocalVariable
  access SignedValue = 22 LocalVariable
  access AbsValue = 23 LocalVariable
  abs 0
    absuid = 25
    en = condition
      rail = 28
      step 0 contact
        uid = 24
        operand = 21
        operandwire = 26
        negated = false
        out = 27
    in tag = 22 29
    srctype = Real
    dest = 23
    destwire = 30
NETWORK 4
  compileunit = 12
  access GateBit = 21 LocalVariable
  access ControlWord = 22 LocalVariable
  access SwappedWord = 23 LocalVariable
  swap 0
    swapuid = 25
    en = condition
      rail = 28
      step 0 contact
        uid = 24
        operand = 21
        operandwire = 26
        negated = false
        out = 27
    in tag = 22 29
    srctype = Word
    dest = 23
    destwire = 30
