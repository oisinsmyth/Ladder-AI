BLOCK FC BooleanExtras
ROOTID 0
NUMBER 23
LANGUAGE LAD
COMMENT "Boolean reference examples (standalone Not, SCoil/RCoil)"

INTERFACE
  INPUT
  OUTPUT
  TEMP
    EnableCmd : Bool
    FaultLatch : Bool
    RunA : Bool
    StartCmd : Bool
    Run : Bool
    SetCmd : Bool
    Motor1Latched : Bool
    ResetCmd : Bool
  CONSTANT

NETWORK 1 "Interlock inversion (Not)"
  COIL RunA := NOT (EnableCmd) AND FaultLatch

NETWORK 2 "Motor latch (SCoil/RCoil)"
  COIL Run := StartCmd
  SCOIL Motor1Latched := SetCmd
  RCOIL Motor1Latched := ResetCmd
