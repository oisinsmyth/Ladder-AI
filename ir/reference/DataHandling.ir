BLOCK FC DataHandling
ROOTID 0
NUMBER 22
LANGUAGE LAD
COMMENT "Data-handling reference examples (WAND/Calc/T_SUB/T_CONV/MOVE_BLK_VARIANT/Move)"

INTERFACE
  INPUT
  OUTPUT
  TEMP
    DriveRunPermit : Bool
    StatusWord : Word
    DriveHealthy : Bool
    DriveFaultReset : Bool
    CommandWord : Word
    Speed : Real
    Ratio : Real
    Divisor : Real
    ScaledSpeed : Real
    StartTime : Time
    EndTime : Time
    ElapsedTime : Time
    ElapsedMillis : UDInt
    SourceArray : Variant
    ElementCount : UDInt
    SourceStartIndex : UDInt
    DestStartIndex : UDInt
    MoveResult : Int
    TargetArray : Variant
    RunPermit : Bool
    SourceValue : Int
    StatusCode : Int
  CONSTANT

NETWORK 1 "Drive command word (WAND)"
  COIL StatusWord.%X0 := DriveRunPermit
  COIL StatusWord.%X3 := DriveHealthy
  COIL StatusWord.%X7 := DriveFaultReset
  WAND(EN := TRUE, IN1 := StatusWord, IN2 := 16#89) => CommandWord

NETWORK 2 "Speed ratio (Calc)"
  CALC(EN := TRUE, IN1 := Speed, IN2 := Ratio, IN3 := Divisor) => ScaledSpeed "IN1*(IN2/IN3)"

NETWORK 3 "Elapsed time conversion"
  T_SUB(EN := TRUE, IN1 := StartTime, IN2 := EndTime) => ElapsedTime
  T_CONV(EN := ENO, IN := StartTime) => ElapsedMillis

NETWORK 4 "Variant block move"
  MOVE_BLK_VARIANT(EN := TRUE, SRC := SourceArray, COUNT := ElementCount, SRC_INDEX := SourceStartIndex, DEST_INDEX := DestStartIndex, Ret_Val => MoveResult, DEST => TargetArray)

NETWORK 5 "Status code tap"
  MOVE(EN := RunPermit, IN := SourceValue) => StatusCode
