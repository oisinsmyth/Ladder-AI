BLOCK FC PerimeterSafetyAlarms
ROOTID 0
NUMBER 18
LANGUAGE LAD

NETWORK 1 ""
  COIL AlarmWords.AlarmWord1.%X0 := NOT EquipmentStatus.SafetyZone1 OR NOT EquipmentStatus.SafetyZone2 OR NOT EquipmentStatus.SafetyZone3
  COIL AlarmWords.AlarmWord1.%X1 := NOT EquipmentStatus.SafetyZone1
  COIL AlarmWords.AlarmWord1.%X2 := NOT EquipmentStatus.SafetyZone2
  COIL AlarmWords.AlarmWord1.%X3 := NOT EquipmentStatus.SafetyZone3
  COIL AlarmWords.AlarmWord1.%X4 := NOT EquipmentStatus.SafetyGate1
  COIL AlarmWords.AlarmWord1.%X5 := EquipmentStatus.SafetyPullCord1
  COIL AlarmWords.AlarmWord1.%X6 := EquipmentStatus.FireDamper1
  COIL AlarmWords.AlarmWord1.%X7 := EquipmentStatus.FireDamper2

NETWORK 2 "" [empty]

SIDECAR
NETWORK 1
  compileunit = 3
  access EquipmentStatus.SafetyZone1 = 21
  access EquipmentStatus.SafetyZone2 = 22
  access EquipmentStatus.SafetyZone3 = 23
  access AlarmWords.AlarmWord1.%X0 = 24
  access EquipmentStatus.SafetyZone1 = 25
  access AlarmWords.AlarmWord1.%X1 = 26
  access EquipmentStatus.SafetyZone2 = 27
  access AlarmWords.AlarmWord1.%X2 = 28
  access EquipmentStatus.SafetyZone3 = 29
  access AlarmWords.AlarmWord1.%X3 = 30
  access EquipmentStatus.SafetyGate1 = 31
  access AlarmWords.AlarmWord1.%X4 = 32
  access EquipmentStatus.SafetyPullCord1 = 33
  access AlarmWords.AlarmWord1.%X5 = 34
  access EquipmentStatus.FireDamper1 = 35
  access AlarmWords.AlarmWord1.%X6 = 36
  access EquipmentStatus.FireDamper2 = 37
  access AlarmWords.AlarmWord1.%X7 = 38
  assignment 0
    rail = 58
    step 0 or
      uid = 42
      branch 0 contact
        uid = 39
        operand = 21
        operandwire = 59
        negated = true
        out = 60
      branch 1 contact
        uid = 40
        operand = 22
        operandwire = 61
        negated = true
        out = 62
      branch 2 contact
        uid = 41
        operand = 23
        operandwire = 63
        negated = true
        out = 64
      out = 65
    coil = 43
    coil operand = 24
    coil operandwire = 66
  assignment 1
    rail = 58
    step 0 contact
      uid = 44
      operand = 25
      operandwire = 67
      negated = true
      out = 68
    coil = 45
    coil operand = 26
    coil operandwire = 69
  assignment 2
    rail = 58
    step 0 contact
      uid = 46
      operand = 27
      operandwire = 70
      negated = true
      out = 71
    coil = 47
    coil operand = 28
    coil operandwire = 72
  assignment 3
    rail = 58
    step 0 contact
      uid = 48
      operand = 29
      operandwire = 73
      negated = true
      out = 74
    coil = 49
    coil operand = 30
    coil operandwire = 75
  assignment 4
    rail = 58
    step 0 contact
      uid = 50
      operand = 31
      operandwire = 76
      negated = true
      out = 77
    coil = 51
    coil operand = 32
    coil operandwire = 78
  assignment 5
    rail = 58
    step 0 contact
      uid = 52
      operand = 33
      operandwire = 79
      negated = false
      out = 80
    coil = 53
    coil operand = 34
    coil operandwire = 81
  assignment 6
    rail = 58
    step 0 contact
      uid = 54
      operand = 35
      operandwire = 82
      negated = false
      out = 83
    coil = 55
    coil operand = 36
    coil operandwire = 84
  assignment 7
    rail = 58
    step 0 contact
      uid = 56
      operand = 37
      operandwire = 85
      negated = false
      out = 86
    coil = 57
    coil operand = 38
    coil operandwire = 87
NETWORK 2
  compileunit = 8
