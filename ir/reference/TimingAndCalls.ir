BLOCK FC TimingAndCalls
ROOTID 0
NUMBER 24
LANGUAGE LAD
COMMENT "Timer/block-call reference examples (TONR/TOF/CALL)"

INTERFACE
  INPUT
  OUTPUT
  TEMP
    RunEnable : Bool
    ResetRequest : Bool
    RunTimePreset : Time
    HoldEnable : Bool
    HoldTimePreset : Time
    RawValue : Real
    ScaleMax : Real
    ScaledValue : Real
  CONSTANT

NETWORK 1 "Run time accumulation (TONR)"
  TONR(FBTimers.RunTimeTimer, IN := RunEnable, PT := RunTimePreset, R := ResetRequest)

NETWORK 2 "Hold delay (TOF)"
  TOF(FBTimers.HoldTimer, IN := HoldEnable, PT := HoldTimePreset)

NETWORK 3 "Analog scaling (CALL ScaleValue)"
  CALL ScaleValue(EN := TRUE, RawInput := RawValue, ScaleFactor := ScaleMax, ScaledResult => ScaledValue)
