BLOCK FC TimerSample
ROOTID 0
NUMBER 1
LANGUAGE LAD
TITLE "Chained On-Delay Timer Sequence"

INTERFACE
  INPUT
  OUTPUT
  CONSTANT

NETWORK 1 "Timer 0: Fixed 100ms Preset"
  TON(DB_Timers.SampleTimer0, IN := TempControlBools.run0, PT := T#100MS)
  COIL TempControlBools.out0 := DB_Timers.SampleTimer0.Q

NETWORK 2 "Timer 1: Gated by Run0 and Run1, Tag-Fed Preset"
  TON(DB_Timers.SampleTimer1, IN := TempControlBools.run0 AND TempControlBools.run1, PT := TempControlDInt.length)
  COIL TempControlBools.out1 := DB_Timers.SampleTimer1.Q

NETWORK 3 "Timer 2: Chained After Timer 0 and Timer 1 Complete"
  TON(DB_Timers.SampleTimer2, IN := DB_Timers.SampleTimer0.Q AND DB_Timers.SampleTimer1.Q AND TempControlBools.run2, PT := TempControlDInt.length)
  COIL TempControlBools.out2 := DB_Timers.SampleTimer2.Q

NETWORK 4 "" [empty]
