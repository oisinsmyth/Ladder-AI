BLOCK OB Main
ROOTID 0
NUMBER 1
LANGUAGE LAD
SECONDARYTYPE ProgramCycle
TITLE "\"Main Program Sweep (Cycle)\""

INTERFACE
  INPUT
    Initial_Call : Bool BAREPARAM INFORMATIVE "Initial call of this OB"
    Remanence : Bool BAREPARAM INFORMATIVE "=True, if remanent data are available"
  CONSTANT

NETWORK 1 "Input Mapping"
  CALL FC_Inputs(EN := TRUE)

NETWORK 2 "Control"
  CALL FC_ControlMain(EN := TRUE)

NETWORK 3 "Alarms"
  CALL FC_AlarmsMain(EN := TRUE)

NETWORK 4 "Output Mapping"
  CALL FC_Outputs(EN := TRUE)

NETWORK 5 "Modbus Server"
  COMMENT "Serves the harness mirror in marker memory to a Modbus TCP client. It runs ahead of the copy layer below so that the whole transfer between the wire and marker memory happens with no other block touching those registers in between: what the client reads is the mirror exactly as the copy layer last left it, and what the client writes is in place before the copy layer next reads it."
  CALL FB_Comms_ModbusServer(iDB_Comms_ModbusServer, EN := TRUE)

NETWORK 6 "Hopper-Blockage Stimulus Model"
  COMMENT "Advances the commanded timeline the hopper-blockage monitor is tested against. Its outputs currently drive nothing: reaching the monitor means running between the field read and the control, so that the control sees this scan's commanded state rather than this scan's field state, and this call is not at that position."
  CALL FB_HopperBlockageStim(iDB_HopperBlockageStim, EN := TRUE)
