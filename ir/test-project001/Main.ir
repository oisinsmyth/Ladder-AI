BLOCK OB Main
ROOTID 0
NUMBER 1
LANGUAGE LAD
SECONDARYTYPE ProgramCycle
TITLE "\"Main Program Sweep (Cycle)\""

INTERFACE
  INPUT
    Initial_Call : Bool BAREPARAM INFORMATIVE "Initial call of this OB"
    Remanence : Bool BAREPARAM INFORMATIVE "=True, if remanent data are available"
  CONSTANT

NETWORK 1 "Input Mapping"
  CALL FC_Inputs(EN := TRUE)

NETWORK 2 "Control"
  CALL FC_ControlMain(EN := TRUE)

NETWORK 3 "Alarms"
  CALL FC_AlarmsMain(EN := TRUE)

NETWORK 4 "Output Mapping"
  CALL FC_Outputs(EN := TRUE)

SIDECAR
NETWORK 1
  compileunit = 3
  call 0
    calluid = 21
    blockname = FC_Inputs
    blocktype = FC
    rail = 22
NETWORK 2
  compileunit = 8
  call 0
    calluid = 21
    blockname = FC_ControlMain
    blocktype = FC
    rail = 22
NETWORK 3
  compileunit = D
  call 0
    calluid = 21
    blockname = FC_AlarmsMain
    blocktype = FC
    rail = 22
NETWORK 4
  compileunit = 12
  call 0
    calluid = 21
    blockname = FC_Outputs
    blocktype = FC
    rail = 22
