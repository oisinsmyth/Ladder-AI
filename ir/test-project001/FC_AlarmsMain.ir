  compileunit = 12
  access iDB_PusherControl.IO.BothSwitchesFault = 21 GlobalVariable
  access DB_Alarms.ShredderAlarm0.%X3 = 22 GlobalVariable
  assignment 0
    rail = 25
    step 0 contact
      uid = 23
      operand = 21
      operandwire = 26
      negated = false
      out = 27
    coil = 24
    coil operand = 22
    coil operandwire = 28
