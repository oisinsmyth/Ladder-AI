  compileunit = 17
  access iDB_PusherControl.IO.Blocked = 21 GlobalVariable
  access DB_Alarms.ShredderAlarm0.%X4 = 22 GlobalVariable
  assignment 0
    rail = 25
    step 0 contact
      uid = 23
      operand = 21
      operandwire = 26
      negated = false
      out = 27
    coil = 24
    coil operand = 22
    coil operandwire = 28
NETWORK 6
  compileunit = 1C
  access iDB_PusherControl.IO.EndTravelTimeoutFault = 21 GlobalVariable
  access DB_Alarms.ShredderAlarm0.%X5 = 22 GlobalVariable
  assignment 0
    rail = 25
