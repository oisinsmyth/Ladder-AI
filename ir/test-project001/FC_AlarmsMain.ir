  assignment 0
    rail = 25
    step 0 contact
      uid = 23
      operand = 21
      operandwire = 26
      negated = false
      out = 27
    coil = 24
    coil operand = 22
    coil operandwire = 28
NETWORK 8
  compileunit = 26
  access iDB_ShredderSequencer.IO.ShredderBlockedFault = 21 GlobalVariable
  access DB_Alarms.ShredderAlarm0.%X7 = 22 GlobalVariable
  assignment 0
    rail = 25
    step 0 contact
      uid = 23
      operand = 21
      operandwire = 26
      negated = false
      out = 27
    coil = 24
