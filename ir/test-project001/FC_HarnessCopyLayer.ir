BLOCK FC FC_HarnessCopyLayer
ROOTID 0
NUMBER 9001
LANGUAGE LAD
TITLE "Harness copy layer"

INTERFACE
  INPUT
  OUTPUT
  CONSTANT

NETWORK 1 "Program version"
  MOVE(EN := TRUE, IN := 16#33434A68) => HX_ProgramVersion

NETWORK 2 "Free-running scan counter"
  ADD(EN := TRUE, IN1 := HX_ScanCount, IN2 := 1) => HX_ScanCount

NETWORK 3 "Vector in - slot HBA - Int"
  MOVE(EN := TRUE, IN := HX_HBA_V000) => iDB_HopperBlockageStim.Stim.Profile
  MOVE(EN := TRUE, IN := HX_HBA_V001) => iDB_HopperBlockageStim.Stim.Precondition
  MOVE(EN := TRUE, IN := HX_HBA_V002) => iDB_HopperBlockageStim.Stim.ResetMode

NETWORK 4 "Vector in - slot HBA - Time"
  MOVE(EN := TRUE, IN := HX_HBA_V003) => iDB_HopperBlockageStim.Stim.P1
  MOVE(EN := TRUE, IN := HX_HBA_V005) => iDB_HopperBlockageStim.Stim.P2
  MOVE(EN := TRUE, IN := HX_HBA_V007) => iDB_HopperBlockageStim.Stim.P3
  MOVE(EN := TRUE, IN := HX_HBA_V009) => iDB_HopperBlockageStim.Stim.P4
  MOVE(EN := TRUE, IN := HX_HBA_V011) => iDB_HopperBlockageStim.Stim.PreBoundaryHighRunning
  MOVE(EN := TRUE, IN := HX_HBA_V013) => iDB_HopperBlockageStim.Stim.ArmAt
  MOVE(EN := TRUE, IN := HX_HBA_V015) => iDB_HopperBlockageStim.Stim.ArmUntil
  MOVE(EN := TRUE, IN := HX_HBA_V017) => iDB_HopperBlockageStim.Stim.EndAt
  MOVE(EN := TRUE, IN := HX_HBA_V019) => iDB_HopperBlockageStim.Stim.ResetAt

NETWORK 5 "Start bool - slot HBA"
  COIL iDB_HopperBlockageStim.Stim.Start := HX_HBA_Start

NETWORK 6 "Start echo - slot HBA"
  SCOIL HX_HBA_Ran := iDB_HopperBlockageStim.Stim.Start

NETWORK 7 "Results out - slot HBA - Bool"
  COIL HX_HBA_R000 := iDB_HopperBlockageMonitor.IO.HopperBlockedAlarm
  COIL HX_HBA_R001 := iDB_HopperBlockageMonitor.IO.HopperBlockStopReq
  COIL HX_HBA_R002 := iDB_HopperBlockageStim.Stim.Armed
  COIL HX_HBA_R003 := iDB_HopperBlockageStim.Stim.ScenarioDone
  COIL HX_HBA_R004 := iDB_HarnessViolationLatch.AlarmFellWithoutReset
  COIL HX_HBA_R005 := iDB_HarnessViolationLatch.AlarmLowUnderHeldReset
  COIL HX_HBA_R006 := iDB_HarnessViolationLatch.InhibitLowWhileAlarmHigh
  COIL HX_HBA_R007 := iDB_HarnessViolationLatch.InhibitHighWhileAlarmLow

NETWORK 8 "Result latches - slot HBA"
  SCOIL HX_HBA_L008 := HX_HBA_Start AND iDB_HopperBlockageStim.Stim.Armed AND iDB_HopperBlockageMonitor.IO.HopperBlockedAlarm
  SCOIL HX_HBA_L009 := HX_HBA_Start AND iDB_HopperBlockageStim.Stim.Armed AND iDB_HopperBlockageMonitor.IO.HopperBlockStopReq
  RCOIL HX_HBA_L008 := NOT HX_HBA_Start
  RCOIL HX_HBA_L009 := NOT HX_HBA_Start
