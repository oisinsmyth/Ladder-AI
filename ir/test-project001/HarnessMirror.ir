TAGTABLE HarnessMirror
  ROOTID 0
  TAGS
    HX_ProgramVersion 1 : DWord @ %MD1000 ACCESSIBLE VISIBLE WRITABLE COMMENT "Build stamp of the downloaded IR set. Present only if this code is running."
