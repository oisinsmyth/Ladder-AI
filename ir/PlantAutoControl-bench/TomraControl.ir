  access StatusWord4 = 30 LocalVariable
  access inputWord5 = 31 LocalVariable
  access StatusWord5 = 32 LocalVariable
  access inputWord6 = 33 LocalVariable
  access StatusWord6 = 34 LocalVariable
  access inputWord7 = 35 LocalVariable
  access StatusWord7 = 36 LocalVariable
