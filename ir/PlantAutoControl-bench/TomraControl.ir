BLOCK FB TomraControlSystem
ROOTID 0
NUMBER 5
LANGUAGE LAD

INTERFACE
  INPUT
    inputWord0 : Word
    inputWord1 : Word
    inputWord2 : Word
    inputWord3 : Word
    inputWord4 : Word
    inputWord5 : Word
    inputWord6 : Word
    inputWord7 : Word
  OUTPUT
    OutputWord0 : Word
    OutputWord1 : Word
  STATIC
    StatusWord0 : Word
    StatusWord1 : Word
    StatusWord2 : Word
    StatusWord3 : Word
    StatusWord4 : Word
    StatusWord5 : Word
    StatusWord6 : Word
    StatusWord7 : Word
    ControlWord0 : Word
    ControlWord1 : Word
    HardWireSignals : Struct
      Ready : Bool
      Running : Bool
      ComError : Bool
      Run : Bool
    Inputs : Struct RETAIN
      InHand : Bool
      AutoStartSignal : Bool
      HandStartSignal : Bool
      PreStartDone : Bool
      InhibitMotor : Bool
      FaultReset : Bool
      FTTime : Real
      EnableUPSTime : Real
      HandIntervention : Bool
      RecentStart : Bool
      Shutdown : Bool
      ShutdownTime : Real
      ProgramSelection : Int
      Belt1OnDelay : Real
      Belt1OffDelay : Real
    Outputs : Struct
      FTR : Bool
      FTS : Bool
      HrsRun : UDInt
      Telemetry : Int
      Alarm0 : Word
      Alarm1 : Word
      Alarm2 : Word
      Name : String
      UPSEnable : Bool
      TryRun : Bool
      ShutdownComplete : Bool
      FaultActive : Bool
      Stop : Bool
      OSRunning : Bool
      OSComFault : Bool
    ShutdownTimeMS : DInt
    EnableUPSTimeMS : DInt
    FTTimeMS : DInt
    Belt1OnDelayMS : DInt
    Belt1OffDelayMS : DInt
    RisingEdgeFlags : Array[0..4] of Bool
    NegitiveSignalEdge : Array[0..1] of Bool
    FaultTripTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    FTSTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    EnableUpstreamTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    ShutdownTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    HrTotaliserTimer : TONR_TIME VERSION 1.0 RETAIN SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    RecentStartSignal : TOF_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    LifeBitTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    GeneralDelayTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    InHandReqPreStart : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    HrTotaliserTimerReset : Bool SETPOINT
    LostLifeBit : Bool
    PreStartMemory : Bool
    HandPosEdge : Bool
    HandNegEdge : Bool
  TEMP
    Time : Real
    Words : Array[0..1] of Byte
  CONSTANT

NETWORK 1 "Byte Swap Status"
  MOVE(EN := TRUE, IN := inputWord0) => StatusWord0
  MOVE(EN := TRUE, IN := inputWord1) => StatusWord1
  MOVE(EN := TRUE, IN := inputWord2) => StatusWord2
  MOVE(EN := TRUE, IN := inputWord3) => StatusWord3
  MOVE(EN := TRUE, IN := inputWord4) => StatusWord4
  MOVE(EN := TRUE, IN := inputWord5) => StatusWord5
  MOVE(EN := TRUE, IN := inputWord6) => StatusWord6
  MOVE(EN := TRUE, IN := inputWord7) => StatusWord7

NETWORK 2 "Optical Sorter "
  COIL Outputs.OSComFault := NOT LostLifeBit AND StatusWord0.%X2 AND HardWireSignals.ComError OR LostLifeBit AND HardWireSignals.ComError
  COIL StatusWord0.%X2 := PlantControl.Test[7]

NETWORK 3 "Optical Sorter Reset"
  COIL ControlWord0.%X7 := Inputs.FaultReset

NETWORK 4 "Optical Sorter Running Logic"
  COIL Outputs.OSRunning := NOT LostLifeBit AND StatusWord0.%X3 AND HardWireSignals.Running OR LostLifeBit AND HardWireSignals.Running

NETWORK 5 "Life Bit Logic And Monitoring"
  TON(LifeBitTimer, IN := NOT StatusWord0.%X10, PT := T#5S)
  COIL LostLifeBit := LifeBitTimer.Q OR LostLifeBit AND NOT Inputs.FaultReset

NETWORK 6 "Optical Sorter Start / Stop"
  COIL Outputs.TryRun := ((NOT Inputs.InHand OR Inputs.InHand AND NOT Inputs.HandIntervention) AND Inputs.AutoStartSignal OR Inputs.InHand AND Inputs.HandIntervention AND Inputs.HandStartSignal) AND NOT Inputs.InhibitMotor AND NOT Outputs.FTR AND NOT Outputs.FaultActive
  COIL ControlWord0.%X0 := (Outputs.TryRun{split 4} AND PreStartMemory{split 5} AND Inputs.RecentStart{split 6} OR Outputs.TryRun{recv 4} AND HardWireSignals.Run{split 7} OR Outputs.TryRun{recv 4} AND ControlWord0.%X0{split 8}){split 1} AND NOT Outputs.Stop{split 2} AND NOT Inputs.Shutdown{split 3}
  COIL HardWireSignals.Run := (Outputs.TryRun AND PreStartMemory AND Inputs.RecentStart{recv 6} OR Outputs.TryRun AND HardWireSignals.Run{recv 7} OR Outputs.TryRun AND ControlWord0.%X0{recv 8}) AND NOT Outputs.Stop AND NOT Inputs.Shutdown{recv 3}

NETWORK 7 "Hand Intervention Logic"
  COMMENT "Must Have Set Bit (#IO.HandIntervention)On Hand Control Buttons Press/Release On HMI"
  RCOIL Inputs.HandIntervention := NOT Inputs.InHand
  COIL Inputs.HandStartSignal := Inputs.InHand AND NOT Inputs.HandIntervention AND Outputs.FaultActive

NETWORK 8 "Start Signal After Inhibit/Fault"
  COMMENT "Must Have Set Bit (#IO.RecentStart)On Auto/Hand Start Buttons Press/Release On HMI"
  TON(GeneralDelayTimer, IN := ((NOT PreStartMemory OR NOT Inputs.RecentStart) AND Inputs.HandStartSignal OR Outputs.TryRun) AND Inputs.InHand AND NOT ControlWord0.%X0 AND NOT HardWireSignals.Run, PT := T#100MS)
  COIL Inputs.RecentStart := Inputs.RecentStart AND NOT ControlWord0.%X0 AND NOT HardWireSignals.Run AND NOT Outputs.FaultActive
  RCOIL Inputs.HandStartSignal := GeneralDelayTimer.Q

NETWORK 9 ""
  TON(InHandReqPreStart, IN := PreStartMemory AND NOT Inputs.PreStartDone AND Inputs.InHand, PT := T#30S)
  COIL HandPosEdge := Inputs.InHand{split 1} AND NOT RisingEdgeFlags[4]
  COIL RisingEdgeFlags[4] := Inputs.InHand{recv 1}
  COIL HandNegEdge := (Inputs.InHand{split 3} OR NegitiveSignalEdge[1]{split 4}){split 2} AND NOT Inputs.InHand
  COIL NegitiveSignalEdge[1] := (Inputs.InHand{recv 3} OR NegitiveSignalEdge[1]{recv 4}){recv 2} AND NOT HandNegEdge

NETWORK 10 "Prestart Hold On Until Shredder Run Signal"
  COIL PreStartMemory := Inputs.PreStartDone OR PreStartMemory AND NOT ControlWord0.%X0 AND NOT HardWireSignals.Run AND NOT InHandReqPreStart.Q AND NOT HandPosEdge AND NOT Outputs.FaultActive AND NOT HandNegEdge

NETWORK 11 "HMI Times"
  MUL(EN := TRUE, IN1 := Inputs.ShutdownTime, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := Inputs.EnableUPSTime, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := Inputs.FTTime, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := Inputs.Belt1OffDelay, IN2 := 1000.0) => Time
  CONVERT(EN := ENO, IN := Time) => ShutdownTimeMS
  CONVERT(EN := ENO, IN := Time) => EnableUPSTimeMS
  CONVERT(EN := ENO, IN := Time) => FTTimeMS
  CONVERT(EN := ENO, IN := Time) => Belt1OffDelayMS

NETWORK 12 "DOL Motor Shutdown"
  TON(ShutdownTimer, IN := Outputs.Stop, PT := ShutdownTimeMS)
  SCOIL Outputs.Stop := Inputs.Shutdown{split 1} AND NOT RisingEdgeFlags[1]
  COIL RisingEdgeFlags[1] := Inputs.Shutdown{recv 1}
  COIL Outputs.ShutdownComplete := ShutdownTimer.Q AND NOT Outputs.OSRunning
  RCOIL Outputs.Stop := Outputs.ShutdownComplete AND NOT Inputs.Shutdown

NETWORK 13 "Fail To Run"
  TON(FaultTripTimer, IN := ControlWord0.%X0 AND ControlWord0.%X1 AND NOT Outputs.OSRunning, PT := FTTimeMS)
  COIL Outputs.FTR := FaultTripTimer.Q OR Outputs.FTR AND NOT Inputs.FaultReset

NETWORK 14 "Fail To Stop"
  TON(FTSTimer, IN := NOT ControlWord0.%X0 AND Outputs.OSRunning, PT := FTTimeMS)
  COIL Outputs.FTS := FTSTimer.Q OR Outputs.FTS AND NOT Inputs.FaultReset

NETWORK 15 "Faults"
  COIL Outputs.FaultActive := Outputs.FTR OR Outputs.FTS OR LostLifeBit OR StatusWord0.%X2 OR StatusWord0.%X8 OR StatusWord0.%X9 OR StatusWord1.%X0 OR StatusWord1.%X1 OR StatusWord1.%X3 OR StatusWord5.%X2 OR StatusWord5.%X3 OR StatusWord5.%X8 OR StatusWord5.%X9 OR StatusWord5.%X10 OR Outputs.FaultActive AND NOT Inputs.FaultReset

NETWORK 16 "Motor Running, Enable Upstream Component"
  TON(EnableUpstreamTimer, IN := NOT Inputs.InHand AND StatusWord0.%X0 AND Outputs.OSRunning, PT := EnableUPSTimeMS)
  COIL Outputs.UPSEnable := EnableUpstreamTimer.Q AND Outputs.OSRunning

NETWORK 17 "Hours Run Counter"
  TONR(HrTotaliserTimer, IN := StatusWord0.%X0 AND Outputs.OSRunning, PT := T#1H, R := HrTotaliserTimerReset)
  COIL RisingEdgeFlags[2] := HrTotaliserTimer.Q{split 1}
  COIL HrTotaliserTimerReset := HrTotaliserTimer.Q{recv 1}
  MOVE(EN := HrTotaliserTimer.Q{recv 1} AND NOT RisingEdgeFlags[2]{split 2} AND Outputs.HrsRun = 4294967295, IN := 0) => Outputs.HrsRun
  ADD(EN := HrTotaliserTimer.Q AND NOT RisingEdgeFlags[2]{recv 2} AND Outputs.HrsRun < 4294967295, IN1 := 1, IN2 := Outputs.HrsRun) => Outputs.HrsRun

NETWORK 18 "HMI Motor Status Telemetry"
  MOVE(EN := NOT Outputs.FaultActive{split 1}, IN := 0) => Outputs.Telemetry
  MOVE(EN := NOT Outputs.FaultActive{recv 1} AND Outputs.OSRunning{split 2}, IN := 1) => Outputs.Telemetry
  MOVE(EN := (NOT Outputs.FaultActive AND Outputs.OSRunning{recv 2} AND NOT LostLifeBit{split 4} AND StatusWord0.%X3{split 5} AND HardWireSignals.Running{split 6} OR NOT Outputs.FaultActive AND Outputs.OSRunning{recv 2} AND LostLifeBit{split 7} AND HardWireSignals.Running{split 8}){split 3}, IN := 2) => Outputs.Telemetry
  MOVE(EN := (NOT Outputs.FaultActive AND Outputs.OSRunning AND NOT LostLifeBit AND StatusWord0.%X3 AND HardWireSignals.Running{recv 6} OR NOT Outputs.FaultActive AND Outputs.OSRunning AND LostLifeBit AND HardWireSignals.Running{recv 8}){recv 3} AND Outputs.UPSEnable OR (NOT Outputs.FaultActive AND Outputs.OSRunning AND NOT LostLifeBit AND StatusWord0.%X3 AND HardWireSignals.Running{recv 6} OR NOT Outputs.FaultActive AND Outputs.OSRunning AND LostLifeBit AND HardWireSignals.Running{recv 8}){recv 3} AND Inputs.InHand, IN := 3) => Outputs.Telemetry
  MOVE(EN := Outputs.FaultActive, IN := -1) => Outputs.Telemetry

NETWORK 19 "Alarms"
  COIL Outputs.Alarm0.%X0 := Outputs.FTR
  COIL Outputs.Alarm0.%X1 := Outputs.FTS
  COIL Outputs.Alarm0.%X2 := LostLifeBit
  COIL Outputs.Alarm0.%X3 := NOT StatusWord0.%X0
  COIL Outputs.Alarm0.%X4 := StatusWord0.%X1
  COIL Outputs.Alarm0.%X5 := StatusWord0.%X2
  COIL Outputs.Alarm0.%X6 := StatusWord0.%X6
  COIL Outputs.Alarm0.%X7 := StatusWord0.%X7
  COIL Outputs.Alarm0.%X8 := StatusWord0.%X8
  COIL Outputs.Alarm0.%X9 := StatusWord0.%X9
  COIL Outputs.Alarm0.%X10 := StatusWord0.%X11
  COIL Outputs.Alarm0.%X11 := StatusWord0.%X12
  COIL Outputs.Alarm0.%X12 := StatusWord0.%X13
  COIL Outputs.Alarm0.%X13 := StatusWord5.%X14
  COIL Outputs.Alarm0.%X14 := StatusWord5.%X15
  COIL Outputs.Alarm0.%X15 := StatusWord0.%X0
  COIL Outputs.Alarm1.%X0 := StatusWord0.%X1
  COIL Outputs.Alarm1.%X1 := StatusWord0.%X2
  COIL Outputs.Alarm1.%X2 := NOT StatusWord0.%X3
  COIL Outputs.Alarm1.%X3 := StatusWord0.%X4
  COIL Outputs.Alarm1.%X4 := StatusWord0.%X5
  COIL Outputs.Alarm1.%X5 := StatusWord2.%X0
  COIL Outputs.Alarm1.%X6 := StatusWord2.%X1
  COIL Outputs.Alarm1.%X7 := StatusWord2.%X2
  COIL Outputs.Alarm1.%X8 := StatusWord2.%X3
  COIL Outputs.Alarm1.%X9 := StatusWord2.%X4
  COIL Outputs.Alarm1.%X10 := StatusWord2.%X5
  COIL Outputs.Alarm1.%X11 := StatusWord2.%X6
  COIL Outputs.Alarm1.%X12 := StatusWord2.%X7
  COIL Outputs.Alarm1.%X13 := StatusWord5.%X2
  COIL Outputs.Alarm1.%X14 := StatusWord5.%X3
  COIL Outputs.Alarm1.%X15 := StatusWord5.%X8
  COIL Outputs.Alarm2.%X0 := StatusWord5.%X9
  COIL Outputs.Alarm2.%X1 := StatusWord5.%X10
  COIL Outputs.Alarm2.%X2 := NOT StatusWord5.%X12
  COIL Outputs.Alarm2.%X3 := StatusWord5.%X12
  COIL Outputs.Alarm2.%X4 := StatusWord5.%X13

NETWORK 20 ""
  MOVE(EN := NOT PlantControl.Test[5], IN := ControlWord0) => OutputWord0
  MOVE(EN := NOT PlantControl.Test[5], IN := ControlWord1) => OutputWord1
  SWAP(EN := PlantControl.Test[5], IN := ControlWord0) => OutputWord0
  SWAP(EN := PlantControl.Test[5], IN := ControlWord1) => OutputWord1

SIDECAR
NETWORK 1
  compileunit = 3
  access inputWord0 = 21 LocalVariable
  access StatusWord0 = 22 LocalVariable
  access inputWord1 = 23 LocalVariable
  access StatusWord1 = 24 LocalVariable
  access inputWord2 = 25 LocalVariable
  access StatusWord2 = 26 LocalVariable
  access inputWord3 = 27 LocalVariable
  access StatusWord3 = 28 LocalVariable
