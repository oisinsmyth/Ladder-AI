BLOCK FB MotorVSDSystem
ROOTID 0
NUMBER 42
LANGUAGE LAD
TITLE "VSD Motor"

INTERFACE
  INPUT
  OUTPUT
  STATIC
    IO : "MotorVSDIOSet" RETAIN SETPOINT
      InHand : Bool
      AutoStartSignal : Bool
      HandStartSignal : Bool
      RunningFwdFB : Bool
      RunningRevFB : Bool
      VSDError : Bool
      SystemHealthy : Bool
      PreStartDone : Bool
      InhibitMotor : Bool
      FaultReset : Bool
      FTTime : Real
      EnableUPSTime : Real
      FaultActive : Bool
      Run : Bool
      RunRev : Bool
      UPSEnable : Bool
      FTR : Bool
      FTS : Bool
      HrsRun : UDInt
      Telemetry : Int
      Alarm : Word
      Name : String
      HandIntervention : Bool
      TryRunMotor : Bool
      RecentStart : Bool
      ShutdownComplete : Bool
      ShutdownTime : Real
      Shutdown : Bool
      StopMotor : Bool
      VSDWarning : Bool
      HandSpeedInput : Real = 10.0
      AutoSpeedInput : Real = 10.0
      SpeedOutput : Int
      SpeedPerc : Real = 1.0
      SpeedFB : Int
      SpeedReached : Bool
      AmpsFB : Real
      OverTempFault : Bool
      ThermalOLFault : Bool
      TorqueLimitOk : Bool
      VSDReady : Bool
      VSDOpEnable : Bool
      VSDOverSpeed : Bool
      VSDUnderSpeed : Bool
      RotationSensor : Bool
      StartUpTime : Real = 5.0
      MaxRPM : Int = 1500
    RisingEdgeFlags : Array[0..4] of Bool
    NegitiveSignalEdge : Array[0..1] of Bool
    HrTotaliserTimerReset : Bool
    ShutdownTimeMS : DInt
    EnableUPSTimeMS : DInt
    FTTimeMS : DInt
    FaultTripTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    FTSTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    EnableUpstreamTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    ShutdownTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    InHandReqPreStart : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    HrTotaliserTimer : TONR_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    RecentStartSignal : TOF_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    GeneralDelayTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    PreStartMemory : Bool SETPOINT
    StartUpTimer : TON_TIME VERSION 1.0
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    StartUpTimeMS : DInt = 5000
    SpeedMem : Real
    RevPosEgde : Bool
    RevNegEge : Bool
    HandPosEdge : Bool
    HandNegEdge : Bool
  TEMP
    Time : Real
    TempDInt : DInt
    TempReal : Array[0..0] of Real
  CONSTANT
    PosSpeedError : Int = 50
    NegSpeedError : Int = -50
    MinSpd : Real = 20.0

NETWORK 1 "VSD Motor Start / Stop"
  COIL IO.TryRunMotor := ((NOT IO.InHand OR IO.InHand AND NOT IO.HandIntervention) AND IO.AutoStartSignal OR IO.InHand AND IO.HandIntervention AND IO.HandStartSignal) AND NOT IO.InhibitMotor AND NOT IO.FTR AND NOT IO.FaultActive AND IO.SystemHealthy
  COIL IO.Run := (IO.TryRunMotor{split 1} AND PreStartMemory AND IO.RecentStart OR IO.TryRunMotor{recv 1} AND IO.Run) AND NOT IO.StopMotor AND NOT IO.Shutdown

NETWORK 2 "Hand Intervention Logic"
  COMMENT "Must Have Set Bit (#IO.HandIntervention)On Hand Control Buttons Press/Release On HMI"
  RCOIL IO.HandIntervention := NOT IO.InHand
  RCOIL IO.HandStartSignal := NOT IO.InHand OR IO.FaultActive

NETWORK 3 "Start Signal After Inhibit/Fault"
  COMMENT "Must Have Set Bit (#IO.RecentStart)On Auto/Hand Start Buttons Press/Release On HMI"
  TON(GeneralDelayTimer, IN := (NOT IO.RecentStart OR NOT PreStartMemory) AND NOT IO.Run AND IO.HandStartSignal AND IO.InHand, PT := T#10S)
  COIL IO.RecentStart := IO.RecentStart AND NOT IO.Run AND PreStartMemory AND NOT IO.FaultActive
  RCOIL IO.HandStartSignal := GeneralDelayTimer.Q

NETWORK 4 ""
  TON(InHandReqPreStart, IN := PreStartMemory AND NOT IO.Run AND NOT IO.PreStartDone AND IO.InHand, PT := T#30S)
  COIL HandPosEdge := IO.InHand{split 1} AND NOT RisingEdgeFlags[4]
  COIL RisingEdgeFlags[4] := IO.InHand{recv 1}
  COIL HandNegEdge := (IO.InHand{split 3} OR NegitiveSignalEdge[1]{split 4}){split 2} AND NOT IO.InHand
  COIL NegitiveSignalEdge[1] := (IO.InHand{recv 3} OR NegitiveSignalEdge[1]{recv 4}){recv 2} AND NOT HandNegEdge

NETWORK 5 "Prestart Hold On Until Motor Run Signal"
  COIL PreStartMemory := IO.PreStartDone OR PreStartMemory AND NOT IO.FaultActive AND NOT IO.Run AND NOT InHandReqPreStart.Q AND NOT HandPosEdge AND NOT HandNegEdge

NETWORK 6 "Speed Reference"
  MOVE(EN := IO.AutoSpeedInput < MinSpd, IN := MinSpd) => IO.AutoSpeedInput
  MOVE(EN := IO.HandSpeedInput < MinSpd, IN := MinSpd) => IO.HandSpeedInput
  MOVE(EN := NOT IO.InHand{split 1}, IN := IO.AutoSpeedInput) => IO.SpeedPerc
  MOVE(EN := NOT IO.InHand{recv 1}, IN := IO.AutoSpeedInput) => IO.HandSpeedInput
  MOVE(EN := IO.InHand, IN := IO.HandSpeedInput) => IO.SpeedPerc
  CALL AnalogScale(EN := TRUE, Input := IO.SpeedPerc, Input_Min := 0.0, Input_Max := 100.0, Scaled_Min := 0.0, Scaled_Max := IO.MaxRPM, Output => IO.SpeedOutput)

NETWORK 7 "HMI Times"
  MUL(EN := TRUE, IN1 := IO.ShutdownTime, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := IO.EnableUPSTime, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := IO.FTTime, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := IO.StartUpTime, IN2 := 1000.0) => Time
  CONVERT(EN := ENO, IN := Time) => ShutdownTimeMS
  CONVERT(EN := ENO, IN := Time) => EnableUPSTimeMS
  CONVERT(EN := ENO, IN := Time) => FTTimeMS
  CONVERT(EN := ENO, IN := Time) => StartUpTimeMS

NETWORK 8 "DOL Motor Shutdown"
  TON(ShutdownTimer, IN := IO.StopMotor, PT := ShutdownTimeMS)
  SCOIL IO.StopMotor := IO.Shutdown{split 1} AND NOT RisingEdgeFlags[1]
  COIL RisingEdgeFlags[1] := IO.Shutdown{recv 1}
  COIL IO.ShutdownComplete := ShutdownTimer.Q AND NOT IO.RunningFwdFB AND NOT IO.RunningRevFB OR IO.ShutdownComplete AND NOT IO.Run OR IO.FaultActive
  RCOIL IO.StopMotor := IO.ShutdownComplete AND NOT IO.Shutdown

NETWORK 9 ""
  TON(StartUpTimer, IN := IO.Run AND IO.SpeedPerc = SpeedMem AND NOT RevNegEge AND NOT RevPosEgde, PT := StartUpTimeMS)
  SCOIL RevNegEge := (IO.RunRev{split 2} OR NegitiveSignalEdge[0]{split 3}){split 1} AND NOT IO.RunRev
  COIL NegitiveSignalEdge[0] := (IO.RunRev{recv 2} OR NegitiveSignalEdge[0]{recv 3}){recv 1} AND NOT RevNegEge
  SCOIL RevPosEgde := IO.RunRev{split 4} AND NOT RisingEdgeFlags[3]
  COIL RisingEdgeFlags[3] := IO.RunRev{recv 4}
  RCOIL RevPosEgde := TRUE
  RCOIL RevNegEge := TRUE
  MOVE(EN := TRUE, IN := IO.SpeedPerc) => SpeedMem

NETWORK 10 "Fail To Run"
  TON(FaultTripTimer, IN := StartUpTimer.Q AND NOT IO.RunningFwdFB AND NOT IO.RunningRevFB, PT := FTTimeMS)
  COIL IO.FTR := FaultTripTimer.Q OR IO.FTR AND NOT IO.FaultReset

NETWORK 11 "Fail To Stop"
  TON(FTSTimer, IN := NOT IO.Run AND NOT IO.RunRev AND IO.RunningFwdFB AND IO.RunningRevFB, PT := FTTimeMS)
  COIL IO.FTS := FTSTimer.Q OR IO.FTS AND NOT IO.FaultReset

NETWORK 12 "Faults"
  COIL IO.FaultActive := IO.FTR OR IO.FTS OR IO.VSDError OR IO.FaultActive AND NOT IO.FaultReset

NETWORK 13 "Motor Running, Enable Upstream Component"
  TON(EnableUpstreamTimer, IN := (NOT IO.InHand{split 3} OR NOT IO.HandIntervention{split 4}){split 1} AND IO.Run{split 2} AND IO.RunningFwdFB OR (NOT IO.InHand{recv 3} OR NOT IO.HandIntervention{recv 4}) AND IO.Run{recv 2} AND IO.RunningRevFB, PT := EnableUPSTimeMS)
  COIL IO.UPSEnable := EnableUpstreamTimer.Q

NETWORK 14 "Hours Run Counter"
  TONR(HrTotaliserTimer, IN := IO.Run AND IO.RunningFwdFB, PT := T#1H, R := HrTotaliserTimerReset)
  COIL RisingEdgeFlags[2] := HrTotaliserTimer.Q{split 1}
  COIL HrTotaliserTimerReset := HrTotaliserTimer.Q{recv 1}
  MOVE(EN := HrTotaliserTimer.Q{recv 1} AND NOT RisingEdgeFlags[2]{split 2} AND IO.HrsRun = 4294967295, IN := 0) => IO.HrsRun
  ADD(EN := HrTotaliserTimer.Q AND NOT RisingEdgeFlags[2]{recv 2} AND IO.HrsRun < 4294967295, IN1 := 1, IN2 := IO.HrsRun) => IO.HrsRun

NETWORK 15 "HMI Motor Status Telemetry"
  MOVE(EN := NOT IO.FaultActive{split 1}, IN := 0) => IO.Telemetry
  MOVE(EN := NOT IO.FaultActive{recv 1} AND IO.Run{split 2}, IN := 1) => IO.Telemetry
  MOVE(EN := (NOT IO.FaultActive AND IO.Run{recv 2} AND NOT IO.RunRev{split 4} AND IO.RunningFwdFB{split 5} OR NOT IO.FaultActive AND IO.Run{recv 2} AND NOT IO.RunRev{split 6} AND IO.RunningRevFB{split 7}){split 3}, IN := 2) => IO.Telemetry
  MOVE(EN := (NOT IO.FaultActive AND IO.Run AND NOT IO.RunRev AND IO.RunningFwdFB{recv 5} OR NOT IO.FaultActive AND IO.Run AND NOT IO.RunRev AND IO.RunningRevFB{recv 7}){recv 3} AND IO.UPSEnable OR (NOT IO.FaultActive AND IO.Run AND NOT IO.RunRev AND IO.RunningFwdFB{recv 5} OR NOT IO.FaultActive AND IO.Run AND NOT IO.RunRev AND IO.RunningRevFB{recv 7}){recv 3} AND IO.InHand, IN := 3) => IO.Telemetry
  MOVE(EN := IO.FaultActive, IN := -1) => IO.Telemetry

NETWORK 16 "Alarm"
  COIL IO.Alarm.%X0 := IO.FTR
  COIL IO.Alarm.%X1 := IO.FTS
  COIL IO.Alarm.%X2 := IO.VSDError

SIDECAR
