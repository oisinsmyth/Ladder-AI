      Run : Bool = FALSE
      UPSEnable : Bool = FALSE
      FTR : Bool = FALSE
      FTS : Bool = FALSE
      HrsRun : UDInt = 1
      Telemetry : Int = 0
      Alarm : Word = 16#0008
      Name : String = 'Dust Filter Unit 1'
      HandIntervention : Bool = FALSE
      RecentStart : Bool = TRUE
      TryRunMotor : Bool = FALSE
      Shutdown : Bool = FALSE
      ShutdownComplete : Bool = TRUE
      ShutdownTime : Real = 5.0
      StopMotor : Bool = FALSE
    RemoteOp : Bool SETPOINT
    RisingEdgeFlags : Array[0..3] of Bool
    NegitiveSignalEdge : Array[0..1] of Bool
    HrTotaliserTimerReset : Bool
    EnableUPSTimeMS : DInt
    ShutdownTimeMS : DInt
    FTTimeMS : DInt
    FaultTripTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    FTSTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
