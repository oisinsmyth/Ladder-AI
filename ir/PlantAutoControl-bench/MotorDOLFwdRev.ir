BLOCK FB MotorFwdRevSystem
ROOTID 0
NUMBER 7
LANGUAGE LAD

INTERFACE
  INPUT
  OUTPUT
  STATIC
    IO : "MotorFwdRevIOSet" RETAIN
      InHand : Bool
      AutoStartSignal : Bool
      HandStartSignal : Bool
      RunningFBFwd : Bool
      RunningFBRev : Bool
      FaultFB : Bool
      SystemHealthy : Bool
      PreStartDone : Bool
      InhibitMotor : Bool
      FaultReset : Bool
      FTTime : Real
      EnableUPSTime : Real
      FaultActive : Bool
      RunFwd : Bool
      RunRev : Bool
      UPSEnable : Bool
      FTR : Bool
      FTS : Bool
      HrsRun : UDInt
      Telemetry : Int
      Alarm : Word
      Name : String
      HandIntervention : Bool
      RecentStart : Bool
      TryRunMotor : Bool
      Shutdown : Bool
      ShutdownComplete : Bool
      ShutdownTime : Real
      StopMotor : Bool
      ReverseDelay : Real
      ReverseIgnoreFT : Real
      Reverse : Bool
      HandReverse : Bool
    RisingEdgeFlags : Array[0..3] of Bool
    NegitiveSignalEdge : Array[0..2] of Bool
    Pasue : Bool
    HrTotaliserTimerReset : Bool
    EnableUPSTimeMS : DInt
    ShutdownTimeMS : DInt
    FTTimeMS : DInt
    PauseTimeMS : DInt
    ReverseIgnoreFTTimeMS : DInt
    FaultTripTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    FTSTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    EnableUpstreamTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    ShutdownTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    GeneralDelayTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    InHandReqPreStart : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    CycleDelayReset : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    HrTotaliserTimer : TONR_TIME VERSION 1.0 RETAIN SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    ReversalPauseTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    ReversalIgnoreFTTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    PreStartMemory : Bool SETPOINT
    HandPosEdge : Bool
    HandNegEdge : Bool
    CycleDelay : Bool
  TEMP
    Time : Real
    StartTimer : Bool
  CONSTANT

NETWORK 1 "Reverse Pause and Control"
  TON(ReversalPauseTimer, IN := Pasue, PT := PauseTimeMS)
  TON(ReversalIgnoreFTTimer, IN := Pasue OR ReversalIgnoreFTTimer.IN AND NOT ReversalIgnoreFTTimer.Q, PT := ReverseIgnoreFTTimeMS)
  TON(CycleDelayReset, IN := CycleDelay, PT := T#300MS)
  SCOIL Pasue := IO.Reverse{split 1} AND NOT RisingEdgeFlags[0]{split 2}
  SCOIL StartTimer := IO.Reverse AND NOT RisingEdgeFlags[0]{recv 2}
  COIL RisingEdgeFlags[0] := IO.Reverse{recv 1}
  SCOIL Pasue := (IO.Reverse{split 5} OR NegitiveSignalEdge[0]{split 6}){split 3} AND NOT IO.Reverse{split 4}
  SCOIL StartTimer := (IO.Reverse{recv 5} OR NegitiveSignalEdge[0]{recv 6}) AND NOT IO.Reverse{recv 4}
  COIL NegitiveSignalEdge[0] := (IO.Reverse{recv 5} OR NegitiveSignalEdge[0]{recv 6}){recv 3} AND NOT Pasue OR (IO.Reverse{recv 5} OR NegitiveSignalEdge[0]{recv 6}){recv 3} AND NOT StartTimer
  RCOIL Pasue := ReversalPauseTimer.Q{split 7}
  SCOIL CycleDelay := ReversalPauseTimer.Q{recv 7}
  RCOIL Pasue := IO.FaultActive{split 8}
  RCOIL StartTimer := IO.FaultActive{recv 8}
  RCOIL CycleDelay := IO.RunFwd OR IO.RunRev
  RCOIL CycleDelay := CycleDelayReset.Q

NETWORK 2 "DOL Motor Start / Stop"
  COIL IO.TryRunMotor := ((NOT IO.InHand OR IO.InHand AND NOT IO.HandIntervention) AND IO.AutoStartSignal OR IO.InHand AND IO.HandIntervention AND IO.HandStartSignal) AND NOT IO.InhibitMotor AND NOT IO.FaultActive AND IO.SystemHealthy
  COIL IO.RunFwd := (IO.TryRunMotor{split 5} AND PreStartMemory{split 6} AND IO.RecentStart{split 7} OR IO.TryRunMotor{recv 5} AND IO.RunFwd{split 8} OR IO.TryRunMotor{recv 5} AND IO.RunRev{split 9} OR IO.TryRunMotor{recv 5} AND Pasue{split 10} OR IO.TryRunMotor{recv 5} AND CycleDelay{split 11}){split 1} AND NOT IO.StopMotor{split 2} AND NOT IO.Shutdown{split 3} AND NOT Pasue{split 4} AND NOT IO.Reverse
  COIL IO.RunRev := (IO.TryRunMotor AND PreStartMemory AND IO.RecentStart{recv 7} OR IO.TryRunMotor AND IO.RunFwd{recv 8} OR IO.TryRunMotor AND IO.RunRev{recv 9} OR IO.TryRunMotor AND Pasue{recv 10} OR IO.TryRunMotor AND CycleDelay{recv 11}) AND NOT IO.StopMotor AND NOT IO.Shutdown AND NOT Pasue{recv 4} AND IO.Reverse

NETWORK 3 "Hand Intervention Logic"
  COMMENT "Must Have Set Bit (#IO.HandIntervention)On Hand Control Buttons Press/Release On HMI"
  RCOIL IO.HandIntervention := NOT IO.InHand
  RCOIL IO.HandStartSignal := NOT IO.SystemHealthy OR IO.FaultActive OR NOT IO.InHand

NETWORK 4 "Start Signal After Inhibit/Fault"
  COMMENT "Must Have Set Bit (#IO.RecentStart)On Auto/Hand Start Buttons Press/Release On HMI"
  TON(GeneralDelayTimer, IN := (NOT IO.RecentStart OR NOT PreStartMemory) AND NOT IO.RunFwd AND NOT IO.RunRev AND NOT Pasue AND IO.HandStartSignal AND IO.InHand, PT := T#100MS)
  COIL IO.RecentStart := IO.RecentStart AND NOT IO.RunFwd AND NOT IO.RunRev AND NOT IO.FaultActive
  RCOIL IO.HandStartSignal := GeneralDelayTimer.Q

NETWORK 5 ""
  TON(InHandReqPreStart, IN := PreStartMemory AND NOT IO.PreStartDone AND IO.InHand, PT := T#30S)
  COIL HandPosEdge := IO.InHand{split 1} AND NOT RisingEdgeFlags[3]
  COIL RisingEdgeFlags[3] := IO.InHand{recv 1}
  COIL HandPosEdge := (IO.InHand{split 3} OR NegitiveSignalEdge[2]{split 4}){split 2} AND NOT IO.InHand
  COIL NegitiveSignalEdge[2] := (IO.InHand{recv 3} OR NegitiveSignalEdge[2]{recv 4}){recv 2} AND NOT HandPosEdge

NETWORK 6 "Prestart Hold On Until Motor Run Signal"
  COIL PreStartMemory := IO.PreStartDone OR PreStartMemory AND NOT IO.FaultActive AND NOT IO.RunFwd AND NOT IO.RunRev AND NOT InHandReqPreStart.Q AND NOT HandPosEdge AND NOT HandPosEdge

NETWORK 7 "HMI Times"
  MUL(EN := TRUE, IN1 := IO.ShutdownTime, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := IO.EnableUPSTime, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := IO.FTTime, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := IO.ReverseDelay, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := IO.ReverseIgnoreFT, IN2 := 1000.0) => Time
  CONVERT(EN := ENO, IN := Time) => ShutdownTimeMS
  CONVERT(EN := ENO, IN := Time) => EnableUPSTimeMS
  CONVERT(EN := ENO, IN := Time) => FTTimeMS
  CONVERT(EN := ENO, IN := Time) => PauseTimeMS
  CONVERT(EN := ENO, IN := Time) => ReverseIgnoreFTTimeMS

NETWORK 8 "DOL Motor Shutdown"
  TON(ShutdownTimer, IN := IO.StopMotor, PT := ShutdownTimeMS)
  SCOIL IO.StopMotor := IO.Shutdown{split 1} AND NOT RisingEdgeFlags[1]
  COIL RisingEdgeFlags[1] := IO.Shutdown{recv 1}
  COIL IO.ShutdownComplete := ShutdownTimer.Q AND NOT IO.RunningFBFwd AND NOT IO.RunningFBRev OR IO.ShutdownComplete AND NOT IO.RunFwd AND NOT IO.RunRev OR IO.InHand AND IO.HandIntervention AND NOT IO.HandStartSignal OR IO.FaultActive
  RCOIL IO.StopMotor := IO.ShutdownComplete AND NOT IO.Shutdown

NETWORK 9 "Fail To Run"
  TON(FaultTripTimer, IN := IO.RunFwd AND NOT IO.RunningFBFwd OR IO.RunRev AND NOT IO.RunningFBRev, PT := FTTimeMS)
  COIL IO.FTR := FaultTripTimer.Q AND NOT ReversalIgnoreFTTimer.IN AND NOT ReversalIgnoreFTTimer.Q OR IO.FTR AND NOT IO.FaultReset

NETWORK 10 "Fail To Stop"
  TON(FTSTimer, IN := NOT IO.RunFwd AND IO.RunningFBFwd OR NOT IO.RunRev AND IO.RunningFBRev, PT := FTTimeMS)
  COIL IO.FTS := FTSTimer.Q AND NOT ReversalIgnoreFTTimer.IN AND NOT ReversalIgnoreFTTimer.Q OR IO.FTS AND NOT IO.FaultReset

NETWORK 11 "Faults"
  COIL IO.FaultActive := IO.FTR OR IO.FTS OR IO.FaultFB OR IO.FaultActive AND NOT IO.FaultReset
  RCOIL IO.FaultFB := IO.FaultReset

NETWORK 12 "Motor Running, Enable Upstream Component"
  TON(EnableUpstreamTimer, IN := (NOT IO.InHand{split 2} OR NOT IO.HandIntervention{split 3}){split 1} AND IO.RunFwd AND IO.RunningFBFwd OR (NOT IO.InHand{recv 2} OR NOT IO.HandIntervention{recv 3}){recv 1} AND IO.RunRev AND IO.RunningFBRev OR (NOT IO.InHand{recv 2} OR NOT IO.HandIntervention{recv 3}){recv 1} AND ReversalIgnoreFTTimer.IN AND NOT ReversalIgnoreFTTimer.Q, PT := EnableUPSTimeMS)
  COIL IO.UPSEnable := EnableUpstreamTimer.Q

NETWORK 13 "Hours Run Counter"
  TONR(HrTotaliserTimer, IN := IO.RunFwd AND IO.RunningFBFwd OR IO.RunRev AND IO.RunningFBRev, PT := T#1H, R := HrTotaliserTimerReset)
  COIL RisingEdgeFlags[2] := HrTotaliserTimer.Q{split 1}
  COIL HrTotaliserTimerReset := HrTotaliserTimer.Q{recv 1}
  MOVE(EN := HrTotaliserTimer.Q{recv 1} AND NOT RisingEdgeFlags[2]{split 2} AND IO.HrsRun = 4294967295, IN := 0) => IO.HrsRun
  ADD(EN := HrTotaliserTimer.Q AND NOT RisingEdgeFlags[2]{recv 2} AND IO.HrsRun < 4294967295, IN1 := 1, IN2 := IO.HrsRun) => IO.HrsRun

NETWORK 14 "HMI Motor Status Telemetry"
  MOVE(EN := NOT IO.FaultActive{split 1}, IN := 0) => IO.Telemetry
  MOVE(EN := (NOT IO.FaultActive{recv 1} AND IO.RunFwd{split 3} OR NOT IO.FaultActive{recv 1} AND IO.RunRev{split 4}){split 2}, IN := 1) => IO.Telemetry
  MOVE(EN := ((NOT IO.FaultActive AND IO.RunFwd{recv 3} OR NOT IO.FaultActive AND IO.RunRev{recv 4}){recv 2} AND IO.RunningFBFwd{split 6} OR (NOT IO.FaultActive AND IO.RunFwd{recv 3} OR NOT IO.FaultActive AND IO.RunRev{recv 4}){recv 2} AND IO.RunningFBRev{split 7}){split 5}, IN := 2) => IO.Telemetry
  MOVE(EN := ((NOT IO.FaultActive AND IO.RunFwd{recv 3} OR NOT IO.FaultActive AND IO.RunRev{recv 4}) AND IO.RunningFBFwd{recv 6} OR (NOT IO.FaultActive AND IO.RunFwd{recv 3} OR NOT IO.FaultActive AND IO.RunRev{recv 4}) AND IO.RunningFBRev{recv 7}){recv 5} AND IO.UPSEnable OR ((NOT IO.FaultActive AND IO.RunFwd{recv 3} OR NOT IO.FaultActive AND IO.RunRev{recv 4}) AND IO.RunningFBFwd{recv 6} OR (NOT IO.FaultActive AND IO.RunFwd{recv 3} OR NOT IO.FaultActive AND IO.RunRev{recv 4}) AND IO.RunningFBRev{recv 7}){recv 5} AND IO.InHand, IN := 3) => IO.Telemetry
  MOVE(EN := IO.FaultActive, IN := -1) => IO.Telemetry

NETWORK 15 "Alarm"
  COIL IO.Alarm.%X0 := IO.FTR
  COIL IO.Alarm.%X1 := IO.FTS
  COIL IO.Alarm.%X2 := IO.FaultFB

SIDECAR
NETWORK 1
