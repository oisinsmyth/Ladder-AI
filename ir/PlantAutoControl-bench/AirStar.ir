BLOCK FB AirStarSystem
ROOTID 0
NUMBER 43
LANGUAGE LAD
TITLE "VSD Motor"

INTERFACE
  INPUT
  OUTPUT
  STATIC
    ComsInputs : Struct
      InRemote : Bool
      RemoteControlTerminals : Bool
      RemoteControlBus : Bool
      MachineRunning : Bool
      MachineFault : Bool
      InLifeBit : Bool
    Inputs : Struct RETAIN
      InHand : Bool
      AutoStartSignal : Bool
      HandStartSignal : Bool
      InhibitGeneral : Bool
      SystemHealthy : Bool
      HandIntervention : Bool
      PreStartDone : Bool
      Stop : Bool
      RecentStart : Bool
      ShutdownTime : Real
      EnableUPSTime : Real
      FTTime : Real
      ComsTimeOut : Real
      FaultReset : Bool
      Shutdown : Bool
      Program : Int
    Internal : Struct
      TryRun : Bool
      Run : Bool
    Outputs : Struct
      ShutdownComplete : Bool
      FTR : Bool
      FTS : Bool
      FaultActive : Bool
      ComsFault : Bool
      HrsRun : UDInt
      Telemetry : Int
      Alarm : Word
      EnableUPS : Bool
    ComsOutputs : Struct
      Reset : Bool
      OutLifebit : Bool
      Program1 : Bool
      Program2 : Bool
      Program3 : Bool
      Program4 : Bool
      Program5 : Bool
      Program6 : Bool
      Program7 : Bool
      Program8 : Bool
      Program9 : Bool
    RisingEdgeFlags : Array[0..8] of Bool
    NegitiveSignalEdge : Array[0..1] of Bool
    HrTotaliserTimerReset : Bool
    ShutdownTimeMS : DInt
    EnableUPSTimeMS : DInt
    FTTimeMS : DInt
    ComsTimeOutMS : DInt
    FaultTripTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    FTSTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    EnableUpstreamTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    ShutdownTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    ComsTimeoutTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    LifeBitOnTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    LifeBitOffTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    GeneralDelayTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    InHandReqPreStart : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    HrTotaliserTimer : TONR_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    RecentStartSignal : TOF_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    PulseResetTimer : TOF_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    PulseProgramTimer : TOF_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    PreStartMemory : Bool SETPOINT
    ComMemory : Bool
    ProgramMemory : Int RETAIN
    HandPosEdge : Bool
    HandNegEdge : Bool
  TEMP
    Time : Real
    TempReal : Array[0..0] of Real
  CONSTANT
    MaxRPM : Int = 3000
    PosSpeedError : Int = 50
    NegSpeedError : Int = -50
    PulseTimerMS : DInt = 1100

NETWORK 1 "Read Word 0"
  COIL ComsInputs.InRemote := AirStarWord0IN.%X0
  COIL ComsInputs.RemoteControlTerminals := AirStarWord0IN.%X1
  COIL ComsInputs.RemoteControlBus := AirStarWord0IN.%X2
  COIL ComsInputs.MachineRunning := AirStarWord0IN.%X8
  COIL ComsInputs.MachineFault := AirStarWord0IN.%X9 OR PlantControl.Test[7]

NETWORK 2 "Read Word 2"
  COIL ComsInputs.InLifeBit := AirStarWord2IN.%X8

NETWORK 3 "VSD Motor Start / Stop"
  COIL Internal.TryRun := ((NOT Inputs.InHand OR Inputs.InHand AND NOT Inputs.HandIntervention) AND Inputs.AutoStartSignal OR Inputs.InHand AND Inputs.HandIntervention AND Inputs.HandStartSignal) AND NOT Inputs.InhibitGeneral AND NOT Outputs.FaultActive AND Inputs.SystemHealthy
  COIL Internal.Run := (Internal.TryRun{split 1} AND PreStartMemory AND Inputs.RecentStart OR Internal.TryRun{recv 1} AND Internal.Run) AND NOT Inputs.Stop AND NOT Inputs.Shutdown AND ComsInputs.InRemote

NETWORK 4 "Hand Intervention Logic"
  COMMENT "Must Have Set Bit (#IO.HandIntervention)On Hand Control Buttons Press/Release On HMI"
  RCOIL Inputs.HandIntervention := NOT Inputs.InHand
  RCOIL Inputs.HandStartSignal := NOT Inputs.InHand OR NOT Inputs.HandIntervention OR Outputs.FaultActive OR Inputs.InhibitGeneral

NETWORK 5 "Start Signal After Inhibit/Fault"
  COMMENT "Must Have Set Bit (#IO.RecentStart)On Auto/Hand Start Buttons Press/Release On HMI"
  TON(GeneralDelayTimer, IN := ((NOT PreStartMemory OR NOT Inputs.RecentStart) AND Inputs.HandStartSignal OR Internal.TryRun) AND Inputs.InHand AND NOT Internal.Run, PT := T#100MS)
  COIL Inputs.RecentStart := Inputs.RecentStart AND NOT Internal.Run AND PreStartMemory AND NOT Outputs.FaultActive
  RCOIL Inputs.HandStartSignal := GeneralDelayTimer.Q

NETWORK 6 ""
  TON(InHandReqPreStart, IN := PreStartMemory AND NOT Inputs.PreStartDone AND Inputs.InHand, PT := T#30S)
  COIL HandPosEdge := Inputs.InHand{split 1} AND NOT RisingEdgeFlags[8]
  COIL RisingEdgeFlags[8] := Inputs.InHand{recv 1}
  COIL HandNegEdge := (Inputs.InHand{split 3} OR NegitiveSignalEdge[1]{split 4}){split 2} AND NOT Inputs.InHand
  COIL NegitiveSignalEdge[1] := (Inputs.InHand{recv 3} OR NegitiveSignalEdge[1]{recv 4}){recv 2} AND NOT HandNegEdge

NETWORK 7 "Prestart Hold On Until Motor Run Signal"
  COIL PreStartMemory := Inputs.PreStartDone OR PreStartMemory AND NOT Internal.Run AND NOT InHandReqPreStart.Q AND NOT HandPosEdge AND NOT Outputs.FaultActive AND NOT HandNegEdge

NETWORK 8 "HMI Times"
  MUL(EN := TRUE, IN1 := Inputs.ShutdownTime, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := Inputs.EnableUPSTime, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := Inputs.FTTime, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := Inputs.ComsTimeOut, IN2 := 1000.0) => Time
  CONVERT(EN := ENO, IN := Time) => ShutdownTimeMS
  CONVERT(EN := ENO, IN := Time) => EnableUPSTimeMS
  CONVERT(EN := ENO, IN := Time) => FTTimeMS
  CONVERT(EN := ENO, IN := Time) => ComsTimeOutMS

NETWORK 9 "General Shutdown"
  TON(ShutdownTimer, IN := Inputs.Stop, PT := ShutdownTimeMS)
  SCOIL Inputs.Stop := Inputs.Shutdown{split 1} AND NOT RisingEdgeFlags[1]
  COIL RisingEdgeFlags[1] := Inputs.Shutdown{recv 1}
  COIL Outputs.ShutdownComplete := ShutdownTimer.Q AND NOT ComsInputs.MachineRunning OR Outputs.ShutdownComplete AND NOT Internal.Run OR Inputs.InHand AND Inputs.HandIntervention AND NOT Inputs.HandStartSignal OR Outputs.FaultActive
  RCOIL Inputs.Stop := Outputs.ShutdownComplete AND NOT Inputs.Shutdown

NETWORK 10 "Fail To Run"
  TON(FaultTripTimer, IN := Internal.Run AND NOT ComsInputs.MachineRunning, PT := FTTimeMS)
  COIL Outputs.FTR := FaultTripTimer.Q OR Outputs.FTR AND NOT Inputs.FaultReset

NETWORK 11 "Fail To Stop"
  TON(FTSTimer, IN := Internal.Run AND NOT ComsInputs.MachineRunning, PT := FTTimeMS)
  COIL Outputs.FTS := FTSTimer.Q OR Outputs.FTS AND NOT Inputs.FaultReset

NETWORK 12 "Faults"
  COIL Outputs.FaultActive := Outputs.FTR OR Outputs.FTS OR ComsInputs.MachineFault OR Outputs.ComsFault OR Outputs.FaultActive AND NOT Inputs.FaultReset

NETWORK 13 "Motor Running, Enable Upstream Component"
  TON(EnableUpstreamTimer, IN := (NOT Inputs.InHand OR NOT Inputs.HandIntervention) AND Internal.Run AND ComsInputs.MachineRunning, PT := EnableUPSTimeMS)
  COIL Outputs.EnableUPS := EnableUpstreamTimer.Q

NETWORK 14 "Hours Run Counter"
  TONR(HrTotaliserTimer, IN := Internal.Run AND ComsInputs.MachineRunning, PT := T#1H, R := HrTotaliserTimerReset)
  COIL RisingEdgeFlags[2] := HrTotaliserTimer.Q{split 1}
  COIL HrTotaliserTimerReset := HrTotaliserTimer.Q{recv 1}
  MOVE(EN := HrTotaliserTimer.Q{recv 1} AND NOT RisingEdgeFlags[2]{split 2} AND Outputs.HrsRun = 4294967295, IN := 0) => Outputs.HrsRun
  ADD(EN := HrTotaliserTimer.Q AND NOT RisingEdgeFlags[2]{recv 2} AND Outputs.HrsRun < 4294967295, IN1 := 1, IN2 := Outputs.HrsRun) => Outputs.HrsRun

NETWORK 15 "HMI Motor Status Telemetry"
  MOVE(EN := NOT Outputs.FaultActive{split 1}, IN := 0) => Outputs.Telemetry
  MOVE(EN := NOT Outputs.FaultActive{recv 1} AND Internal.Run{split 2}, IN := 1) => Outputs.Telemetry
  MOVE(EN := NOT Outputs.FaultActive AND Internal.Run{recv 2} AND ComsInputs.MachineRunning{split 3}, IN := 2) => Outputs.Telemetry
  MOVE(EN := NOT Outputs.FaultActive AND Internal.Run AND ComsInputs.MachineRunning{recv 3} AND Outputs.EnableUPS OR NOT Outputs.FaultActive AND Internal.Run AND ComsInputs.MachineRunning{recv 3} AND Inputs.InHand, IN := 3) => Outputs.Telemetry
  MOVE(EN := Outputs.FaultActive, IN := -1) => Outputs.Telemetry

NETWORK 16 "Coms Fault Monitoring"
  TON(LifeBitOnTimer, IN := (FirstScan{split 2} OR LifeBitOffTimer.Q{split 3} OR LifeBitOnTimer.IN{split 4} AND NOT LifeBitOffTimer.IN{split 5}){split 1}, PT := T#1S)
  TON(LifeBitOffTimer, IN := LifeBitOnTimer.Q OR LifeBitOffTimer.IN AND NOT LifeBitOnTimer.IN, PT := T#1S)
  TON(ComsTimeoutTimer, IN := NOT ComMemory, PT := ComsTimeOutMS)
  COIL ComsOutputs.OutLifebit := (FirstScan{recv 2} OR LifeBitOffTimer.Q{recv 3} OR LifeBitOnTimer.IN AND NOT LifeBitOffTimer.IN{recv 5}){recv 1} AND NOT LifeBitOffTimer.IN
  SCOIL ComMemory := ComsInputs.InLifeBit{split 6} AND NOT RisingEdgeFlags[4]
  COIL RisingEdgeFlags[4] := ComsInputs.InLifeBit{recv 6}
  RCOIL ComMemory := NOT ComsInputs.InLifeBit{split 7} AND NOT RisingEdgeFlags[5]
  COIL RisingEdgeFlags[5] := NOT ComsInputs.InLifeBit{recv 7}
  COIL Outputs.ComsFault := ComsTimeoutTimer.Q

NETWORK 17 "Alarm"
  COIL Outputs.Alarm.%X0 := Outputs.FTR
  COIL Outputs.Alarm.%X1 := Outputs.FTS
  COIL Outputs.Alarm.%X2 := ComsInputs.MachineFault
  COIL Outputs.Alarm.%X3 := Outputs.ComsFault
  COIL Outputs.Alarm.%X4 := NOT ComsInputs.InRemote

NETWORK 18 "Reset Fault Signal Pulse"
  TON(PulseResetTimer, IN := (Inputs.FaultReset{split 2} OR PulseResetTimer.IN{split 3} AND NOT PulseResetTimer.Q{split 4}){split 1}, PT := PulseTimerMS)
  COIL ComsOutputs.Reset := (Inputs.FaultReset{recv 2} OR PulseResetTimer.IN AND NOT PulseResetTimer.Q{recv 4}){recv 1}

NETWORK 19 "Program Pulse Outputs"
  TOF(PulseProgramTimer, IN := (Inputs.Program <> ProgramMemory){split 1}, PT := PulseTimerMS)
  COIL ComsOutputs.Program1 := PulseProgramTimer.Q{split 2} AND ProgramMemory = 1
  COIL ComsOutputs.Program2 := PulseProgramTimer.Q{recv 2} AND ProgramMemory = 2
  COIL ComsOutputs.Program3 := PulseProgramTimer.Q{recv 2} AND ProgramMemory = 3
  COIL ComsOutputs.Program4 := PulseProgramTimer.Q{recv 2} AND ProgramMemory = 4
  COIL ComsOutputs.Program5 := PulseProgramTimer.Q{recv 2} AND ProgramMemory = 5
  COIL ComsOutputs.Program6 := PulseProgramTimer.Q{recv 2} AND ProgramMemory = 6
  COIL ComsOutputs.Program7 := PulseProgramTimer.Q{recv 2} AND ProgramMemory = 7
  COIL ComsOutputs.Program8 := PulseProgramTimer.Q{recv 2} AND ProgramMemory = 8
  COIL ComsOutputs.Program9 := PulseProgramTimer.Q{recv 2} AND ProgramMemory = 9
  MOVE(EN := (Inputs.Program <> ProgramMemory){recv 1}, IN := Inputs.Program) => ProgramMemory

NETWORK 20 "Write Word 0"
  COIL AirStarWord0OUT.%X0 := Internal.Run
  COIL AirStarWord0OUT.%X2 := ComsOutputs.Reset
  COIL AirStarWord0OUT.%X15 := ComsOutputs.OutLifebit

NETWORK 21 "Write Word 2"
  COIL AirStarWord2OUT.%X0 := ComsOutputs.Program1
  COIL AirStarWord2OUT.%X1 := ComsOutputs.Program2
  COIL AirStarWord2OUT.%X2 := ComsOutputs.Program3
  COIL AirStarWord2OUT.%X3 := ComsOutputs.Program4
  COIL AirStarWord2OUT.%X4 := ComsOutputs.Program5
  COIL AirStarWord2OUT.%X5 := ComsOutputs.Program6
  COIL AirStarWord2OUT.%X6 := ComsOutputs.Program7
  COIL AirStarWord2OUT.%X7 := ComsOutputs.Program8
  COIL AirStarWord2OUT.%X8 := ComsOutputs.Program9

SIDECAR
NETWORK 1
  compileunit = 3
  access AirStarWord0IN.%X0 = 21 GlobalVariable
  access ComsInputs.InRemote = 22 LocalVariable
  access AirStarWord0IN.%X1 = 23 GlobalVariable
  access ComsInputs.RemoteControlTerminals = 24 LocalVariable
  access AirStarWord0IN.%X2 = 25 GlobalVariable
  access ComsInputs.RemoteControlBus = 26 LocalVariable
  access AirStarWord0IN.%X8 = 27 GlobalVariable
  access ComsInputs.MachineRunning = 28 LocalVariable
  access AirStarWord0IN.%X9 = 29 GlobalVariable
  access PlantControl.Test[7] = 30 GlobalVariable
  access ComsInputs.MachineFault = 31 LocalVariable
