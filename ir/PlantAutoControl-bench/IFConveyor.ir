DB MotorVSDInst2
  ROOTID 0
  NUMBER 5
  INSTANCEOF MotorVSDSystem
  INPUT
  OUTPUT
  MEMBERS
    IO : "MotorVSDIOSet" RETAIN SETPOINT
      InHand : Bool = FALSE
      AutoStartSignal : Bool = FALSE
      HandStartSignal : Bool = FALSE
      RunningFwdFB : Bool = FALSE
      RunningRevFB : Bool = FALSE
      VSDError : Bool = FALSE
      SystemHealthy : Bool = TRUE
      PreStartDone : Bool = FALSE
      InhibitMotor : Bool = FALSE
      FaultReset : Bool = FALSE
      FTTime : Real = 3.0
      EnableUPSTime : Real = 2.0
      FaultActive : Bool = FALSE
      Run : Bool = FALSE
      RunRev : Bool = FALSE
      UPSEnable : Bool = FALSE
      FTR : Bool = FALSE
      FTS : Bool = FALSE
      HrsRun : UDInt = 6
      Telemetry : Int = 0
      Alarm : Word = 16#0000
      Name : String = 'Infeed Conveyor VSD Unit'
      HandIntervention : Bool = FALSE
      TryRunMotor : Bool = FALSE
      RecentStart : Bool = TRUE
      ShutdownComplete : Bool = TRUE
      ShutdownTime : Real = 20.0
      Shutdown : Bool = FALSE
      StopMotor : Bool = FALSE
      VSDWarning : Bool = TRUE
      HandSpeedInput : Real = 30.0
      AutoSpeedInput : Real = 50.0
      SpeedOutput : Int = 750
      SpeedPerc : Real = 50.0
      SpeedFB : Int = 0
      SpeedReached : Bool = FALSE
      AmpsFB : Real = 0.01
      OverTempFault : Bool = TRUE
      ThermalOLFault : Bool = TRUE
      TorqueLimitOk : Bool = FALSE
      VSDReady : Bool = FALSE
      VSDOpEnable : Bool = FALSE
      VSDOverSpeed : Bool = FALSE
      VSDUnderSpeed : Bool = FALSE
      RotationSensor : Bool = FALSE
      StartUpTime : Real = 8.0
      MaxRPM : Int = 1500
    RisingEdgeFlags : Array[0..4] of Bool
    NegitiveSignalEdge : Array[0..1] of Bool
    HrTotaliserTimerReset : Bool
    ShutdownTimeMS : DInt
    EnableUPSTimeMS : DInt
    FTTimeMS : DInt
    FaultTripTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    FTSTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    EnableUpstreamTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    ShutdownTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    InHandReqPreStart : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    HrTotaliserTimer : TONR_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    RecentStartSignal : TOF_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    GeneralDelayTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    PreStartMemory : Bool SETPOINT = FALSE
    StartUpTimer : TON_TIME VERSION 1.0
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    StartUpTimeMS : DInt
    SpeedMem : Real
    RevPosEgde : Bool
    RevNegEge : Bool
    HandPosEdge : Bool
    HandNegEdge : Bool
