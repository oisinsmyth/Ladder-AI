BLOCK FB EquipmentControlSystem
ROOTID 0
NUMBER 1
LANGUAGE LAD

INTERFACE
  INPUT
  OUTPUT
  STATIC
    Inputs : Struct RETAIN
      InHand : Bool
      AutoStartSignal : Bool
      HandStartSignal : Bool
      RunningFB : Bool
      PreStartDone : Bool
      InhibitMotor : Bool
      FaultReset : Bool
      FTTime : Real
      EnableUPSTime : Real
      HandIntervention : Bool
      RecentStart : Bool
      Shutdown : Bool
      ShutdownTime : Real
      ReadyFB : Bool
      MSHandMode : Bool
      MSAutoMode : Bool
      MSSettingMode : Bool
      SumFlt : Bool
      FCRotorFault : Bool
      FltRotorRevs : Bool
      FCConveyorBeltFlt : Bool
      InterlockingFeeder : Bool
      MaterialChargeEnabled : Bool
    Outputs : Struct
      ECSRun : Bool
      ECSReset : Bool
      FTR : Bool
      FTS : Bool
      HrsRun : UDInt
      Telemetry : Int
      Alarm : Word
      Name : String
      UPSEnable : Bool
      TryRun : Bool
      ShutdownComplete : Bool
      FaultActive : Bool
      Stop : Bool
    ShutdownTimeMS : DInt
    EnableUPSTimeMS : DInt
    FTTimeMS : DInt
    RisingEdgeFlags : Array[0..7] of Bool
    NegitiveSignalEdge : Array[0..1] of Bool
    FaultTripTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    FTSTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    EnableUpstreamTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    ShutdownTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    GeneralDelayTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    HrTotaliserTimer : TONR_TIME VERSION 1.0 RETAIN SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    RecentStartSignal : TOF_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    HrTotaliserTimerReset : Bool SETPOINT
    PreStartMemory : Bool
    HandPosEdge : Bool
    HandNegEdge : Bool
    InHandReqPreStart : TONR_TIME VERSION 1.0
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
  TEMP
    Time : Real
  CONSTANT

NETWORK 1 "DOL Motor Start / Stop"
  COIL Outputs.TryRun := ((NOT Inputs.InHand OR Inputs.InHand AND NOT Inputs.HandIntervention) AND Inputs.AutoStartSignal OR Inputs.InHand AND Inputs.HandIntervention AND Inputs.HandStartSignal) AND NOT Inputs.InhibitMotor AND NOT Outputs.FTR AND NOT Outputs.FaultActive AND NOT Inputs.MSHandMode AND NOT Inputs.MSSettingMode AND Inputs.MSAutoMode
  COIL Outputs.ECSRun := (Outputs.TryRun{split 1} AND PreStartMemory AND Inputs.RecentStart OR Outputs.TryRun{recv 1} AND Outputs.ECSRun) AND NOT Outputs.Stop AND NOT Inputs.Shutdown

NETWORK 2 "Hand Intervention Logic"
  COMMENT "Must Have Set Bit (#IO.HandIntervention)On Hand Control Buttons Press/Release On HMI"
  RCOIL Inputs.HandIntervention := NOT Inputs.InHand
  RCOIL Inputs.HandStartSignal := NOT Inputs.InHand OR NOT Inputs.HandIntervention OR Outputs.FaultActive

NETWORK 3 "Start Signal After Inhibit/Fault"
  COMMENT "Must Have Set Bit (#IO.RecentStart)On Auto/Hand Start Buttons Press/Release On HMI"
  TON(GeneralDelayTimer, IN := (NOT PreStartMemory OR NOT Inputs.RecentStart OR Outputs.TryRun) AND Inputs.HandStartSignal AND Inputs.InHand AND NOT Outputs.ECSRun, PT := T#100MS)
  COIL Inputs.RecentStart := Inputs.RecentStart AND NOT Outputs.ECSRun AND PreStartMemory AND NOT Outputs.FaultActive
  RCOIL Inputs.HandStartSignal := GeneralDelayTimer.Q

NETWORK 4 ""
  TON(InHandReqPreStart, IN := PreStartMemory AND NOT Inputs.PreStartDone AND Inputs.InHand, PT := T#30S)
  COIL HandPosEdge := Inputs.InHand{split 1} AND NOT RisingEdgeFlags[3]
  COIL RisingEdgeFlags[3] := Inputs.InHand{recv 1}
  COIL HandNegEdge := (Inputs.InHand{split 3} OR NegitiveSignalEdge[1]{split 4}){split 2} AND NOT Inputs.InHand
  COIL NegitiveSignalEdge[1] := (Inputs.InHand{recv 3} OR NegitiveSignalEdge[1]{recv 4}){recv 2} AND NOT HandNegEdge

NETWORK 5 "Prestart Hold On Until ECS Run Signal"
  COIL PreStartMemory := Inputs.PreStartDone OR PreStartMemory AND NOT Outputs.FaultActive AND NOT Outputs.ECSRun AND NOT InHandReqPreStart.Q AND NOT HandPosEdge AND NOT HandNegEdge

NETWORK 6 "HMI Times"
  MUL(EN := TRUE, IN1 := Inputs.ShutdownTime, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := Inputs.EnableUPSTime, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := Inputs.FTTime, IN2 := 1000.0) => Time
  CONVERT(EN := ENO, IN := Time) => ShutdownTimeMS
  CONVERT(EN := ENO, IN := Time) => EnableUPSTimeMS
  CONVERT(EN := ENO, IN := Time) => FTTimeMS

NETWORK 7 "DOL Motor Shutdown"
  TON(ShutdownTimer, IN := Outputs.Stop, PT := ShutdownTimeMS)
  SCOIL Outputs.Stop := Inputs.Shutdown{split 1} AND NOT RisingEdgeFlags[1]
  COIL RisingEdgeFlags[1] := Inputs.Shutdown{recv 1}
  COIL Outputs.ShutdownComplete := ShutdownTimer.Q AND NOT Inputs.RunningFB OR Outputs.ShutdownComplete AND NOT Outputs.ECSRun OR Inputs.InHand AND Inputs.HandIntervention AND NOT Inputs.HandStartSignal OR Outputs.FaultActive
  RCOIL Outputs.Stop := Outputs.ShutdownComplete AND NOT Inputs.Shutdown

NETWORK 8 "Fail To Run"
  TON(FaultTripTimer, IN := Outputs.ECSRun AND NOT Inputs.RunningFB, PT := FTTimeMS)
  COIL Outputs.FTR := FaultTripTimer.Q OR Outputs.FTR AND NOT Inputs.FaultReset

NETWORK 9 "Fail To Stop"
  TON(FTSTimer, IN := NOT Outputs.ECSRun AND Inputs.RunningFB, PT := FTTimeMS)
  COIL Outputs.FTS := FTSTimer.Q OR Outputs.FTS AND NOT Inputs.FaultReset

NETWORK 10 "Faults"
  COIL Outputs.FaultActive := Outputs.FTR OR Outputs.FTS OR Inputs.SumFlt OR Inputs.FCRotorFault OR Inputs.FltRotorRevs OR Inputs.FCConveyorBeltFlt OR Outputs.FaultActive AND NOT Inputs.FaultReset

NETWORK 11 "Motor Running, Enable Upstream Component"
  TON(EnableUpstreamTimer, IN := (NOT Inputs.InHand OR NOT Inputs.HandIntervention) AND Outputs.ECSRun AND Inputs.RunningFB AND Inputs.MaterialChargeEnabled, PT := EnableUPSTimeMS)
  COIL Outputs.UPSEnable := EnableUpstreamTimer.Q

NETWORK 12 "Hours Run Counter"
  TONR(HrTotaliserTimer, IN := Outputs.ECSRun AND Inputs.RunningFB, PT := T#1H, R := HrTotaliserTimerReset)
  COIL RisingEdgeFlags[2] := HrTotaliserTimer.Q{split 1}
  COIL HrTotaliserTimerReset := HrTotaliserTimer.Q{recv 1}
  MOVE(EN := HrTotaliserTimer.Q{recv 1} AND NOT RisingEdgeFlags[2]{split 2} AND Outputs.HrsRun = 4294967295, IN := 0) => Outputs.HrsRun
  ADD(EN := HrTotaliserTimer.Q AND NOT RisingEdgeFlags[2]{recv 2} AND Outputs.HrsRun < 4294967295, IN1 := 1, IN2 := Outputs.HrsRun) => Outputs.HrsRun

NETWORK 13 "HMI Motor Status Telemetry"
  MOVE(EN := NOT Outputs.FaultActive{split 1}, IN := 0) => Outputs.Telemetry
  MOVE(EN := NOT Outputs.FaultActive{recv 1} AND Outputs.ECSRun{split 2}, IN := 1) => Outputs.Telemetry
  MOVE(EN := NOT Outputs.FaultActive AND Outputs.ECSRun{recv 2} AND Inputs.RunningFB{split 3}, IN := 2) => Outputs.Telemetry
  MOVE(EN := NOT Outputs.FaultActive AND Outputs.ECSRun AND Inputs.RunningFB{recv 3} AND Outputs.UPSEnable OR NOT Outputs.FaultActive AND Outputs.ECSRun AND Inputs.RunningFB{recv 3} AND Inputs.InHand, IN := 3) => Outputs.Telemetry
  MOVE(EN := Outputs.FaultActive, IN := -1) => Outputs.Telemetry

NETWORK 14 "Alarm"
  COIL Outputs.Alarm.%X0 := Outputs.FTR
  COIL Outputs.Alarm.%X1 := Outputs.FTS
  COIL Outputs.Alarm.%X2 := Inputs.FCRotorFault
  COIL Outputs.Alarm.%X3 := Inputs.FltRotorRevs
  COIL Outputs.Alarm.%X4 := Inputs.FCConveyorBeltFlt
  COIL Outputs.Alarm.%X5 := Inputs.MSHandMode
  COIL Outputs.Alarm.%X6 := Inputs.MSSettingMode
  COIL Outputs.Alarm.%X7 := NOT Inputs.MSAutoMode
  COIL Outputs.Alarm.%X8 := NOT Inputs.ReadyFB
  COIL Outputs.Alarm.%X9 := Inputs.SumFlt

SIDECAR
