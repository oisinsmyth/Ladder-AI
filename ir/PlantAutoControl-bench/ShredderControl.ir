BLOCK FB ShredderControlSystem
ROOTID 0
NUMBER 6
LANGUAGE LAD

INTERFACE
  INPUT
  OUTPUT
  STATIC
    Inputs : Struct RETAIN
      InHand : Bool
      AutoStartSignal : Bool
      HandStartSignal : Bool
      PreStartDone : Bool
      InhibitMotor : Bool
      FaultReset : Bool
      FTTime : Real
      EnableUPSTime : Real
      HandIntervention : Bool
      RecentStart : Bool
      Shutdown : Bool
      ShutdownTime : Real
      ProgramSelection : Int
    Outputs : Struct
      FTR : Bool
      FTS : Bool
      HrsRun : UDInt
      Telemetry : Int
      Alarm : Word
      Name : String
      UPSEnable : Bool
      TryRun : Bool
      ShutdownComplete : Bool
      FaultActive : Bool
      Stop : Bool
      ShredderRunning : Bool
      Run : Bool
    ComsOutByte500 : Struct
      LifeBit : Bool
      ResetOverload : Bool
      StopAuto : Bool
      HoldAuto : Bool
      StartAuto : Bool
    ComsOutByte501 : Struct
      Program1 : Bool
      Program2 : Bool
      Program3 : Bool
      Program4 : Bool
      Program5 : Bool
      Program6 : Bool
      ComsOutByte1 : Struct
        Program1 : Bool
        Program2 : Bool
        Program3 : Bool
        Program4 : Bool
        Program5 : Bool
        Program6 : Bool
      ComsOutByte2 : Struct
        Program1 : Bool
        Program2 : Bool
        Program3 : Bool
        Program4 : Bool
        Program5 : Bool
        Program6 : Bool
      ComsOutByte3 : Struct
        Program1 : Bool
        Program2 : Bool
        Program3 : Bool
        Program4 : Bool
        Program5 : Bool
        Program6 : Bool
      ComsOutByte4 : Struct
        Program1 : Bool
        Program2 : Bool
        Program3 : Bool
        Program4 : Bool
        Program5 : Bool
        Program6 : Bool
        ComsOutByte1 : Struct
          Program1 : Bool
          Program2 : Bool
          Program3 : Bool
          Program4 : Bool
          Program5 : Bool
          Program6 : Bool
        ComsOutByte2 : Struct
          Program1 : Bool
          Program2 : Bool
          Program3 : Bool
          Program4 : Bool
          Program5 : Bool
          Program6 : Bool
        ComsOutByte3 : Struct
          Program1 : Bool
          Program2 : Bool
          Program3 : Bool
          Program4 : Bool
          Program5 : Bool
          Program6 : Bool
    ComsOutByte502 : Struct
      Release4Op : Bool
      StartHorn : Bool
      RadioControlPermit : Bool
    ComsInByte500 : Struct
      Ready : Bool
      RotorOn : Bool
      RotorStandby : Bool
      ReleaseFeeding : Bool
      ProgramP1 : Bool
      ProgramP2 : Bool
    ComsInByte501 : Struct
      ProgramP3 : Bool
      ProgramP4 : Bool
      ProgramP5 : Bool
      ProgramP6 : Bool
      FlashBit : Bool
      LifeBitMirror : Bool
      LocalMode : Bool
      MaintenanceOn : Bool
    ComsInByte502 : Struct
      BypassActive : Bool
      CuttingUnitRemote : Bool
      TouchPanelShredder : Bool
      TouchPanelMainCabnet : Bool
      RadioModeOn : Bool
      Drive1Ready : Bool
      Drive2Ready : Bool
    ComsInByte503 : Struct
      OilCoolerRunning : Bool
      AutoModeOn : Bool
      ServiceModeOn : Bool
      Selector1Local : Bool
      Selector1Remote : Bool
    ComsInWord508 : Word
    ComsInWord528 : Word
    ComsInWord532 : Word
    ActualSpeed : Int
    MotorAmps1 : Int
    MotorAmps2 : Int
    ShutdownTimeMS : DInt
    EnableUPSTimeMS : DInt
    FTTimeMS : DInt
    RisingEdgeFlags : Array[0..7] of Bool
    NegitiveSignalEdge : Array[0..7] of Bool
    FaultTripTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    FTSTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    EnableUpstreamTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    ShutdownTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    GeneralDelayTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    InHandReqPreStart : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    HrTotaliserTimer : TONR_TIME VERSION 1.0 RETAIN SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    RecentStartSignal : TOF_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    LifeBitTimer : TON_TIME VERSION 1.0 SETPOINT
      PT : Time
      ET : Time
      IN : Bool
      Q : Bool
    HrTotaliserTimerReset : Bool SETPOINT
    LostLifeBit : Bool
    PreStartMemory : Bool
    HandPosEdge : Bool
    HandNegEdge : Bool
  TEMP
    Time : Real
  CONSTANT

NETWORK 1 "Read In Byte 500"
  COIL ComsInByte500.Ready := Tag_1
  COIL ComsInByte500.RotorOn := Tag_2
  COIL ComsInByte500.RotorStandby := Tag_3
  COIL ComsInByte500.ReleaseFeeding := Tag_4
  COIL ComsInByte500.ProgramP1 := Tag_5
  COIL ComsInByte500.ProgramP2 := Tag_6

NETWORK 2 "Read In Byte 501"
  COIL ComsInByte501.ProgramP3 := Tag_7
  COIL ComsInByte501.ProgramP4 := Tag_8
  COIL ComsInByte501.ProgramP5 := Tag_9
  COIL ComsInByte501.ProgramP6 := Tag_10
  COIL ComsInByte501.FlashBit := Tag_11
  COIL ComsInByte501.LifeBitMirror := Tag_12
  COIL ComsInByte501.LocalMode := Tag_13
  COIL ComsInByte501.MaintenanceOn := Tag_14

NETWORK 3 "Read In Byte 502"
  COIL ComsInByte502.BypassActive := Tag_15
  COIL ComsInByte502.CuttingUnitRemote := Tag_16
  COIL ComsInByte502.TouchPanelShredder := Tag_17
  COIL ComsInByte502.TouchPanelMainCabnet := Tag_18
  COIL ComsInByte502.RadioModeOn := Tag_19
  COIL ComsInByte502.Drive1Ready := Tag_20
  COIL ComsInByte502.Drive2Ready := Tag_21

NETWORK 4 "Read In Byte 503"
  COIL ComsInByte503.OilCoolerRunning := Tag_22
  COIL ComsInByte503.AutoModeOn := Tag_23
  COIL ComsInByte503.ServiceModeOn := Tag_24
  COIL ComsInByte503.Selector1Local := Tag_25
  COIL ComsInByte503.Selector1Remote := Tag_26

NETWORK 5 "Read Word 508 - Actual Speed"
  MOVE(EN := TRUE, IN := Tag_41) => ComsInWord508
  CONVERT(EN := TRUE, IN := ComsInWord508) => ActualSpeed

NETWORK 6 "Read Word 528 - Motor Amps 1"
  MOVE(EN := TRUE, IN := Tag_42) => ComsInWord528
  CONVERT(EN := TRUE, IN := ComsInWord528) => MotorAmps1

NETWORK 7 "Read Word 532 - Motor Amps 2"
  MOVE(EN := TRUE, IN := Tag_43) => ComsInWord532
  CONVERT(EN := TRUE, IN := ComsInWord532) => MotorAmps2

NETWORK 8 "Shredder E-Stop Feedback"
  MOVE(EN := TRUE, IN := Tag_44) => PlantControl.ShredderEStopFB

NETWORK 9 "Shredder Overload Reset"
  COIL ComsOutByte500.ResetOverload := Inputs.FaultReset

NETWORK 10 "Shredder Program Selection"
  COIL ComsOutByte501.Program1 := Inputs.ProgramSelection = 1
  COIL ComsOutByte501.Program2 := Inputs.ProgramSelection = 2
  COIL ComsOutByte501.Program3 := Inputs.ProgramSelection = 3
  COIL ComsInByte501.ProgramP4 := Inputs.ProgramSelection = 4
  COIL ComsInByte501.ProgramP5 := Inputs.ProgramSelection = 5
  COIL ComsInByte501.ProgramP6 := Inputs.ProgramSelection = 6

NETWORK 11 "Shredder Running Logic"
  COIL Outputs.ShredderRunning := ComsInByte500.Ready AND ComsInByte500.RotorOn OR ComsInByte500.ReleaseFeeding

NETWORK 12 "Life Bit Logic And Monitoring"
  TON(LifeBitTimer, IN := NOT ComsInByte501.LifeBitMirror AND NOT ComsOutByte500.LifeBit, PT := T#5S)
  COIL ComsOutByte500.LifeBit := Clock_0.5Hz
  COIL LostLifeBit := LifeBitTimer.Q OR LostLifeBit AND NOT Inputs.FaultReset

NETWORK 13 "Shredder Start / Stop"
  COIL Outputs.TryRun := ((NOT Inputs.InHand OR Inputs.InHand AND NOT Inputs.HandIntervention) AND Inputs.AutoStartSignal OR Inputs.InHand AND Inputs.HandIntervention AND Inputs.HandStartSignal) AND NOT Inputs.InhibitMotor AND NOT Outputs.FTR AND NOT Outputs.FaultActive
  COIL ComsOutByte500.StartAuto := (Outputs.TryRun{split 4} AND PreStartMemory{split 5} AND Inputs.RecentStart{split 6} OR Outputs.TryRun{recv 4} AND ComsOutByte500.StartAuto{split 7}){split 1} AND NOT Outputs.Stop{split 2} AND NOT Inputs.Shutdown{split 3}
  COIL ComsOutByte500.StopAuto := NOT ((Outputs.TryRun AND PreStartMemory AND Inputs.RecentStart{recv 6} OR Outputs.TryRun AND ComsOutByte500.StartAuto{recv 7}) AND NOT Outputs.Stop AND NOT Inputs.Shutdown{recv 3})

NETWORK 14 "Hand Intervention Logic"
  COMMENT "Must Have Set Bit (#IO.HandIntervention)On Hand Control Buttons Press/Release On HMI"
  RCOIL Inputs.HandIntervention := NOT Inputs.InHand
  RCOIL Inputs.HandStartSignal := NOT Inputs.InHand OR NOT Inputs.HandIntervention OR Outputs.FaultActive OR Inputs.InhibitMotor

NETWORK 15 "Start Signal After Inhibit/Fault"
  COMMENT "Must Have Set Bit (#IO.RecentStart)On Auto/Hand Start Buttons Press/Release On HMI"
  TON(GeneralDelayTimer, IN := ((NOT PreStartMemory OR NOT Inputs.RecentStart) AND Inputs.HandStartSignal OR Outputs.TryRun) AND Inputs.InHand AND NOT Outputs.Run, PT := T#100MS)
  COIL Inputs.RecentStart := Inputs.RecentStart AND NOT ComsOutByte500.StartAuto AND PreStartMemory AND NOT Outputs.FaultActive
  RCOIL Inputs.HandStartSignal := GeneralDelayTimer.Q

NETWORK 16 ""
  TON(InHandReqPreStart, IN := PreStartMemory AND NOT Inputs.PreStartDone AND Inputs.InHand, PT := T#30S)
  COIL HandPosEdge := Inputs.InHand{split 1} AND NOT RisingEdgeFlags[3]
  COIL RisingEdgeFlags[3] := Inputs.InHand{recv 1}
  COIL HandNegEdge := (Inputs.InHand{split 3} OR NegitiveSignalEdge[1]{split 4}){split 2} AND NOT Inputs.InHand
  COIL NegitiveSignalEdge[1] := (Inputs.InHand{recv 3} OR NegitiveSignalEdge[1]{recv 4}){recv 2} AND NOT HandNegEdge

NETWORK 17 "Prestart Hold On Until Shredder Run Signal"
  COIL PreStartMemory := Inputs.PreStartDone OR PreStartMemory AND NOT Outputs.FaultActive AND NOT ComsOutByte500.StartAuto AND NOT InHandReqPreStart.Q AND NOT HandPosEdge AND NOT HandNegEdge

NETWORK 18 "HMI Times"
  MUL(EN := TRUE, IN1 := Inputs.ShutdownTime, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := Inputs.EnableUPSTime, IN2 := 1000.0) => Time
  MUL(EN := TRUE, IN1 := Inputs.FTTime, IN2 := 1000.0) => Time
  CONVERT(EN := ENO, IN := Time) => ShutdownTimeMS
  CONVERT(EN := ENO, IN := Time) => EnableUPSTimeMS
  CONVERT(EN := ENO, IN := Time) => FTTimeMS

NETWORK 19 "DOL Motor Shutdown"
  TON(ShutdownTimer, IN := Outputs.Stop, PT := ShutdownTimeMS)
  SCOIL Outputs.Stop := Inputs.Shutdown{split 1} AND NOT RisingEdgeFlags[1]
  COIL RisingEdgeFlags[1] := Inputs.Shutdown{recv 1}
  COIL Outputs.ShutdownComplete := ShutdownTimer.Q AND NOT Outputs.ShredderRunning OR Outputs.ShutdownComplete AND NOT ComsOutByte500.StartAuto OR Inputs.InHand AND Inputs.HandIntervention AND NOT Inputs.HandStartSignal OR Outputs.FaultActive
  RCOIL Outputs.Stop := Outputs.ShutdownComplete AND NOT Inputs.Shutdown

NETWORK 20 "Fail To Run"
  TON(FaultTripTimer, IN := ComsOutByte500.StartAuto AND NOT Outputs.ShredderRunning, PT := FTTimeMS)
  COIL Outputs.FTR := FaultTripTimer.Q OR Outputs.FTR AND NOT Inputs.FaultReset

NETWORK 21 "Fail To Stop"
  TON(FTSTimer, IN := NOT ComsOutByte500.StartAuto AND Outputs.ShredderRunning, PT := FTTimeMS)
  COIL Outputs.FTS := FTSTimer.Q OR Outputs.FTS AND NOT Inputs.FaultReset

NETWORK 22 "Faults"
  COIL Outputs.FaultActive := Outputs.FTR OR Outputs.FTS OR LostLifeBit OR Outputs.FaultActive AND NOT Inputs.FaultReset OR PlantControl.Test[7]

NETWORK 23 "Motor Running, Enable Upstream Component"
  TON(EnableUpstreamTimer, IN := (NOT Inputs.InHand OR NOT Inputs.HandIntervention) AND ComsOutByte500.StartAuto AND ComsInByte500.ReleaseFeeding AND Outputs.ShredderRunning, PT := EnableUPSTimeMS)
  COIL Outputs.UPSEnable := EnableUpstreamTimer.Q AND Outputs.ShredderRunning

NETWORK 24 "Hours Run Counter"
  TONR(HrTotaliserTimer, IN := ComsOutByte500.StartAuto AND Outputs.ShredderRunning, PT := T#1H, R := HrTotaliserTimerReset)
  COIL RisingEdgeFlags[2] := HrTotaliserTimer.Q{split 1}
  COIL HrTotaliserTimerReset := HrTotaliserTimer.Q{recv 1}
  MOVE(EN := HrTotaliserTimer.Q{recv 1} AND NOT RisingEdgeFlags[2]{split 2} AND Outputs.HrsRun = 4294967295, IN := 0) => Outputs.HrsRun
  ADD(EN := HrTotaliserTimer.Q AND NOT RisingEdgeFlags[2]{recv 2} AND Outputs.HrsRun < 4294967295, IN1 := 1, IN2 := Outputs.HrsRun) => Outputs.HrsRun

NETWORK 25 "HMI Motor Status Telemetry"
  MOVE(EN := NOT Outputs.FaultActive{split 1}, IN := 0) => Outputs.Telemetry
  MOVE(EN := NOT Outputs.FaultActive{recv 1} AND ComsOutByte500.StartAuto{split 2}, IN := 1) => Outputs.Telemetry
  MOVE(EN := NOT Outputs.FaultActive AND ComsOutByte500.StartAuto{recv 2} AND Outputs.ShredderRunning{split 3}, IN := 2) => Outputs.Telemetry
  MOVE(EN := NOT Outputs.FaultActive AND ComsOutByte500.StartAuto AND Outputs.ShredderRunning{recv 3} AND Outputs.UPSEnable OR NOT Outputs.FaultActive AND ComsOutByte500.StartAuto AND Outputs.ShredderRunning{recv 3} AND Inputs.InHand, IN := 3) => Outputs.Telemetry
  MOVE(EN := Outputs.FaultActive, IN := -1) => Outputs.Telemetry

NETWORK 26 "Alarms"
  COIL Outputs.Alarm.%X0 := Outputs.FTR
  COIL Outputs.Alarm.%X1 := Outputs.FTS
  COIL Outputs.Alarm.%X2 := NOT ComsInByte500.Ready
  COIL Outputs.Alarm.%X3 := ComsInByte501.LocalMode
  COIL Outputs.Alarm.%X4 := ComsInByte501.MaintenanceOn
  COIL Outputs.Alarm.%X5 := ComsInByte502.BypassActive
  COIL Outputs.Alarm.%X6 := ComsInByte502.RadioModeOn
  COIL Outputs.Alarm.%X7 := NOT ComsInByte503.AutoModeOn
  COIL Outputs.Alarm.%X8 := ComsInByte503.ServiceModeOn
  COIL Outputs.Alarm.%X9 := ComsInByte503.Selector1Local
  COIL Outputs.Alarm.%X10 := NOT ComsInByte503.Selector1Remote
  COIL Outputs.Alarm.%X11 := ComsOutByte500.StartAuto AND NOT ComsInByte500.ReleaseFeeding
  COIL Outputs.Alarm.%X12 := LostLifeBit

NETWORK 27 "Write Coms Out Byte 500"
  COIL Tag_27 := ComsOutByte500.LifeBit
  COIL Tag_28 := ComsOutByte500.ResetOverload
  COIL Tag_29 := ComsOutByte500.StopAuto
  COIL Tag_30 := ComsOutByte500.HoldAuto
  COIL Tag_31 := ComsOutByte500.StartAuto{split 1}
  COIL Outputs.Run := ComsOutByte500.StartAuto{recv 1}

NETWORK 28 "Write Coms Out Byte 501"
  COIL Tag_32 := ComsOutByte501.Program1
  COIL Tag_33 := ComsOutByte501.Program2
  COIL Tag_34 := ComsOutByte501.Program3
  COIL Tag_35 := ComsOutByte501.Program4
  COIL Tag_36 := ComsOutByte501.Program5
  COIL Tag_37 := ComsOutByte501.Program6

NETWORK 29 "Write Coms Out Byte 502"
  COIL Tag_38 := ComsOutByte502.Release4Op
  COIL Tag_39 := ComsOutByte502.StartHorn
  COIL Tag_40 := ComsOutByte502.RadioControlPermit

SIDECAR
