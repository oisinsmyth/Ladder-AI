  compileunit = 3
  access Tag_1 = 21 GlobalVariable
  access ComsInByte500.Ready = 22 LocalVariable
  access Tag_2 = 23 GlobalVariable
  access ComsInByte500.RotorOn = 24 LocalVariable
  access Tag_3 = 25 GlobalVariable
  access ComsInByte500.RotorStandby = 26 LocalVariable
  access Tag_4 = 27 GlobalVariable
  access ComsInByte500.ReleaseFeeding = 28 LocalVariable
  access Tag_5 = 29 GlobalVariable
  access ComsInByte500.ProgramP1 = 30 LocalVariable
  access Tag_6 = 31 GlobalVariable
  access ComsInByte500.ProgramP2 = 32 LocalVariable
