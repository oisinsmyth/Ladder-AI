BLOCK FC PlantAutoControl
ROOTID 0
NUMBER 2
LANGUAGE LAD
TITLE "Automatic Equipment Control"
COMMENT "Automatic equipment control."

INTERFACE
  INPUT
  OUTPUT
  CONSTANT

NETWORK 1 "Incline Feed Conveyor Automatic Control"
  COMMENT "Automatic control logic."
  COIL MotorVSDInst2.IO.SystemHealthy := TRUE
  COIL MotorVSDInst2.IO.InhibitMotor := DiscreteInputs.IFCIsoFB
  COIL MotorVSDInst2.IO.PreStartDone := PlantControl.PreStartComplete
  COIL MotorVSDInst2.IO.AutoStartSignal := ((PlantControl.Status >= 1){split 2} OR (PlantControl.Status = -1){split 3} AND InterlockData.JOB9001Interlock{split 4} AND NOT MotorStarterInst4.IO.ShutdownComplete{split 5}){split 1} AND AirStarInst1.Outputs.EnableUPS
  COIL MotorVSDInst2.IO.Shutdown := NOT (((PlantControl.Status >= 1){recv 2} OR PlantControl.Status = -1 AND InterlockData.JOB9001Interlock AND NOT MotorStarterInst4.IO.ShutdownComplete{recv 5}){recv 1}) AND NOT MotorVSDInst2.IO.HandIntervention AND PlantControl.Status = -1
  COIL MotorVSDInst2.IO.FaultReset := HMIControlSignals.SystemReset
  CALL MotorVSDSystem(MotorVSDInst2, EN := TRUE)

NETWORK 2 "Link Conveyor Automatic Control"
  COMMENT "Automatic control logic."
  COIL MotorStarterInst4.IO.RunningFB := DiscreteInputs.HFLCRunning{split 1} AND DiscreteInputs.HFLCRotSen OR DiscreteInputs.HFLCRunning{recv 1} AND HMIControlSignals.BypassHFLCRotSen
  COIL MotorStarterInst4.IO.SystemHealthy := TRUE
  COIL MotorStarterInst4.IO.InhibitMotor := DiscreteInputs.HFLCIsoFB
  COIL MotorStarterInst4.IO.PreStartDone := PlantControl.PreStartComplete
  COIL MotorStarterInst4.IO.AutoStartSignal := (InterlockData.JOB9001Interlock{split 3} AND (PlantControl.Status >= 1){split 4} OR InterlockData.JOB9001Interlock{recv 3} AND (PlantControl.Status = -1){split 5} AND NOT InterlockData.JOB9001ShutdownComplete{split 6}){split 2} AND MotorVSDInst2.IO.UPSEnable
  COIL MotorStarterInst4.IO.Shutdown := NOT ((InterlockData.JOB9001Interlock AND (PlantControl.Status >= 1){recv 4} OR InterlockData.JOB9001Interlock AND PlantControl.Status = -1 AND NOT InterlockData.JOB9001ShutdownComplete{recv 6}){recv 2}) AND NOT MotorStarterInst4.IO.HandIntervention AND PlantControl.Status = -1
  SCOIL PlantControl.AutoPreStart := InterlockData.JOB9001Interlock{split 7} AND (PlantControl.Status >= 1){split 8} AND MotorStarterInst4.IO.AutoStartSignal{split 9} AND NOT PlantControl.PositiveEdgeArray[4]
  COIL PlantControl.PositiveEdgeArray[4] := InterlockData.JOB9001Interlock AND PlantControl.Status >= 1 AND MotorStarterInst4.IO.AutoStartSignal{recv 9}
  RCOIL PlantControl.AutoPreStart := DiscreteOutputs.RunPreStart
  COIL MotorStarterInst4.IO.FaultReset := HMIControlSignals.SystemReset
  COIL DiscreteOutputs.HFLCStart := MotorStarterInst4.IO.Run
  CALL MotorStarter(MotorStarterInst4, EN := TRUE)

NETWORK 3 "Dust Filter Unit 1 Control"
  COMMENT "Automatic control logic."
  COIL FilterUnitInst2.RemoteOp := DiscreteInputs.FilterUnit1Ready
  COIL FilterUnitInst2.IO.PreStartDone := PlantControl.PreStartComplete
  COIL FilterUnitInst2.IO.SystemHealthy := TRUE
  COIL DiscreteOutputs.FilterUnit1Reset := FilterUnitInst2.IO.FaultReset
  COIL FilterUnitInst2.IO.RunningFB := DiscreteInputs.FilterUnit1Op
  COIL FilterUnitInst2.IO.FaultFB := DiscreteInputs.FilterUnit1Flt
  COIL FilterUnitInst2.IO.FaultReset := HMIControlSignals.SystemReset
  COIL FilterUnitInst2.IO.AutoStartSignal := ((PlantControl.Status >= 1){split 2} OR (PlantControl.Status = -1){split 3} AND NOT PlantControl.FansShutdownReady{split 4} OR (PlantControl.Status = -1){recv 3} AND NOT AirStarInst1.Outputs.ShutdownComplete{split 5}){split 1} AND MotorVSDInst3.IO.UPSEnable
  COIL FilterUnitInst2.IO.Shutdown := NOT (((PlantControl.Status >= 1){recv 2} OR PlantControl.Status = -1 AND NOT PlantControl.FansShutdownReady{recv 4} OR PlantControl.Status = -1 AND NOT AirStarInst1.Outputs.ShutdownComplete{recv 5}){recv 1}) AND NOT FilterUnitInst2.IO.HandIntervention AND PlantControl.Status = -1
  COIL DiscreteOutputs.FilterUnit1Start := FilterUnitInst2.IO.Run
  MOVE(EN := TRUE, IN := ProcessTimings.NormalFanStartTime) => FilterUnitInst2.IO.EnableUPSTime
  CALL FilterUnitSystem(FilterUnitInst2, EN := TRUE)

NETWORK 4 "Dust Filter Unit 2 Control"
  COMMENT "Automatic control logic."
  COIL FilterUnitInst3.RemoteOp := DiscreteInputs.FilterUnit2Ready
  COIL FilterUnitInst3.IO.PreStartDone := PlantControl.PreStartComplete
  COIL FilterUnitInst3.IO.SystemHealthy := TRUE
  COIL DiscreteOutputs.FilterUnit2Reset := FilterUnitInst3.IO.FaultReset
  COIL FilterUnitInst3.IO.RunningFB := DiscreteInputs.FilterUnit2Op
  COIL FilterUnitInst3.IO.FaultFB := DiscreteInputs.FilterUnit2Flt
  COIL FilterUnitInst3.IO.FaultReset := HMIControlSignals.SystemReset
  COIL FilterUnitInst3.IO.AutoStartSignal := ((PlantControl.Status >= 1){split 2} OR (PlantControl.Status = -1){split 3} AND NOT PlantControl.FansShutdownReady{split 4} OR (PlantControl.Status = -1){recv 3} AND NOT AirStarInst1.Outputs.ShutdownComplete{split 5}){split 1} AND MotorVSDInst3.IO.UPSEnable
  COIL FilterUnitInst3.IO.Shutdown := NOT (((PlantControl.Status >= 1){recv 2} OR PlantControl.Status = -1 AND NOT PlantControl.FansShutdownReady{recv 4} OR PlantControl.Status = -1 AND NOT AirStarInst1.Outputs.ShutdownComplete{recv 5}){recv 1}) AND NOT FilterUnitInst3.IO.HandIntervention AND PlantControl.Status = -1
  COIL DiscreteOutputs.FilterUnit2Start := FilterUnitInst3.IO.Run
  MOVE(EN := TRUE, IN := ProcessTimings.NormalFanStartTime) => FilterUnitInst3.IO.EnableUPSTime
  CALL FilterUnitSystem(FilterUnitInst3, EN := TRUE)

NETWORK 5 "VSD Motor Automatic Control"
  COMMENT "Automatic control logic."
  COIL AirStarInst1.Inputs.PreStartDone := PlantControl.PreStartComplete
  COIL AirStarInst1.Inputs.SystemHealthy := TRUE
  COIL AirStarInst1.Inputs.AutoStartSignal := ((PlantControl.Status >= 1){split 3} OR (PlantControl.Status = -1){split 4} AND NOT MotorVSDInst2.IO.ShutdownComplete{split 5}){split 1} AND MotorVSDInst1.IO.UPSEnable{split 2} AND FilterUnitInst2.IO.UPSEnable AND FilterUnitInst3.IO.UPSEnable OR ((PlantControl.Status >= 1){recv 3} OR PlantControl.Status = -1 AND NOT MotorVSDInst2.IO.ShutdownComplete{recv 5}) AND MotorVSDInst1.IO.UPSEnable{recv 2} AND InterlockData.LinkOut3rdParty
  COIL AirStarInst1.Inputs.Shutdown := NOT (((PlantControl.Status >= 1){recv 3} OR PlantControl.Status = -1 AND NOT MotorVSDInst2.IO.ShutdownComplete{recv 5}){recv 1}) AND NOT AirStarInst1.Inputs.HandIntervention AND PlantControl.Status = -1
  COIL AirStarInst1.Inputs.FaultReset := HMIControlSignals.SystemReset
  CALL AirStarSystem(AirStarInst1, EN := TRUE)

NETWORK 6 "Discharge Conveyor VSD Automatic Control"
  COMMENT "Automatic control logic."
  COIL MotorVSDInst1.IO.RotationSensor := NOT HMIControlSignals.BypassAirStarDCRotSen
  COIL MotorVSDInst1.IO.SystemHealthy := TRUE
  SCOIL MotorVSDInst1.IO.RunningFwdFB := NOT HMIControlSignals.BypassAirStarDCRotSen AND DiscreteInputs.AirStarDCRotSen
  RCOIL MotorVSDInst1.IO.RunningFwdFB := NOT HMIControlSignals.BypassAirStarDCRotSen AND NOT DiscreteInputs.AirStarDCRotSen
  COIL MotorVSDInst1.IO.InhibitMotor := DiscreteInputs.AirStarDCIsoFB
  COIL MotorVSDInst1.IO.PreStartDone := PlantControl.PreStartComplete
  COIL MotorVSDInst1.IO.AutoStartSignal := ((PlantControl.Status >= 1){split 2} OR (PlantControl.Status = -1){split 3} AND NOT AirStarInst1.Outputs.ShutdownComplete{split 4}){split 1} AND MotorStarterInst8.IO.UPSEnable AND ECSControlInst1.Outputs.UPSEnable
  COIL MotorVSDInst1.IO.Shutdown := NOT (((PlantControl.Status >= 1){recv 2} OR PlantControl.Status = -1 AND NOT AirStarInst1.Outputs.ShutdownComplete{recv 4}){recv 1}) AND NOT MotorVSDInst1.IO.HandIntervention AND PlantControl.Status = -1
  COIL MotorVSDInst1.IO.FaultReset := HMIControlSignals.SystemReset
  CALL MotorVSDSystem(MotorVSDInst1, EN := TRUE)

NETWORK 7 "Metal Collection Conveyor Automatic Control"
  COMMENT "Automatic control logic."
  COIL MotorStarterInst3.IO.RunningFB := DiscreteInputs.FMCCRunning{split 1} AND DiscreteInputs.FMCCRotSen OR DiscreteInputs.FMCCRunning{recv 1} AND HMIControlSignals.BypassFMCCRotSen
  COIL MotorStarterInst3.IO.SystemHealthy := TRUE
  COIL MotorStarterInst3.IO.InhibitMotor := DiscreteInputs.FMCCIsoFB
  COIL MotorStarterInst3.IO.PreStartDone := PlantControl.PreStartComplete
  COIL MotorStarterInst3.IO.AutoStartSignal := ((PlantControl.Status >= 1){split 3} OR (PlantControl.Status = -1){split 4} AND NOT MotorStarterInst8.IO.ShutdownComplete{split 5}){split 2} AND PlantControl.MagEnable
  COIL MotorStarterInst3.IO.Shutdown := NOT (((PlantControl.Status >= 1){recv 3} OR PlantControl.Status = -1 AND NOT MotorStarterInst8.IO.ShutdownComplete{recv 5}){recv 2}) AND NOT MotorStarterInst3.IO.HandIntervention AND PlantControl.Status = -1
  COIL MotorStarterInst3.IO.FaultReset := HMIControlSignals.SystemReset
  COIL DiscreteOutputs.FMCCStart := MotorStarterInst3.IO.Run
  CALL MotorStarter(MotorStarterInst3, EN := TRUE)

NETWORK 8 "Overband Magnet Automatic Control"
  COMMENT "Automatic control logic."
  COIL MotorStarterInst8.IO.RunningFB := DiscreteInputs.OverbandMagRunning
  COIL MotorStarterInst8.IO.SystemHealthy := TRUE
  COIL MotorStarterInst8.IO.InhibitMotor := DiscreteInputs.OverbandMagIsoFB
  COIL MotorStarterInst8.IO.PreStartDone := PlantControl.PreStartComplete
  COIL MotorStarterInst8.IO.AutoStartSignal := ((PlantControl.Status >= 1){split 2} OR (PlantControl.Status = -1){split 3} AND NOT MotorVSDInst1.IO.ShutdownComplete{split 4}){split 1} AND MotorStarterInst3.IO.UPSEnable
  COIL MotorStarterInst8.IO.Shutdown := NOT (((PlantControl.Status >= 1){recv 2} OR PlantControl.Status = -1 AND NOT MotorVSDInst1.IO.ShutdownComplete{recv 4}){recv 1}) AND NOT MotorStarterInst8.IO.HandIntervention AND PlantControl.Status = -1
  COIL MotorStarterInst8.IO.FaultReset := HMIControlSignals.SystemReset
  COIL DiscreteOutputs.OverbandMagStart := MotorStarterInst8.IO.Run
  CALL MotorStarter(MotorStarterInst8, EN := TRUE)

NETWORK 9 "Equipment Control System Automatic Control"
  COMMENT "Automatic control logic."
  COIL ECSControlInst1.Inputs.FCConveyorBeltFlt := DiscreteInputs.ECSFCConveyorFlt
  COIL ECSControlInst1.Inputs.FCRotorFault := DiscreteInputs.ECSFCRotorFlt
  COIL ECSControlInst1.Inputs.FltRotorRevs := DiscreteInputs.ECSFltRotorRevs
  COIL ECSControlInst1.Inputs.InterlockingFeeder := DiscreteInputs.ECSInterlockingFeeder
  COIL ECSControlInst1.Inputs.MaterialChargeEnabled := DiscreteInputs.ECSMatChargeEnabled
  COIL ECSControlInst1.Inputs.MSAutoMode := DiscreteInputs.ECSAutoMode
  COIL ECSControlInst1.Inputs.MSHandMode := DiscreteInputs.ECSHandMode
  COIL ECSControlInst1.Inputs.MSSettingMode := DiscreteInputs.ECSSettingMode
  COIL ECSControlInst1.Inputs.ReadyFB := DiscreteInputs.ECSReady
  COIL ECSControlInst1.Inputs.RunningFB := DiscreteInputs.ECSRunning
  COIL ECSControlInst1.Inputs.SumFlt := DiscreteInputs.ECSSumFlt
  COIL ECSControlInst1.Inputs.FaultReset := HMIControlSignals.SystemReset
  COIL ECSControlInst1.Inputs.PreStartDone := PlantControl.PreStartComplete
  COIL ECSControlInst1.Inputs.AutoStartSignal := ((PlantControl.Status >= 1){split 2} OR (PlantControl.Status = -1){split 3} AND NOT MotorVSDInst1.IO.ShutdownComplete{split 4}){split 1} AND MotorVSDInst3.IO.UPSEnable
  COIL ECSControlInst1.Inputs.Shutdown := NOT (((PlantControl.Status >= 1){recv 2} OR PlantControl.Status = -1 AND NOT MotorVSDInst1.IO.ShutdownComplete{recv 4}){recv 1}) AND NOT ECSControlInst1.Inputs.HandIntervention AND PlantControl.Status = -1
  COIL DiscreteOutputs.ECSAutoStart := ECSControlInst1.Outputs.ECSRun
  COIL DiscreteOutputs.ECSReset := ECSControlInst1.Outputs.ECSReset
  CALL EquipmentControlSystem(ECSControlInst1, EN := TRUE)

NETWORK 10 "Sorter Conveyor VSD Automatic Control"
  COMMENT "Automatic control logic."
  COIL MotorVSDInst3.IO.SystemHealthy := TRUE
  COIL MotorVSDInst3.IO.InhibitMotor := DiscreteInputs.OSCIsoFB
  COIL MotorVSDInst3.IO.PreStartDone := PlantControl.PreStartComplete
  COIL MotorVSDInst3.IO.AutoStartSignal := ((PlantControl.Status >= 1){split 2} OR (PlantControl.Status = -1){split 3} AND NOT ECSControlInst1.Outputs.ShutdownComplete{split 4}){split 1} AND TomraControlInst1.HardWireSignals.Ready AND NOT TomraControlInst1.Outputs.FaultActive AND MotorStarterInst6.IO.UPSEnable AND MotorStarterInst7.IO.UPSEnable
  COIL MotorVSDInst3.IO.Shutdown := NOT (((PlantControl.Status >= 1){recv 2} OR PlantControl.Status = -1 AND NOT ECSControlInst1.Outputs.ShutdownComplete{recv 4}){recv 1}) AND NOT TomraControlInst1.Inputs.HandIntervention AND PlantControl.Status = -1
  COIL MotorVSDInst3.IO.FaultReset := HMIControlSignals.SystemReset
  CALL MotorVSDSystem(MotorVSDInst3, EN := TRUE)

NETWORK 11 "Optical Sorter Automatic Control"
  COMMENT "Automatic control logic."
  COIL TomraControlInst1.Inputs.PreStartDone := PlantControl.PreStartComplete
  COIL TomraControlInst1.Inputs.FaultReset := HMIControlSignals.SystemReset
  COIL TomraControlInst1.HardWireSignals.Ready := DiscreteInputs.TomraReady
  COIL TomraControlInst1.HardWireSignals.Running := DiscreteInputs.TomraRunning
  COIL TomraControlInst1.HardWireSignals.ComError := DiscreteInputs.TomraComFlt
  COIL TomraControlInst1.Inputs.AutoStartSignal := ((PlantControl.Status >= 1){split 2} OR (PlantControl.Status = -1){split 3} AND NOT MotorVSDInst3.IO.ShutdownComplete{split 4}){split 1} AND MotorStarterInst6.IO.UPSEnable AND MotorStarterInst7.IO.UPSEnable
  COIL TomraControlInst1.Inputs.Shutdown := NOT (((PlantControl.Status >= 1){recv 2} OR PlantControl.Status = -1 AND NOT MotorVSDInst3.IO.ShutdownComplete{recv 4}){recv 1}) AND NOT MotorStarterInst6.IO.HandIntervention AND PlantControl.Status = -1
  COIL DiscreteOutputs.TomraRun := TomraControlInst1.HardWireSignals.Run
  CALL TomraControlSystem(TomraControlInst1, EN := TRUE, inputWord0 := Tag_45, inputWord1 := Tag_46, inputWord2 := Tag_47, inputWord3 := Tag_48, inputWord4 := Tag_49, inputWord5 := Tag_50, inputWord6 := Tag_51, inputWord7 := Tag_52, OutputWord0 => Tag_53, OutputWord1 => Tag_54)

NETWORK 12 "Drum Separator Automatic Control"
  COMMENT "Automatic control logic."
  COIL MotorStarterInst5.IO.RunningFB := DiscreteInputs.OSDrumSepRunning
  COIL MotorStarterInst5.IO.SystemHealthy := TRUE
  COIL MotorStarterInst5.IO.InhibitMotor := DiscreteInputs.OSDrumSepIsoFB
  COIL MotorStarterInst5.IO.PreStartDone := PlantControl.PreStartComplete
  COIL MotorStarterInst5.IO.AutoStartSignal := ((PlantControl.Status >= 1){split 2} OR (PlantControl.Status = -1){split 3} AND NOT PlantControl.DrumShutdownReady{split 4}){split 1} AND PlantControl.DrumsEnable
  COIL MotorStarterInst5.IO.Shutdown := NOT (((PlantControl.Status >= 1){recv 2} OR PlantControl.Status = -1 AND NOT PlantControl.DrumShutdownReady{recv 4}){recv 1}) AND NOT MotorStarterInst5.IO.HandIntervention AND PlantControl.Status = -1
  COIL MotorStarterInst5.IO.FaultReset := HMIControlSignals.SystemReset
  COIL DiscreteOutputs.OSDrumSepStart := MotorStarterInst5.IO.Run
  CALL MotorStarter(MotorStarterInst5, EN := TRUE)

NETWORK 13 "Ejected Material Conveyor Automatic Control"
  COMMENT "Automatic control logic."
  COIL MotorStarterInst6.IO.RunningFB := DiscreteInputs.OSECRunning{split 1} AND DiscreteInputs.OSECRotSen OR DiscreteInputs.OSECRunning{recv 1} AND HMIControlSignals.BypassOSECRotSen
  COIL MotorStarterInst6.IO.SystemHealthy := TRUE
  COIL MotorStarterInst6.IO.InhibitMotor := DiscreteInputs.OSECIsoFB
  COIL MotorStarterInst6.IO.PreStartDone := PlantControl.PreStartComplete
  COIL MotorStarterInst6.IO.AutoStartSignal := ((PlantControl.Status >= 1){split 3} OR (PlantControl.Status = -1){split 4} AND NOT TomraControlInst1.Outputs.ShutdownComplete{split 5}){split 2} AND PlantControl.GeneralEnable
  COIL MotorStarterInst6.IO.Shutdown := NOT (((PlantControl.Status >= 1){recv 3} OR PlantControl.Status = -1 AND NOT TomraControlInst1.Outputs.ShutdownComplete{recv 5}){recv 2}) AND NOT MotorStarterInst6.IO.HandIntervention AND PlantControl.Status = -1
  COIL MotorStarterInst6.IO.FaultReset := HMIControlSignals.SystemReset
  COIL DiscreteOutputs.OSECStart := MotorStarterInst6.IO.Run
  CALL MotorStarter(MotorStarterInst6, EN := TRUE)

NETWORK 14 "Residual Material Conveyor Automatic Control"
  COMMENT "Automatic control logic."
  COIL MotorStarterInst7.IO.RunningFB := DiscreteInputs.OSRCRunning{split 1} AND DiscreteInputs.OSRCRotSen OR DiscreteInputs.OSRCRunning{recv 1} AND HMIControlSignals.BypassOSRCRotSen
  COIL MotorStarterInst7.IO.SystemHealthy := TRUE
  COIL MotorStarterInst7.IO.InhibitMotor := DiscreteInputs.OSRCIsoFB
  COIL MotorStarterInst7.IO.PreStartDone := PlantControl.PreStartComplete
  COIL MotorStarterInst7.IO.AutoStartSignal := ((PlantControl.Status >= 1){split 3} OR (PlantControl.Status = -1){split 4} AND NOT TomraControlInst1.Outputs.ShutdownComplete{split 5}){split 2} AND MotorStarterInst1.IO.UPSEnable AND MotorStarterInst2.IO.UPSEnable
  COIL MotorStarterInst7.IO.Shutdown := NOT (((PlantControl.Status >= 1){recv 3} OR PlantControl.Status = -1 AND NOT TomraControlInst1.Outputs.ShutdownComplete{recv 5}){recv 2}) AND NOT MotorStarterInst7.IO.HandIntervention AND PlantControl.Status = -1
  COIL MotorStarterInst7.IO.FaultReset := HMIControlSignals.SystemReset
  COIL DiscreteOutputs.OSRCStart := MotorStarterInst7.IO.Run
  CALL MotorStarter(MotorStarterInst7, EN := TRUE)

NETWORK 15 "Disc Spreader Unit 1 Automatic Control"
  COMMENT "Automatic control logic."
  COIL MotorStarterInst1.IO.RunningFB := DiscreteInputs.DiskSpreader1Running
  COIL MotorStarterInst1.IO.SystemHealthy := TRUE
  COIL MotorStarterInst1.IO.InhibitMotor := DiscreteInputs.DiskSpreader1IsoFB
  COIL MotorStarterInst1.IO.PreStartDone := PlantControl.PreStartComplete
  COIL MotorStarterInst1.IO.AutoStartSignal := ((PlantControl.Status >= 1){split 2} OR (PlantControl.Status = -1){split 3} AND NOT MotorStarterInst7.IO.ShutdownComplete{split 4}){split 1} AND MotorFwdRevInst1.IO.UPSEnable
  COIL MotorStarterInst1.IO.Shutdown := NOT (((PlantControl.Status >= 1){recv 2} OR PlantControl.Status = -1 AND NOT MotorStarterInst7.IO.ShutdownComplete{recv 4}){recv 1}) AND NOT MotorStarterInst1.IO.HandIntervention AND PlantControl.Status = -1
  COIL MotorStarterInst1.IO.FaultReset := HMIControlSignals.SystemReset
  COIL DiscreteOutputs.DiskSpreader1Start := MotorStarterInst1.IO.Run
  CALL MotorStarter(MotorStarterInst1, EN := TRUE)

NETWORK 16 "Disc Spreader Unit 2 Automatic Control"
  COMMENT "Automatic control logic."
  COIL MotorStarterInst2.IO.RunningFB := DiscreteInputs.DiskSpreader2Running
  COIL MotorStarterInst2.IO.SystemHealthy := TRUE
  COIL MotorStarterInst2.IO.InhibitMotor := DiscreteInputs.DiskSpreader2IsoFB
  COIL MotorStarterInst2.IO.PreStartDone := PlantControl.PreStartComplete
  COIL MotorStarterInst2.IO.AutoStartSignal := ((PlantControl.Status >= 1){split 2} OR (PlantControl.Status = -1){split 3} AND NOT MotorStarterInst7.IO.ShutdownComplete{split 4}){split 1} AND MotorFwdRevInst1.IO.UPSEnable
  COIL MotorStarterInst2.IO.Shutdown := NOT (((PlantControl.Status >= 1){recv 2} OR PlantControl.Status = -1 AND NOT MotorStarterInst7.IO.ShutdownComplete{recv 4}){recv 1}) AND NOT MotorStarterInst2.IO.HandIntervention AND PlantControl.Status = -1
  COIL MotorStarterInst2.IO.FaultReset := HMIControlSignals.SystemReset
  COIL DiscreteOutputs.DiskSpreader2Start := MotorStarterInst2.IO.Run
  CALL MotorStarter(MotorStarterInst2, EN := TRUE)

NETWORK 17 "Feed Conveyor Automatic Control"
  COMMENT "Automatic control logic."
  COIL MotorFwdRevInst1.IO.RunningFBFwd := DiscreteInputs.SFCRunningFwd{split 1} AND DiscreteInputs.SFCRotSen OR DiscreteInputs.SFCRunningFwd{recv 1} AND HMIControlSignals.BypassSFCRotSen
  COIL MotorFwdRevInst1.IO.SystemHealthy := TRUE
  COIL MotorFwdRevInst1.IO.RunningFBRev := DiscreteInputs.SFCRunningRev{split 2} AND DiscreteInputs.SFCRotSen OR DiscreteInputs.SFCRunningRev{recv 2} AND HMIControlSignals.BypassSFCRotSen
  COIL MotorFwdRevInst1.IO.InhibitMotor := DiscreteInputs.SFCIsoFB
  COIL MotorFwdRevInst1.IO.PreStartDone := PlantControl.PreStartComplete
  RCOIL MotorFwdRevInst1.IO.Reverse := ((PlantControl.Status >= 1){split 4} AND NOT MotorFwdRevInst1.IO.InHand{split 5} AND MotorFwdRevInst1.IO.RunningFBFwd{split 6} OR PlantControl.Status >= 1 AND NOT MotorFwdRevInst1.IO.InHand{recv 5} AND MotorFwdRevInst1.IO.RunningFBRev{split 7}){split 3} AND ShredderControlInst1.Outputs.UPSEnable
  SCOIL MotorFwdRevInst1.IO.Reverse := (PlantControl.Status >= 1 AND NOT MotorFwdRevInst1.IO.InHand AND MotorFwdRevInst1.IO.RunningFBFwd{recv 6} OR PlantControl.Status >= 1 AND NOT MotorFwdRevInst1.IO.InHand AND MotorFwdRevInst1.IO.RunningFBRev{recv 7}){recv 3} AND NOT ShredderControlInst1.Outputs.UPSEnable
  COIL MotorFwdRevInst1.IO.AutoStartSignal := ((PlantControl.Status >= 1){split 9} OR (PlantControl.Status = -1){split 10} AND NOT MotorStarterInst1.IO.ShutdownComplete{split 11} OR (PlantControl.Status = -1){recv 10} AND NOT MotorStarterInst2.IO.ShutdownComplete{split 12}){split 8} AND NOT MotorFwdRevInst1.IO.Reverse AND ShredderControlInst1.Outputs.UPSEnable OR ((PlantControl.Status >= 1){recv 9} OR PlantControl.Status = -1 AND NOT MotorStarterInst1.IO.ShutdownComplete{recv 11} OR PlantControl.Status = -1 AND NOT MotorStarterInst2.IO.ShutdownComplete{recv 12}){recv 8} AND MotorFwdRevInst1.IO.Reverse AND PlantControl.GeneralEnable
  COIL MotorFwdRevInst1.IO.Shutdown := NOT (((PlantControl.Status >= 1){recv 9} OR PlantControl.Status = -1 AND NOT MotorStarterInst1.IO.ShutdownComplete{recv 11} OR PlantControl.Status = -1 AND NOT MotorStarterInst2.IO.ShutdownComplete{recv 12}){recv 8}) AND NOT MotorFwdRevInst1.IO.HandIntervention AND PlantControl.Status = -1
  COIL MotorFwdRevInst1.IO.FaultReset := HMIControlSignals.SystemReset
  COIL DiscreteOutputs.SFCRunFwd := MotorFwdRevInst1.IO.RunFwd
  COIL DiscreteOutputs.SFCRunRev := MotorFwdRevInst1.IO.RunRev
  CALL MotorFwdRevSystem(MotorFwdRevInst1, EN := TRUE)

NETWORK 18 "Shredder Automatic Control"
  COMMENT "Automatic control logic."
  COIL ShredderControlInst1.Inputs.PreStartDone := PlantControl.PreStartComplete
  COIL ShredderControlInst1.Inputs.FaultReset := HMIControlSignals.SystemReset
  COIL ShredderControlInst1.Inputs.AutoStartSignal := ((PlantControl.Status >= 1){split 2} OR (PlantControl.Status = -1){split 3} AND NOT MotorFwdRevInst1.IO.ShutdownComplete{split 4}){split 1} AND MotorStarterInst9.IO.UPSEnable
  COIL ShredderControlInst1.Inputs.Shutdown := NOT (((PlantControl.Status >= 1){recv 2} OR PlantControl.Status = -1 AND NOT MotorFwdRevInst1.IO.ShutdownComplete{recv 4}){recv 1}) AND NOT ShredderControlInst1.Inputs.HandIntervention AND PlantControl.Status = -1
  CALL ShredderControlSystem(ShredderControlInst1, EN := TRUE)

NETWORK 19 "Cyclone Filter Unit Control"
  COMMENT "Automatic control logic."
  COIL FilterUnitInst1.IO.FaultReset := HMIControlSignals.SystemReset
  COIL FilterUnitInst1.RemoteOp := DiscreteInputs.CycloneDustRemOp
  COIL DiscreteOutputs.CycloneDustFilterReset := FilterUnitInst1.IO.FaultReset
  COIL FilterUnitInst1.IO.RunningFB := DiscreteInputs.CycloneDustAutoRunning/Stop
  COIL FilterUnitInst1.IO.FaultFB := NOT DiscreteInputs.CycloneDustSysOk
  COIL FilterUnitInst1.IO.PreStartDone := PlantControl.PreStartComplete
  COIL FilterUnitInst1.IO.SystemHealthy := TRUE
  COIL FilterUnitInst1.IO.AutoStartSignal := ((PlantControl.Status >= 1){split 2} OR (PlantControl.Status = -1){split 3} AND NOT PlantControl.FansShutdownReady{split 4} OR (PlantControl.Status = -1){recv 3} AND NOT ShredderControlInst1.Outputs.ShutdownComplete{split 5}){split 1}
  COIL FilterUnitInst1.IO.Shutdown := NOT (((PlantControl.Status >= 1){recv 2} OR PlantControl.Status = -1 AND NOT PlantControl.FansShutdownReady{recv 4} OR PlantControl.Status = -1 AND NOT ShredderControlInst1.Outputs.ShutdownComplete{recv 5}){recv 1}) AND NOT FilterUnitInst1.IO.HandIntervention AND PlantControl.Status = -1
  COIL DiscreteOutputs.CycloneDustFilterStart := FilterUnitInst1.IO.Run
  MOVE(EN := TRUE, IN := ProcessTimings.NormalFanStartTime) => FilterUnitInst1.IO.EnableUPSTime
  CALL FilterUnitSystem(FilterUnitInst1, EN := TRUE)

NETWORK 20 "Discharge Conveyor Automatic Control"
  COMMENT "Automatic control logic."
  COIL MotorStarterInst9.IO.RunningFB := DiscreteInputs.SDCRuning{split 1} AND DiscreteInputs.SDCRotSen OR DiscreteInputs.SDCRuning{recv 1} AND HMIControlSignals.BypassSDCRotSen
  COIL MotorStarterInst9.IO.SystemHealthy := TRUE
  COIL MotorStarterInst9.IO.InhibitMotor := DiscreteInputs.SDCIsoFB
  COIL MotorStarterInst9.IO.PreStartDone := PlantControl.PreStartComplete
  COIL MotorStarterInst9.IO.AutoStartSignal := ((PlantControl.Status >= 1){split 3} OR (PlantControl.Status = -1){split 4} AND NOT ShredderControlInst1.Outputs.ShutdownComplete{split 5}){split 2} AND PlantControl.GeneralEnable
  COIL MotorStarterInst9.IO.Shutdown := NOT (((PlantControl.Status >= 1){recv 3} OR PlantControl.Status = -1 AND NOT ShredderControlInst1.Outputs.ShutdownComplete{recv 5}){recv 2}) AND NOT MotorStarterInst9.IO.HandIntervention AND PlantControl.Status = -1
  COIL MotorStarterInst9.IO.FaultReset := HMIControlSignals.SystemReset
  COIL DiscreteOutputs.SDCStart := MotorStarterInst9.IO.Run
  CALL MotorStarter(MotorStarterInst9, EN := TRUE)

SIDECAR
