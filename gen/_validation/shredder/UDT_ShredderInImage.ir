TYPE UDT_ShredderInImage
  ROOTID 0
  COMMENT "Decoded inbound comms status image of the shredder (bytes 500-503). Flat members preserve the register vocabulary; grouping flattened for converter DB-member inlining (see subsystem note)."
  MEMBERS
    Ready : Bool COMMENT "Byte500.0 - drive reports ready"
    RotorOn : Bool COMMENT "Byte500.1 - rotor running"
    RotorStandby : Bool COMMENT "Byte500.2 - rotor standby"
    ReleaseFeeding : Bool COMMENT "Byte500.3 - releasing feed"
    ProgramP1 : Bool COMMENT "Byte500.6 - program status bit 1"
    ProgramP2 : Bool COMMENT "Byte500.7 - program status bit 2"
    ProgramP3 : Bool COMMENT "Byte501.0 - program status bit 3"
    ProgramP4 : Bool COMMENT "Byte501.1 - program status bit 4"
    ProgramP5 : Bool COMMENT "Byte501.2 - program status bit 5"
    ProgramP6 : Bool COMMENT "Byte501.3 - program status bit 6"
    FlashBit : Bool COMMENT "Byte501.4 - HMI flash"
    LifeBitMirror : Bool COMMENT "Byte501.5 - inbound life-bit mirror (watchdog)"
    LocalMode : Bool COMMENT "Byte501.6 - shredder in local mode"
    MaintenanceOn : Bool COMMENT "Byte501.7 - maintenance mode"
    BypassActive : Bool COMMENT "Byte502.1 - bypass active"
    CuttingUnitRemote : Bool COMMENT "Byte502.2 - cutting unit remote"
    TouchPanelShredder : Bool COMMENT "Byte502.3 - shredder touch panel"
    TouchPanelMainCabnet : Bool COMMENT "Byte502.4 - main cabinet touch panel"
    RadioModeOn : Bool COMMENT "Byte502.5 - radio mode"
    Drive1Ready : Bool COMMENT "Byte502.6 - drive 1 ready"
    Drive2Ready : Bool COMMENT "Byte502.7 - drive 2 ready"
    OilCoolerRunning : Bool COMMENT "Byte503.0 - oil cooler running"
    AutoModeOn : Bool COMMENT "Byte503.1 - auto mode"
    ServiceModeOn : Bool COMMENT "Byte503.2 - service mode"
    Selector1Local : Bool COMMENT "Byte503.3 - selector local"
    Selector1Remote : Bool COMMENT "Byte503.4 - selector remote"
