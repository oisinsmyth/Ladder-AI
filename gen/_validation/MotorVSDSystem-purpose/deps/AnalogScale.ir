  access Temp3 = 39 LocalVariable
  access Temp4 = 40 LocalVariable
  access Temp5 = 41 LocalVariable
  access Temp5 = 42 LocalVariable
  access Scaled_Min = 43 LocalVariable
  access Output = 44 LocalVariable
  constant 0.0 = 45 Real
  move 0
