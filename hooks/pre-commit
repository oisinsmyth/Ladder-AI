#!/bin/sh
#
# Three refusals, all of them keyed on WHAT IS STAGED:
#   1. a context-injected file over its size budget;
#   2. a change to tools/check-agent-evidence.py whose own self-tests do not pass;
#   3. staged content carrying live-job vocabulary (M-5).
#
# This exists because CLAUDE.md grew 45,130 -> 96,245 bytes in eleven days and not one
# commit in that span reduced it. Every byte of CLAUDE.md, the agent briefs and the skills
# is loaded before an agent does any work, so they are a tax on every dispatch. Prose
# asking people to keep them small was in place for that entire span and did not hold.
#
# Install (once per clone - git will not do this for you):
#
#     git config core.hooksPath hooks
#
# Confirm it is live with:  git config core.hooksPath   ->  hooks
#
# All the logic lives in the Python, including working out which budgeted files are
# actually staged, so it is covered by tools/check-file-budgets.tests.py rather than
# living untested in shell. This hook deliberately stays a three-line invocation: a hook
# that grows a loop per budgeted path is a hook nobody tests.
#
# It does NOT check whether facts were dropped - that is tools/check-doc-migration.py,
# which you should run before any trim.
#
# Fails closed on purpose. If python is missing or the script is unreadable, the non-zero
# exit refuses the commit rather than waving it through: a gate that disappears when its
# dependencies do is not a gate.
#
# `git commit --no-verify` bypasses this. Bypassing it is the exact behaviour the gate
# exists to prevent - if a budget is genuinely wrong, raise that file's ceiling in
# tools/check-file-budgets.py in its own commit, with a reason.

if ! python tools/check-file-budgets.py --staged; then
    echo ""
    echo "COMMIT REFUSED: a context-injected file is over its size budget."
    echo "Move the content to its owning doc (README or docs/notes), or raise that"
    echo "file's ceiling deliberately in its own commit. --no-verify is not the answer."
    exit 1
fi

# THE GATE ON THE GATE. Added 2026-08-24 after an adversarial audit found five defects in
# tools/check-agent-evidence.py, every one of them shipped by a change that nothing tested.
# `--staged-only` returns immediately unless that checker or its tests are in the index, so
# this costs nothing on an ordinary commit.
#
# The EVIDENCE check itself is deliberately NOT here, and that is a decision rather than an
# omission: an evidence file's hashes legitimately drift once a later commit touches the
# same block, and its claims are legitimately released the moment the dispatcher verifies
# them, so a commit hook would refuse work that was correct at the time. See
# agent-tasks/README.md. Verification of a hand-back belongs at hand-back.
if ! python tools/check-agent-evidence.tests.py --staged-only; then
    echo ""
    echo "COMMIT REFUSED: the agent-evidence gate's own self-tests do not pass."
    echo "This commit changes the check that verifies sub-agent hand-backs, and a"
    echo "verifier nobody has watched REFUSE anything is one nobody should trust."
    echo "Fix the checker or the test. --no-verify is not the answer."
    exit 1
fi

# M-5, THE COMMITTED-CONTENT BOUNDARY CHECK. Added 2026-09-18, and it is the only gate here that is
# a governance control rather than a time saving. Live-job identifiers reached committed source in
# 13 files across several lanes on the first day of live-job work - every lane had been told nothing
# from the job folder is committed, and every lane honoured it for artifacts, then quoted job
# identifiers into code comments as evidence for a technical claim. One lane caught its own and
# correctly declined to rewrite another lane's, which is why the leak survived: a per-lane check
# catches the lane's own work, only a repo-wide sweep catches the repo.
#
# IT BELONGS AT COMMIT TIME rather than in a later audit, and that is the whole of the deferral:
# here the author still remembers whether the concrete case was load-bearing, and afterwards
# somebody has to re-derive that intent from prose.
#
# It costs nothing on a clone that has never worked a live job - no vocabulary under sanitization/
# and no live-job material on disk means it says so and exits 0. With live-job material on disk and
# no vocabulary it REFUSES, because that combination is the exact situation it exists for.
if ! python tools/check-staged-identifiers.py; then
    echo ""
    echo "COMMIT REFUSED: staged content carries live-job vocabulary, or the sweep could not run."
    echo "Triage the worklist above - a hit is a question, not a verdict, and the usual answer is"
    echo "to rewrite the sentence in invented vocabulary rather than delete the file. A 'lesson"
    echo "learned' written in the job's own words is still a leak. --no-verify is not the answer."
    exit 1
fi

exit 0
