<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Harness.Cleanup.Tests</RootNamespace>
  </PropertyGroup>

  <!-- Versions come from the repo-root Directory.Packages.props (F-38, central package management). -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    NOTE: this project deliberately CONTAINS a class that calls File.Delete and Process.Start
    (PlantedDestructiveControl). It is the live positive control for the IL walk in
    CleanupStructureTests, and it must stay here and never move into the shipped assembly.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Harness.Cleanup\Harness.Cleanup.csproj" />
  </ItemGroup>

</Project>
