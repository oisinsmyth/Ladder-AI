<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Harness.Loop.Tests</RootNamespace>
  </PropertyGroup>

  <!-- Versions come from the repo-root Directory.Packages.props (F-38, central package management). -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    DB-8's package is pure judgement over evidence, so every test here is a constructed evidence
    set. Most of them are NEGATIVE: the package's whole job is to refuse to look conclusive, and a
    suite that only fed it healthy runs would be a suite that could not fail.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Harness.Loop\Harness.Loop.csproj" />
    <ProjectReference Include="..\Harness.Run\Harness.Run.csproj" />

    <!--
      Harness.Skeleton, so the loop can be run END TO END against the LAD interpreter and the simulated
      bit memory built in phases 2 and 3. That is the strongest demonstration available without a rig:
      the map, the copy layer, the client, the wave and the package are all the real ones, and only the
      CPU is substituted - by something that EXECUTES THE GENERATED IR rather than re-implementing it.
    -->
    <ProjectReference Include="..\Harness.Skeleton\Harness.Skeleton.csproj" />
  </ItemGroup>

</Project>
