<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Harness.Results.Tests</RootNamespace>
  </PropertyGroup>

  <!-- Versions come from the repo-root Directory.Packages.props (F-38, central package management). -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    DB-8's package is pure judgement over evidence, so every test here is a constructed evidence
    set. Most of them are NEGATIVE: the package's whole job is to refuse to look conclusive, and a
    suite that only fed it healthy runs would be a suite that could not fail.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Harness.Results\Harness.Results.csproj" />

    <!--
      The CLI's decision half is tested here rather than in a suite of its own: it is a thin composition
      over the gates this project already exercises, and the one thing worth testing about it - that a
      gate nobody can run is reported as NOT CHECKED and exits non-zero - needs the gates, not a process.
    -->
    <ProjectReference Include="..\Harness.Gate\Harness.Gate.csproj" />
  </ItemGroup>

</Project>
