<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Harness.Results.Tests</RootNamespace>
  </PropertyGroup>

  <!-- Versions come from the repo-root Directory.Packages.props (F-38, central package management). -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    DB-8's package is pure judgement over evidence, so every test here is a constructed evidence
    set. Most of them are NEGATIVE: the package's whole job is to refuse to look conclusive, and a
    suite that only fed it healthy runs would be a suite that could not fail.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Harness.Results\Harness.Results.csproj" />

    <!--
      The CLI's decision half is tested here rather than in a suite of its own: it is a thin composition
      over the gates this project already exercises, and the one thing worth testing about it - that a
      gate nobody can run is reported as NOT CHECKED and exits non-zero - needs the gates, not a process.
    -->
    <ProjectReference Include="..\Harness.Gate\Harness.Gate.csproj" />
  </ItemGroup>

  <!--
    THE FOUR RECORDED PROBE LOGS, LINKED RATHER THAN COPIED. They are committed fixtures of the
    download-feedback solution and this suite reads the same files, so the two cannot drift; a copy
    here would be a second corpus that silently ages.

    *** WHAT A GREEN AGAINST THEM IS WORTH, STATED WHERE THE FILES ARE WIRED IN. *** Their own
    README says it: "Object names are invented; the message shape is verbatim." They prove the PARSE
    and the COMPARE. They are not evidence about any real deployment, and a pass here is never a
    verdict on real material - see the header of DeploymentManifestTests.cs.
  -->
  <ItemGroup>
    <!-- Named one by one, not globbed: this suite reads exactly these four and the header of
         DeploymentManifestTests.cs says what each of them proves. A glob would quietly enlarge the
         corpus and make that sentence false. -->
    <None Include="..\..\download-feedback\DownloadFeedback.Tests\Fixtures\full-ninety-nine-objects.txt"
          Link="Fixtures\full-ninety-nine-objects.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\download-feedback\DownloadFeedback.Tests\Fixtures\differential-one-object.txt"
          Link="Fixtures\differential-one-object.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\download-feedback\DownloadFeedback.Tests\Fixtures\up-to-date-nothing-transferred.txt"
          Link="Fixtures\up-to-date-nothing-transferred.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\download-feedback\DownloadFeedback.Tests\Fixtures\aborted-no-download-result.txt"
          Link="Fixtures\aborted-no-download-result.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
