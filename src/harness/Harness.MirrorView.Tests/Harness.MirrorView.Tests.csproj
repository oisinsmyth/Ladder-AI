<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Harness.MirrorView.Tests</RootNamespace>
  </PropertyGroup>

  <!-- Versions come from the repo-root Directory.Packages.props (F-38, central package management). -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NModbus" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    No device and no socket. The fence tests drive a RECORDING factory, so "the fence refused and
    nothing connected" is asserted against a counter rather than against a status string — which is the
    distinction that matters, because a disconnected fence still produces a status a reader might believe.

    NOTE: this project deliberately CONTAINS two classes the shipped assembly must never contain —
    PlantedWriteControl (calls WriteHoldingRegisters) and PlantedBindAnyControl (names IPAddress.Any).
    They are the live positive controls for the IL walk. They must stay here and never move.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Harness.MirrorView\Harness.MirrorView.csproj" />
    <ProjectReference Include="..\Harness.Map\Harness.Map.csproj" />
  </ItemGroup>

</Project>
