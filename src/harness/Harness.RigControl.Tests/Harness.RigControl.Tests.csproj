<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Harness.RigControl.Tests</RootNamespace>
  </PropertyGroup>

  <!-- Versions come from the repo-root Directory.Packages.props (F-38, central package management). -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    No reference to Sharp7, and none needed: every test drives a scripted transport. That is the return
    on IRunTransitionTransport — the fence, every gate, the confirmation gate, the identity comparison and the
    read-back verification are exercised with no PLC, no network and no rig.

    Sharp7 still ARRIVES here, in the build output, because Harness.RigControl copies it (Private=true).
    That matters for RigControlStructureTests: the IL walk resolves Sharp7 member tokens, and it cannot
    do that if the assembly is not loadable beside the one being walked.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Harness.RigControl\Harness.RigControl.csproj" />
  </ItemGroup>

</Project>
